---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Availability from '../components/Availability.astro';
import Showreel from '../components/Showreel.astro';
import IntroLine from '../components/IntroLine.astro';
import Skills from '../components/Skills.astro';
import WorkGrid from '../components/WorkGrid.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Testimonial from '../components/Testimonial.astro';
import Footer from '../components/Footer.astro';
import showreelPoster from '../assets/home/reel-poster.jpg';
import reelLoader from '../data/reel-loader.json';
import {
  availability,
  contactEmail,
  intro,
  skills,
  workIntro,
  previous,
  testimonial,
} from '../data/home';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// Skill chips point at their project: the case study if there is one,
// otherwise the project's tile further down the page.
const projectHref = (id: string) => projects.find((p) => p.id === id)?.data.link ?? `#work-${id}`;
// Chips for a project get a hover card with that project's tile artwork
const cardFor = (id?: string) => {
  const project = id && projects.find((p) => p.id === id);
  if (!project) return undefined;
  const { tile, title } = project.data;
  return {
    image: tile.image,
    logo: tile.logo,
    logoScale: tile.logoScale,
    grain: tile.grain,
    // Brand colour, not the gradient: gradient colours are inputs tuned
    // for the shader and read dull on their own
    tint: `var(--chip-${id})`,
    alt: title,
  };
};
const skillsWithLinks = skills.map((skill) => ({
  ...skill,
  logos: skill.logos.map((logo) => ({
    ...logo,
    href: logo.href ?? (logo.project ? projectHref(logo.project) : undefined),
    card: logo.card ?? cardFor(logo.project),
  })),
}));
---

<Base
  title="Sean Geraghty, product designer"
  description="Sean Geraghty leads design at startups where product is built, not briefed. Product design, brand and code."
>
  <script is:inline slot="head">
    // The showreel's loader (Showreel.astro), decided before the first paint
    // so the page never shows and then hides. Plays whenever the homepage is
    // loaded or reloaded; not coming back to it from a case study (Close goes
    // back in history, or to the project's #tile), not from a link within
    // the site, not with reduced motion or Save-Data.
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      const fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
      const arriving = !location.hash && (!nav || nav.type === 'reload' || (nav.type === 'navigate' && !fromSite));
      if (arriving && !matchMedia('(prefers-reduced-motion: reduce)').matches && !navigator.connection?.saveData) {
        const root = document.documentElement;
        root.dataset.intro = '';
        // Never leave the page covered: not if the page's script never starts
        // the loader, nor if it fails part-way (it ends within ~6s itself)
        setTimeout(() => root.dataset.intro === '' && root.removeAttribute('data-intro'), 3000);
        setTimeout(() => root.removeAttribute('data-intro'), 8000);
      }
    } catch {}
  </script>
  <main>
    <!-- Everything before the footer. The availability pill parks at its end. -->
    <div class="home-body" data-intro-page>
      <section class="home-intro container">
        <Hero />
      </section>

      <section class="home-about container">
        <Showreel poster={showreelPoster} alt="Showreel of recent work" video="/img/reel/reel" loader={reelLoader} />
        <IntroLine lead={intro.lead} links={intro.links} />
        <Skills items={skillsWithLinks} />
      </section>

      <section class="home-work" id="work" aria-labelledby="work-heading">
        <div class="container home-work__inner">
          <h2 id="work-heading" class="visually-hidden">Work</h2>
          <p class="home-work__intro t-h3">
            {workIntro.text}{' '}<br class="home-work__break" />
            {workIntro.text2} <strong class="t-h3-bold">{workIntro.emphasis}</strong>.
          </p>
          <WorkGrid projects={projects.filter((p) => p.data.inGrid)} />
          <LogoStrip heading={previous.heading} logos={previous.logos} />
        </div>
      </section>

      <Availability label={availability} email={contactEmail} />
    </div>

    <Footer email={contactEmail} label="Testimonial and contact">
      <Testimonial {...testimonial} />
    </Footer>
  </main>
</Base>

<style>
  .home-intro {
    padding-top: var(--space-3xl);
  }

  .home-about {
    /* Skill chip hover cards can reach past the sides on narrow windows;
       clip them sideways (they still rise above the row) so the page
       never scrolls horizontally */
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .home-work {
    background-color: var(--bg-work);
  }

  .home-work__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    padding-block: var(--space-3xl);
  }

  .home-work__intro {
    max-width: 25em;
    margin-inline: auto;
    text-align: center;
    color: var(--text-muted);
    text-wrap: balance;
  }

  /* The break between the two sentences is for desktop; phones let them run on */
  @media (max-width: 700px) {
    .home-work__break {
      display: none;
    }
  }

  .home-work__intro strong {
    color: var(--text-strong);
  }
</style>
