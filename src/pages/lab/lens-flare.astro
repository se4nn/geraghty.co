---
// Lens flare lab. Each project's live gradient, with grain and with the CRT
// texture, next to the still it replaces, plus a scratch tile for trying
// colours. Not linked from the site.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LensFlare from '../../components/LensFlare.astro';

const projects = (await getCollection('work'))
  .filter((p) => p.data.tile.gradient)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Lens flare lab" description="Live project gradients next to the stills they replace.">
  <meta name="robots" content="noindex" slot="head" />
  <main class="lab">
    <h1 class="t-h1">Lens flare</h1>
    <p class="t-body lab__note">Grain, CRT, then the current still.</p>

    <section class="lab__try">
      <LensFlare id="try" class="lab__art" from="var(--gradient-format-from)" to="var(--gradient-format-to)" />
      <form class="lab__controls t-body" id="try-form">
        <label>Opening <input type="color" name="from" value="#802a71" /></label>
        <label>Closing <input type="color" name="to" value="#ef653e" /></label>
        <label>Seed <input type="number" name="seed" value="0" step="1" /></label>
        <label>
          Texture
          <select name="dither">
            <option value="grain">Grain</option>
            <option value="crt">CRT</option>
          </select>
        </label>
        <output name="snippet" class="lab__snippet"></output>
      </form>
    </section>

    {
      projects.map((p) => (
        <section class="lab__row">
          <h2 class="t-h3-bold">{p.data.title}</h2>
          <div class="lab__pair">
            <LensFlare
              class="lab__art"
              from={p.data.tile.gradient!.from}
              to={p.data.tile.gradient!.to}
              seed={p.data.tile.gradient!.seed}
              darkness={p.data.tile.gradient!.darkness}
              fringe={p.data.tile.gradient!.fringe}
            />
            <LensFlare
              class="lab__art"
              from={p.data.tile.gradient!.from}
              to={p.data.tile.gradient!.to}
              seed={p.data.tile.gradient!.seed}
              darkness={p.data.tile.gradient!.darkness}
              fringe={p.data.tile.gradient!.fringe}
              dither="crt"
            />
            <Image class="lab__art lab__still" src={p.data.tile.image} alt="" width={820} />
          </div>
        </section>
      ))
    }
  </main>
</Base>

<style>
  .lab {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--page-gutter);
    display: grid;
    gap: var(--space-xl);
  }

  .lab__note {
    color: var(--text-muted);
  }

  .lab__try,
  .lab__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--space-l);
  }

  .lab__row {
    display: grid;
    gap: var(--space-s);
  }

  .lab__art {
    aspect-ratio: 1;
    width: 100%;
    border-radius: var(--radius-s);
  }

  .lab__still {
    height: auto;
    object-fit: cover;
  }

  .lab__controls {
    display: grid;
    align-content: start;
    gap: var(--space-s);
  }

  .lab__controls label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    max-width: 280px;
  }

  .lab__snippet {
    font-family: ui-monospace, monospace;
    font-size: 13px;
    white-space: pre;
    color: var(--text-muted);
  }
</style>

<script>
  const form = document.getElementById('try-form') as HTMLFormElement;
  const flare = document.getElementById('try') as HTMLElement & { readColours(): void; redraw(): void; opts: { seed: number } };

  function update() {
    const from = (form.elements.namedItem('from') as HTMLInputElement).value;
    const to = (form.elements.namedItem('to') as HTMLInputElement).value;
    const seed = parseFloat((form.elements.namedItem('seed') as HTMLInputElement).value) || 0;
    const dither = (form.elements.namedItem('dither') as HTMLSelectElement).value;
    flare.style.setProperty('--lf-from', from);
    flare.style.setProperty('--lf-to', to);
    flare.opts.seed = seed;
    flare.dataset.dither = dither;
    flare.readColours();
    flare.redraw();
    (form.elements.namedItem('snippet') as HTMLOutputElement).value =
      `<LensFlare from="${from}" to="${to}" seed={${seed}}${dither === 'crt' ? ' dither="crt"' : ''} />`;
  }

  form.addEventListener('input', update);
  customElements.whenDefined('lens-flare').then(update);
</script>
