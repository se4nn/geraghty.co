---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TileArt from '../../../components/TileArt.astro';
import StudiaOpener from '../../../components/StudiaOpener.astro';
import FormatOpener from '../../../components/FormatOpener.astro';
import ReportZoom from '../../../components/ReportZoom.astro';
import FormatVariables from '../../../components/FormatVariables.astro';
import BuildLoop from '../../../components/BuildLoop.astro';
import MarkBuild from '../../../components/MarkBuild.astro';

export async function getStaticPaths() {
  if (!import.meta.env.DEV && process.env.REEL_STAGE !== '1') return [];
  const projects = await getCollection('work');
  return [
    ...['studia-opener', 'format-opener', 'report-zoom', 'format-variables', 'build-loop', 'mark-build', 'ending'],
    ...['tile', 'on', 'flare', 'burn'].flatMap((mode) => projects.map((p) => `${mode}-${p.id}`)),
  ].map((shot) => ({ params: { shot } }));
}

const { shot } = Astro.params;
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [, mode, id] = shot.match(/^(tile|on|flare|burn)-(.+)$/) ?? [];
const project = projects.find((p) => p.id === id);
---

<Base title={`Reel · ${shot}`} description="Showreel stage.">
  <meta name="robots" content="noindex" slot="head" />
  <div class="reel-stage" data-mode={mode}>
    {
      project && (
        <TileArt
          class="reel-tile"
          image={project.data.tile.image}
          logo={project.data.tile.logo}
          logoScale={project.data.tile.logoScale}
          grain={project.data.tile.grain}
          gradient={project.data.tile.gradient}
          showLogo={mode !== 'on' && mode !== 'flare'}
          alt=""
          sizes="1416px"
          widths={[2832]}
          eager
        />
      )
    }
    {
      shot === 'ending' && (
        <div class="reel-grid">
          {projects.map((p) => (
            <TileArt
              class="item"
              image={p.data.tile.image}
              logo={p.data.tile.logo}
              logoScale={p.data.tile.logoScale}
              grain={p.data.tile.grain}
              gradient={p.data.tile.gradient}
              alt=""
              sizes="680px"
              widths={[680]}
              eager
            />
          ))}
        </div>
      )
    }
    {
      !project && shot !== 'ending' && (
        <div class="reel-shot">
          {shot === 'studia-opener' && <StudiaOpener alt="" />}
          {shot === 'format-opener' && <FormatOpener alt="" />}
          {shot === 'report-zoom' && <ReportZoom alt="" />}
          {shot === 'format-variables' && <FormatVariables />}
          {shot === 'build-loop' && <BuildLoop />}
          {shot === 'mark-build' && <MarkBuild />}
        </div>
      )
    }
  </div>
</Base>

<style is:global>
  /* Stage */

  html,
  body {
    margin: 0;
    overflow: hidden;
    background: var(--neutral-1000);
  }

  .reel-stage {
    position: fixed;
    inset: 0;
    width: 1416px;
    height: 800px;
    overflow: hidden;
    --radius-s: 0px;
  }

  .reel-shot {
    position: absolute;
    left: 0;
    top: -6px;
    width: 1416px;
    translate: 0 2000px;
  }

  [data-reel='on'] .reel-shot {
    translate: none;
  }

  /* Tile */

  .reel-stage .reel-tile.tile-art {
    position: absolute;
    inset: 0;
  }

  .reel-tile .logo {
    width: calc(432 / 1512 * 100%);
    max-height: 55%;
    object-fit: contain;
  }

  .reel-tile .canvas,
  .reel-grid .canvas {
    transition: none;
  }

  [data-mode='tile'] .tile-art .image,
  [data-mode='tile'] .tile-art .logo,
  [data-mode='on'] .tile-art .image,
  [data-mode='burn'] .tile-art .logo {
    visibility: hidden;
  }

  [data-reel='on'] [data-mode='tile'] .tile-art .image,
  [data-reel='on'] [data-mode='on'] .tile-art .image {
    visibility: visible;
    animation: screen-on 1000ms 200ms both;
  }

  [data-reel='on'] [data-mode='tile'] .tile-art .logo {
    visibility: visible;
    animation: logo-burn 700ms var(--ease-out) 720ms both;
  }

  [data-reel='on'] [data-mode='burn'] .tile-art .logo {
    visibility: visible;
    animation: logo-burn 700ms var(--ease-out) 200ms both;
  }

  /* Ending */

  .reel-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 340px);
    grid-auto-rows: 340px;
    gap: 24px;
    place-content: center;
  }

  .reel-grid .item.tile-art {
    --radius-s: 8px;
  }

  [data-reel='on'] .reel-grid .item {
    animation: crt-off 333ms calc(400ms + var(--i, 0) * 240ms) both;
  }

  .reel-grid .item:nth-child(2) { --i: 1; }
  .reel-grid .item:nth-child(3) { --i: 2; }
  .reel-grid .item:nth-child(4) { --i: 3; }
  .reel-grid .item:nth-child(5) { --i: 4; }
  .reel-grid .item:nth-child(6) { --i: 5; }

  @keyframes crt-off {
    0% {
      transform: none;
      filter: none;
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    50% {
      transform: scale(1, 0.006);
      filter: brightness(4) saturate(0);
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    85% {
      transform: scale(0.012, 0.006);
      filter: brightness(4) saturate(0);
      opacity: 1;
    }
    100% {
      transform: scale(0.012, 0.006);
      filter: brightness(4) saturate(0);
      opacity: 0;
    }
  }
</style>

<script is:inline>
  window.reelStart = () => (document.documentElement.dataset.reel = 'on');
</script>
