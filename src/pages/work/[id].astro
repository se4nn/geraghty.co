---
// Case study. One page per project in src/content/work that has a
// caseStudy block: the hero from its front matter, then its MDX body, then
// the next project and the footer.
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseIntro from '../../components/CaseIntro.astro';
import Chapter from '../../components/Chapter.astro';
import Section from '../../components/Section.astro';
import Column from '../../components/Column.astro';
import Stats from '../../components/Stats.astro';
import Stat from '../../components/Stat.astro';
import Label from '../../components/Label.astro';
import Badge from '../../components/Badge.astro';
import Skills from '../../components/Skills.astro';
import Crop from '../../components/Crop.astro';
import CropImage from '../../components/CropImage.astro';
import CropLink from '../../components/CropLink.astro';
import Pair from '../../components/Pair.astro';
import Timeline from '../../components/Timeline.astro';
import ScreenRow from '../../components/ScreenRow.astro';
import LogoCard from '../../components/LogoCard.astro';
import NextProject from '../../components/NextProject.astro';
import Availability from '../../components/Availability.astro';
import Testimonial from '../../components/Testimonial.astro';
import Footer from '../../components/Footer.astro';
import { availability, contactEmail, testimonial } from '../../data/home';
import formatStacked from '../../assets/logos/format.svg';

export async function getStaticPaths() {
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return projects
    .filter((project) => project.data.caseStudy)
    .map((project) => {
      // The chosen next project, or the next one along the homepage grid,
      // wrapping to the top
      const i = projects.indexOf(project);
      const chosen = projects.find((p) => p.id === project.data.caseStudy!.next);
      const next = chosen ?? projects[(i + 1) % projects.length];
      return { params: { id: project.id }, props: { project, next } };
    });
}

interface Props {
  project: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { project, next } = Astro.props;
const { title } = project.data;
const study = project.data.caseStudy!;
const { Content } = await render(project);

// Stacked logos for the Next Project tile, where the design uses them
const stackedLogos: Record<string, ImageMetadata> = { format: formatStacked };

// Case study components the MDX body can use without importing them
const components = {
  CaseIntro,
  Chapter,
  Section,
  Column,
  Stats,
  Stat,
  Label,
  Badge,
  Skills,
  Crop,
  CropImage,
  CropLink,
  Pair,
  Timeline,
  ScreenRow,
  LogoCard,
};
---

<Base title={`${title}, a case study by Sean Geraghty`} description={study.summary}>
  <main>
    <!-- Everything before the footer. The availability pill parks at its end. -->
    <div class="study-body">
      <CaseHero project={project} />
      <Content components={components} />
      <NextProject project={next} logo={stackedLogos[next.id] ?? next.data.tile.logo} />
      <Availability label={availability} email={contactEmail} />
    </div>

    <Footer email={contactEmail} label="Testimonial and contact">
      <Testimonial {...testimonial} />
    </Footer>
  </main>
</Base>
