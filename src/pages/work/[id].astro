---
// A case study for each project in src/content/work with a caseStudy block:
// the hero from its front matter, its MDX body, the next project, the footer.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseIntro from '../../components/CaseIntro.astro';
import Chapter from '../../components/Chapter.astro';
import Section from '../../components/Section.astro';
import Column from '../../components/Column.astro';
import Stats from '../../components/Stats.astro';
import Stat from '../../components/Stat.astro';
import Badge from '../../components/Badge.astro';
import Skills from '../../components/Skills.astro';
import Crop from '../../components/Crop.astro';
import CropImage from '../../components/CropImage.astro';
import CompareScreens from '../../components/CompareScreens.astro';
import CropLink from '../../components/CropLink.astro';
import Pair from '../../components/Pair.astro';
import Trio from '../../components/Trio.astro';
import Timeline from '../../components/Timeline.astro';
import ScreenRow from '../../components/ScreenRow.astro';
import LogoCard from '../../components/LogoCard.astro';
import Palette from '../../components/Palette.astro';
import MarkBuild from '../../components/MarkBuild.astro';
import Pillars from '../../components/Pillars.astro';
import Film from '../../components/Film.astro';
import BuildLoop from '../../components/BuildLoop.astro';
import StudiaOpener from '../../components/StudiaOpener.astro';
import FormatOpener from '../../components/FormatOpener.astro';
import FormatVariables from '../../components/FormatVariables.astro';
import PageWall from '../../components/PageWall.astro';
import ReportZoom from '../../components/ReportZoom.astro';
import Quote from '../../components/Quote.astro';
import NextProject from '../../components/NextProject.astro';
import Availability from '../../components/Availability.astro';
import Testimonial from '../../components/Testimonial.astro';
import Footer from '../../components/Footer.astro';
import { availability, contactEmail, testimonial } from '../../data/home';

export async function getStaticPaths() {
  const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return projects
    .filter((project) => project.data.caseStudy)
    .map((project) => {
      // The chosen next, or the next case study down the grid (wrapping).
      // Projects with no case study are skipped so the tile leads somewhere.
      const studies = projects.filter((p) => p.data.caseStudy);
      const i = studies.indexOf(project);
      const chosen = projects.find((p) => p.id === project.data.caseStudy!.next);
      const next = chosen ?? studies[(i + 1) % studies.length];
      return { params: { id: project.id }, props: { project, next } };
    });
}

interface Props {
  project: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { project, next } = Astro.props;
const { title } = project.data;
const study = project.data.caseStudy!;
const { Content } = await render(project);

// Case study components the MDX body can use without importing them
const components = {
  CaseIntro,
  Chapter,
  Section,
  Column,
  Stats,
  Stat,
  Badge,
  Skills,
  Crop,
  CropImage,
  CompareScreens,
  CropLink,
  Pair,
  Trio,
  Timeline,
  ScreenRow,
  LogoCard,
  Palette,
  MarkBuild,
  Pillars,
  Film,
  BuildLoop,
  StudiaOpener,
  FormatOpener,
  FormatVariables,
  PageWall,
  ReportZoom,
  Quote,
};
---

<Base title={`${title}, a case study by Sean Geraghty`} description={study.summary} image={`/og/${project.id}.jpg`}>
  <main>
    {/* Everything before the footer. The availability pill parks at the end
        of the story, before NextProject, so it never sits over the tile */}
    <div class="study-body">
      <CaseHero project={project} />
      <Content components={components} />
      <Availability label={availability} email={contactEmail} />
      <NextProject project={next} />
    </div>

    <Footer email={contactEmail} label="Testimonial and contact">
      <Testimonial {...testimonial} link={testimonial.link === `/work/${project.id}/` ? undefined : testimonial.link} />
    </Footer>
  </main>
</Base>
