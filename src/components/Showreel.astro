---
// Figma: "Video". Shows the poster until a video file is supplied.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  poster: ImageMetadata;
  alt: string;
  video?: string;
}

const { poster, alt, video } = Astro.props;
---

<div class="showreel">
  {
    video ? (
      <video class="showreel__media" src={video} poster={poster.src} autoplay muted loop playsinline />
    ) : (
      <Image class="showreel__media" src={poster} alt={alt} widths={[750, 1416, 2832]} sizes="94vw" loading="eager" />
    )
  }
</div>

<style>
  .showreel {
    aspect-ratio: 1416 / 800;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-100);
  }

  .showreel__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
