---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  poster: ImageMetadata;
  alt: string;
  video: string;
  loader?: string[];
}

const { poster, alt, video, loader } = Astro.props;
const posterImage = await getImage({ src: poster, width: 2000, format: 'webp', quality: 90 });
const phone = '(max-width: 699px)';
const av1 = 'video/webm; codecs="av01.0.08M.08"';
const hevc = 'video/mp4; codecs="hvc1"';
---

<div class="showreel">
  <video
    class="media"
    poster={posterImage.src}
    aria-label={alt}
    muted
    loop
    playsinline
    preload="metadata"
  >
    <source src={`${video}-720.webm`} type={av1} media={phone} />
    <source src={`${video}-720.hevc.mp4`} type={hevc} media={phone} />
    <source src={`${video}.webm`} type={av1} />
    <source src={`${video}.hevc.mp4`} type={hevc} />
    <source src={`${video}-720.mp4`} type="video/mp4" />
  </video>
  {
    loader && (
      <div class="cover" aria-hidden="true">
        <div class="flick" data-images={JSON.stringify(loader)} />
      </div>
    )
  }
</div>

<style>
  .showreel {
    aspect-ratio: 1416 / 800;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-100);
  }

  @media (min-width: 701px) {
    .showreel {
      width: calc(1102 / 1416 * 100%);
      margin-inline: auto;
    }
  }

  .media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover {
    display: none;
  }

  /* Loader */

  :global(html[data-intro]) {
    overflow: hidden;
  }

  :global(html[data-intro]) .cover {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--bg-page);
  }

  :global(html[data-intro]:not([data-intro='settling'])) .showreel {
    background-color: transparent;
  }

  :global(html[data-intro]:not([data-intro='settling'])) .media {
    visibility: hidden;
  }

  .flick {
    position: fixed;
    inset: 0;
    width: clamp(280px, 36vw, 560px);
    height: auto;
    aspect-ratio: 1416 / 800;
    margin: auto;
    overflow: hidden;
    border-radius: var(--radius-s);
    background-color: var(--neutral-100);
  }

  .flick :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flick :global(img:not([data-on])) {
    visibility: hidden;
  }

  .flick::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(to bottom, oklch(0% 0 0 / 0.4) 0 1px, transparent 1px 3px);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import { reducedMotion, wait, token } from '../scripts/arrival';

  const root = document.documentElement;
  const POWER_ON = 560;
  const hold = (i: number, n: number) => {
    const last = n - 1;
    if (i === 0) return POWER_ON - 80;
    if (i === last) return 360;
    const fromEnd = last - i;
    if (fromEnd <= 3) return [0, 190, 130, 90][fromEnd];
    const p = Math.min(1, i / Math.max(1, last - 4) / 0.45);
    return Math.round(60 + 120 * (1 - p) ** 2);
  };
  const AT_MOST = 4000;

  // Playback

  for (const video of document.querySelectorAll<HTMLVideoElement>('.showreel video.media')) {
    let seen = false;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (root.hasAttribute('data-intro')) return;
        if (entry.intersectionRatio >= 0.33 && !reducedMotion.matches) {
          seen = true;
          video.play().catch(() => {});
        } else if (!entry.isIntersecting && seen) {
          video.pause();
        }
      },
      { threshold: [0, 0.33] },
    );

    const flick = video.parentElement!.querySelector<HTMLElement>('.flick');
    if (flick && root.hasAttribute('data-intro')) {
      root.dataset.intro = 'running';
      loader(video, flick).then(() => io.observe(video));
    } else {
      io.observe(video);
    }
  }

  // Loader

  async function loader(video: HTMLVideoElement, flick: HTMLElement) {
    const slot = video.parentElement!;
    const sources: string[] = JSON.parse(flick.dataset.images ?? '[]');
    const images = sources.map((src) => {
      const img = new Image();
      img.alt = '';
      img.decoding = 'async';
      img.src = src;
      flick.append(img);
      return { img, ready: img.decode().then(() => true, () => false) };
    });
    video.preload = 'auto';
    video.load();

    let stop = false;
    const end = () => (stop = true);
    const onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Tab') event.preventDefault();
      end();
    };
    addEventListener('wheel', end, { passive: true });
    addEventListener('touchmove', end, { passive: true });
    addEventListener('pointerdown', end);
    addEventListener('keydown', onKey);
    const deadline = setTimeout(end, AT_MOST);

    const cut = () => {
      flick.animate([{ filter: 'brightness(1.6) saturate(0.6)' }, { filter: 'none' }], { duration: 70, easing: 'steps(2, end)' });
      flick.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 70, easing: 'steps(2, end)', pseudoElement: '::after' });
    };
    const land = () =>
      flick.animate(
        [
          { filter: 'brightness(1.7) saturate(0.6)' },
          { filter: 'brightness(1.15) saturate(1.1)', offset: 0.45 },
          { filter: 'brightness(1.3) saturate(1)', offset: 0.6 },
          { filter: 'none' },
        ],
        { duration: 420, easing: 'ease-out' },
      );

    let shown: HTMLImageElement | undefined;
    const show = (img: HTMLImageElement) => {
      shown?.removeAttribute('data-on');
      img.toggleAttribute('data-on', true);
      shown = img;
    };
    const last = images.at(-1)!;
    for (const [i, { img, ready }] of images.entries()) {
      if (stop) break;
      if (!(await ready)) continue;
      if (!shown) flick.style.animation = `screen-on ${POWER_ON}ms both`;
      else if (img === last.img) land();
      else cut();
      show(img);
      await wait(hold(i, images.length));
    }
    if (stop && shown !== last.img && last.img.complete && last.img.naturalWidth) {
      show(last.img);
      land();
      await wait(240);
    }
    clearTimeout(deadline);
    removeEventListener('wheel', end);
    removeEventListener('touchmove', end);
    removeEventListener('pointerdown', end);
    removeEventListener('keydown', onKey);

    const page = document.querySelector<HTMLElement>('[data-intro-page]');
    window.scrollTo({ top: 0, behavior: 'instant' });
    const from = flick.getBoundingClientRect();
    const to = slot.getBoundingClientRect();
    const top = Math.max(0, (innerHeight - to.height) / 2);
    Object.assign(flick.style, {
      inset: 'auto',
      margin: '0',
      left: `${to.left}px`,
      top: `${top}px`,
      width: `${to.width}px`,
      height: `${to.height}px`,
      transformOrigin: '0 0',
    });
    await flick
      .animate(
        [{ transform: `translate(${from.left - to.left}px, ${from.top - top}px) scale(${from.width / to.width})` }, { transform: 'none' }],
        { duration: 500, easing: token('--ease-out', 'ease-out') },
      )
      .finished.catch(() => {});

    video.currentTime = 0;
    await Promise.race([
      new Promise((r) => video.addEventListener('playing', r, { once: true })),
      video.play().catch(() => {}),
      wait(1500),
    ]);

    const shift = to.top - top;
    page?.style.setProperty('--intro-shift', `${shift}px`);
    const sliding = page?.animate([{ translate: `0 ${-shift}px` }, { translate: '0 0' }], {
      duration: parseFloat(token('--duration-page', '1100')),
      easing: token('--ease-in-out', 'ease-in-out'),
    });
    root.dataset.intro = 'settling';
    flick.parentElement!.remove();
    await sliding?.finished.catch(() => {});
    root.removeAttribute('data-intro');
  }
</script>
