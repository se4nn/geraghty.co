---
// Figma: "Video". The showreel, muted and looping (docs/SHOWREEL-PLAN.md;
// made by scripts/reel/). It only plays while it's on screen.
//
// `loader`: on a first visit the reel opens the site as a loader. The page
// loads finished under a cover in its own colour, and a small screen in the
// middle flicks through the work, a hard cut every ~110ms, each image shown
// only once it has loaded. The last image is the reel's first frame. The
// screen grows in place to the reel's size and the reel takes over from that
// frame; then the cover goes with the page shifted so the slot sits exactly
// under it, and the whole page slides into place: the hero comes down from
// the top and pushes the reel down into its slot, and the hero's scribble
// circles "miss" just after it lands. The page marks what slides with
// data-intro-page. Scroll, a key or a click ends the flicking at once.
// The page's head script decides before the first paint whether it plays:
// on every load and reload of the page, never coming back to it from a case
// study, never with reduced motion or Save-Data.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  poster: ImageMetadata;
  alt: string;
  // Path without extension: <video>.webm (AV1) and .hevc.mp4, -720 versions
  // of both for phones, and <video>-720.mp4 (H.264) for anything older
  video?: string;
  // The loader's images, in order; the last is the reel's first frame
  loader?: string[];
}

const { poster, alt, video, loader } = Astro.props;
const posterImage = await getImage({ src: poster, width: 2000, format: 'webp' });
const phone = '(max-width: 699px)';
const av1 = 'video/webm; codecs="av01.0.08M.08"';
const hevc = 'video/mp4; codecs="hvc1"';
---

<div class="showreel">
  {
    video ? (
      <video
        class="showreel__media"
        poster={posterImage.src}
        aria-label={alt}
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source src={`${video}-720.webm`} type={av1} media={phone} />
        <source src={`${video}-720.hevc.mp4`} type={hevc} media={phone} />
        <source src={`${video}.webm`} type={av1} />
        <source src={`${video}.hevc.mp4`} type={hevc} />
        <source src={`${video}-720.mp4`} type="video/mp4" />
      </video>
    ) : (
      <Image class="showreel__media" src={poster} alt={alt} widths={[750, 1416, 2832]} sizes="94vw" loading="eager" />
    )
  }
  {
    loader && video && (
      <div class="showreel__cover" aria-hidden="true">
        <div class="showreel__flick" data-images={JSON.stringify(loader)} />
      </div>
    )
  }
</div>

<style>
  .showreel {
    aspect-ratio: 1416 / 800;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-100);
  }

  /* The size of Format's screen in its opener (1102 of 1416): a screen on
     the page rather than a band across it. Phones keep the full width. */
  @media (min-width: 700px) {
    .showreel {
      width: calc(1102 / 1416 * 100%);
      margin-inline: auto;
    }
  }

  .showreel__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showreel__cover {
    display: none;
  }

  /* The loader. The page underneath is finished and still; it's only
     covered, and can't scroll until the reel is in its place */
  :global(html[data-intro]) {
    overflow: hidden;
  }

  :global(html[data-intro]) .showreel__cover {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--bg-page);
  }

  /* The slot waits, empty and unseen, until the reel takes over */
  :global(html[data-intro]:not([data-intro='settling'])) .showreel {
    background-color: transparent;
  }

  :global(html[data-intro]:not([data-intro='settling'])) .showreel__media {
    visibility: hidden;
  }

  .showreel__flick {
    position: fixed;
    inset: 0;
    width: clamp(280px, 36vw, 560px);
    height: auto;
    aspect-ratio: 1416 / 800;
    margin: auto;
    overflow: hidden;
    border-radius: var(--radius-s);
    background-color: var(--neutral-100);
  }

  .showreel__flick :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showreel__flick :global(img:not([data-on])) {
    visibility: hidden;
  }

  /* Scanlines, seen only in the frame of a cut */
  .showreel__flick::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(to bottom, oklch(0% 0 0 / 0.4) 0 1px, transparent 1px 3px);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  // How long each image holds, in ms: a slot machine's rhythm. The first
  // holds while the screen switches on, then the cuts speed up from 180 to
  // 60 a frame, run at 60, and brake hard into the last image, the reel's
  // first frame, which holds before the reel takes over. An image not
  // loaded yet holds the one before it.
  const POWER_ON = 560;
  const hold = (i: number, n: number) => {
    const last = n - 1;
    if (i === 0) return POWER_ON - 80;
    if (i === last) return 360;
    const fromEnd = last - i;
    if (fromEnd <= 3) return [0, 190, 130, 90][fromEnd];
    const p = Math.min(1, i / Math.max(1, last - 4) / 0.45);
    return Math.round(60 + 120 * (1 - p) ** 2);
  };
  // However slow the network, the page is never held longer than this
  const AT_MOST = 4000;

  for (const video of document.querySelectorAll<HTMLVideoElement>('.showreel__media')) {
    if (video.tagName !== 'VIDEO') continue;

    // Play once at least a third is on screen; pause only once it's gone
    // altogether, so a reel that has just landed half on screen keeps
    // playing. Reduced motion keeps the poster.
    let seen = false;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (root.hasAttribute('data-intro')) return;
        if (entry.intersectionRatio >= 0.33 && !reducedMotion.matches) {
          seen = true;
          // Muted, so browsers allow it; ignore the rare refusal
          video.play().catch(() => {});
        } else if (!entry.isIntersecting && seen) {
          video.pause();
        }
      },
      { threshold: [0, 0.33] },
    );

    const flick = video.parentElement!.querySelector<HTMLElement>('.showreel__flick');
    if (flick && root.hasAttribute('data-intro')) {
      root.dataset.intro = 'running';
      loader(video, flick).then(() => {
        io.observe(video);
        document.dispatchEvent(new CustomEvent('intro:done'));
      });
    } else {
      io.observe(video);
    }
  }

  async function loader(video: HTMLVideoElement, flick: HTMLElement) {
    const slot = video.parentElement!;
    const sources: string[] = JSON.parse(flick.dataset.images ?? '[]');
    const images = sources.map((src) => {
      const img = new Image();
      img.alt = '';
      img.decoding = 'async';
      img.src = src;
      flick.append(img);
      return { img, ready: img.decode().then(() => true, () => false) };
    });
    // The reel loads alongside, so it's ready to take over from its frame
    video.preload = 'auto';
    video.load();

    let stop = false;
    const end = () => (stop = true);
    const onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Tab') event.preventDefault();
      end();
    };
    addEventListener('wheel', end, { passive: true });
    addEventListener('touchmove', end, { passive: true });
    addEventListener('pointerdown', end);
    addEventListener('keydown', onKey);
    const deadline = setTimeout(end, AT_MOST);

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    // The site's CRT: the screen switches on as a case study hero does
    // (global.css, screen-on), every cut flashes for a frame with scanlines,
    // and the last image lands overexposed with the power-on's one flicker
    const cut = () => {
      flick.animate([{ filter: 'brightness(1.6) saturate(0.6)' }, { filter: 'none' }], { duration: 70, easing: 'steps(2, end)' });
      flick.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 70, easing: 'steps(2, end)', pseudoElement: '::after' });
    };
    const land = () =>
      flick.animate(
        [
          { filter: 'brightness(1.7) saturate(0.6)' },
          { filter: 'brightness(1.15) saturate(1.1)', offset: 0.45 },
          { filter: 'brightness(1.3) saturate(1)', offset: 0.6 },
          { filter: 'none' },
        ],
        { duration: 420, easing: 'ease-out' },
      );

    let shown: HTMLImageElement | undefined;
    const show = (img: HTMLImageElement) => {
      shown?.removeAttribute('data-on');
      img.toggleAttribute('data-on', true);
      shown = img;
    };
    const last = images.at(-1)!;
    for (const [i, { img, ready }] of images.entries()) {
      if (stop) break;
      if (!(await ready)) continue;
      if (!shown) flick.style.animation = `screen-on ${POWER_ON}ms both`;
      else if (img === last.img) land();
      else cut();
      show(img);
      await wait(hold(i, images.length));
    }
    // Ended early: cut to the last image (the reel's first frame) if it's here
    if (stop && shown !== last.img && last.img.complete && last.img.naturalWidth) {
      show(last.img);
      land();
      await wait(240);
    }
    clearTimeout(deadline);
    removeEventListener('wheel', end);
    removeEventListener('touchmove', end);
    removeEventListener('pointerdown', end);
    removeEventListener('keydown', onKey);

    const token = (name: string, fallback: string) => getComputedStyle(root).getPropertyValue(name).trim() || fallback;

    // 1. The screen grows in place to the reel's size, still in the middle
    // of the screen. A transform on a box already drawn at full size, so
    // nothing is laid out or resampled as it grows.
    const page = document.querySelector<HTMLElement>('[data-intro-page]');
    // A reload part-way down the page comes back to where it was; under the
    // cover, take it to the top, where the page arrives
    window.scrollTo({ top: 0, behavior: 'instant' });
    const from = flick.getBoundingClientRect();
    const to = slot.getBoundingClientRect();
    const top = Math.max(0, (innerHeight - to.height) / 2);
    Object.assign(flick.style, {
      inset: 'auto',
      margin: '0',
      left: `${to.left}px`,
      top: `${top}px`,
      width: `${to.width}px`,
      height: `${to.height}px`,
      transformOrigin: '0 0',
    });
    await flick
      .animate(
        [{ transform: `translate(${from.left - to.left}px, ${from.top - top}px) scale(${from.width / to.width})` }, { transform: 'none' }],
        { duration: 500, easing: token('--ease-out', 'ease-out') },
      )
      .finished.catch(() => {});

    // 2. The reel takes over from the same frame, once it's actually playing
    video.currentTime = 0;
    await Promise.race([
      new Promise((r) => video.addEventListener('playing', r, { once: true })),
      video.play().catch(() => {}),
      wait(1500),
    ]);

    // 3. The page, shifted so the slot is exactly where the screen was, takes
    // its place in the same frame as the cover goes, then slides into place:
    // the hero comes down from the top and pushes the reel into its slot.
    const shift = to.top - top;
    const sliding = page?.animate([{ translate: `0 ${-shift}px` }, { translate: '0 0' }], {
      duration: 1100,
      easing: token('--ease-in-out', 'ease-in-out'),
    });
    root.dataset.intro = 'settling';
    flick.parentElement!.remove();
    await sliding?.finished.catch(() => {});
    root.removeAttribute('data-intro');
  }
</script>
