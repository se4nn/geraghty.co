---
// A brand palette in one block: the primary ramp named down the left, the
// secondary ramps as plain chips on the right, one ramp to a row.
interface Swatch {
  name: string;
  hex: string;
  color: string;
  // 'dark' where a primary swatch needs light text
  on?: 'light' | 'dark';
}

interface Props {
  primary: Swatch[];
  secondary: Swatch[];
  // Shades per secondary ramp
  columns: number;
  label: string;
}

const { primary, secondary, columns, label } = Astro.props;
---

<div class="palette" role="group" aria-label={label}>
  <ul class="palette__primary" role="list">
    {
      primary.map((item) => (
        <li class:list={['palette__swatch', { 'palette__swatch--dark': item.on === 'dark' }]} style={`--swatch: ${item.color}`}>
          <span class="t-body-bold">{item.name}</span>
          <span class="palette__hex t-label">{item.hex}</span>
        </li>
      ))
    }
  </ul>
  <ul class="palette__secondary" role="list" style={`--columns: ${columns}`}>
    {
      secondary.map((item) => (
        <li class="palette__chip" style={`--swatch: ${item.color}`}>
          <span class="visually-hidden">
            {item.name} {item.hex}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Two halves, spaced like a Pair of images, at 1416 × 560 */
  .palette {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    aspect-ratio: 1416 / 560;
  }

  .palette__primary,
  .palette__secondary {
    display: grid;
    overflow: clip;
    border-radius: var(--radius-s);
    list-style: none;
    padding: 0;
  }

  .palette__primary {
    grid-auto-rows: minmax(0, 1fr);
  }

  .palette__secondary {
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
  }

  .palette__swatch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-inline: var(--space-l);
    background-color: var(--swatch);
    color: var(--text-strong);
  }

  .palette__swatch--dark {
    color: var(--text-on-dark);
  }

  .palette__hex {
    text-transform: uppercase;
    opacity: 0.72;
  }

  /* A chip can be a gradient as well as a flat colour */
  .palette__chip {
    background: var(--swatch);
  }

  /* Phones: the primary ramp, then the grid under it */
  @media (max-width: 700px) {
    .palette {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
      aspect-ratio: auto;
    }

    .palette__swatch {
      padding-block: var(--space-s);
      padding-inline: var(--space-m);
    }

    .palette__chip {
      aspect-ratio: 1;
    }
  }
</style>
