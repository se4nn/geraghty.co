---
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';
import Button from './Button.astro';
import Bar from './Bar.astro';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, tags, dates, tile } = project.data;
const study = project.data.caseStudy!;
const logoAspect = tile.logo.width / tile.logo.height;
---

<header class="case-hero" style={`--logo-aspect: ${logoAspect.toFixed(4)}`}>
  <h1 class="visually-hidden">{title}</h1>
  <TileArt
    class="art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="100vw"
    widths={[820, 1640, 2832]}
    eager
    transitionName={project.id}
  />
  <div class="overlay">
    <nav class="nav" aria-label="Case study">
      <span class="close">
        <Button href={`/#work-${project.id}`} variant="light" label="Projects, back to all work">Projects</Button>
      </span>
      {
        study.links.length > 0 && (
          <ul class="links" role="list">
            {study.links.map((link) => (
              <li>
                <Button href={link.href} variant="glass">{link.label}</Button>
              </li>
            ))}
          </ul>
        )
      }
    </nav>
    <Bar lead={tags} middle={study.role} trail={dates} />
  </div>
</header>

<style>
  .case-hero {
    position: relative;
    display: grid;
    width: 100%;
    height: 80svh;
    min-height: 440px;
    color: var(--text-on-dark);
  }

  .case-hero > :global(*) {
    grid-area: 1 / 1;
  }

  .case-hero :global(.tile-art.art) {
    border-radius: 0;
  }

  .case-hero :global(.lens-flare .canvas) {
    transition: none;
  }

  .case-hero :global(.tile-art.art .logo) {
    width: calc(clamp(200px, calc(432 / 1512 * 100%), 640px) * sqrt(var(--logo-aspect, 3.94) / 3.94));
    max-width: 80%;
    max-height: 55%;
    object-fit: contain;
  }

  /* Overlay */

  .overlay {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--page-gutter);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    list-style: none;
  }

  .case-hero :global(.bar .lead) {
    color: var(--text-on-dark);
  }

  .case-hero :global(.bar :is(.middle, .trail)) {
    color: var(--neutral-050);
  }

  .close {
    display: contents;
  }

  /* Phones */

  @media (max-width: 700px) {
    .links {
      gap: var(--space-s);
    }
  }
</style>

<script>
  const close = document.querySelector<HTMLAnchorElement>('.case-hero .close a');
  close?.addEventListener('click', (event) => {
    const from = (window as any).navigation?.activation?.from?.url ?? document.referrer;
    if (!from) return;
    const url = new URL(from);
    if (url.origin === location.origin && url.pathname === '/' && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });
</script>
