---
// The top of a case study: the project's tile art full bleed (so the homepage
// tile morphs into it), Projects top left, the project's links top right, and
// a Bar of tags, role and dates along the foot.
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';
import Button from './Button.astro';
import Bar from './Bar.astro';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, tags, dates, tile } = project.data;
const study = project.data.caseStudy!;
// Logos are sized by area, not width, so the CSS needs the shape
const logoAspect = tile.logo.width / tile.logo.height;
---

<header class="case-hero" style={`--logo-aspect: ${logoAspect.toFixed(4)}`}>
  <h1 class="visually-hidden">{title}</h1>
  <TileArt
    class="case-hero__art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="100vw"
    widths={[820, 1640, 2832]}
    eager
    transitionName={project.id}
  />
  <div class="case-hero__overlay">
    <nav class="case-hero__nav" aria-label="Case study">
      <span class="case-hero__close">
        <Button href={`/#work-${project.id}`} variant="light" label="Projects, back to all work">Projects</Button>
      </span>
      {
        study.links.length > 0 && (
          <ul class="case-hero__links" role="list">
            {study.links.map((link) => (
              <li>
                <Button href={link.href} variant="glass">{link.label}</Button>
              </li>
            ))}
          </ul>
        )
      }
    </nav>
    <Bar lead={tags} middle={study.role} trail={dates} />
  </div>
</header>

<style>
  .case-hero {
    position: relative;
    display: grid;
    /* 720 of a 900 tall window; the floor keeps room for the logo and bar */
    width: 100%;
    height: 80svh;
    min-height: 440px;
    color: var(--text-on-dark);
  }

  .case-hero > :global(*) {
    grid-area: 1 / 1;
  }

  .case-hero :global(.case-hero__art) {
    border-radius: 0;
  }

  /* No fade from the still: mid power-on, the swap to live would flicker */
  .case-hero :global(.lens-flare__canvas) {
    transition: none;
  }

  /* Logos by area: each covers what Fertifa's (284 × 72, aspect 3.94) does at
     432 wide at 1512. Keep NextProject's rule identical or the logo jumps */
  .case-hero :global(.case-hero__art .tile-art__logo) {
    width: calc(clamp(200px, calc(432 / 1512 * 100%), 640px) * sqrt(var(--logo-aspect, 3.94) / 3.94));
    max-width: 80%;
    max-height: 55%;
    object-fit: contain;
  }

  /* Overlay */

  .case-hero__overlay {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--page-gutter);
  }

  .case-hero__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
  }

  .case-hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    list-style: none;
  }

  .case-hero :global(.bar__lead) {
    color: var(--text-on-dark);
  }

  .case-hero :global(:is(.bar__middle, .bar__trail)) {
    color: var(--neutral-050);
  }

  .case-hero__close {
    display: contents;
  }

  /* Phones */

  @media (max-width: 700px) {
    .case-hero__links {
      gap: var(--space-s);
    }
  }
</style>

<script>
  // From the homepage, Projects goes back in history so the reader lands where
  // they left it (MOTION.md: Power on); otherwise it links to the tile
  const close = document.querySelector<HTMLAnchorElement>('.case-hero__close a');
  close?.addEventListener('click', (event) => {
    const from = (window as any).navigation?.activation?.from?.url ?? document.referrer;
    if (!from) return;
    const url = new URL(from);
    if (url.origin === location.origin && url.pathname === '/' && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });
</script>
