---
// Figma: "Intro". Serif line with underlined links that never break mid-phrase.
interface Props {
  lead: string;
  links: { label: string; href?: string }[];
}

const { lead, links } = Astro.props;
const last = links.length - 1;
---

<p class="intro-line t-h1">
  {lead}{' '}
  {
    links.map((link, i) => (
      <>
        {i === last && <>&amp; </>}
        {link.href ? (
          <a class="intro-line__link" href={link.href}>{link.label}</a>
        ) : (
          <span class="intro-line__link">{link.label}</span>
        )}{' '}
      </>
    ))
  }
</p>

<style>
  .intro-line {
    max-width: 23em;
    margin-inline: auto;
    text-align: center;
    color: var(--text-strong);
  }

  /* Underline sits on the line box edge, below the descenders, as in Figma */
  .intro-line__link {
    display: inline-block;
    border-bottom: var(--underline-width) solid currentColor;
    white-space: nowrap;
  }

  a.intro-line__link {
    transition: color var(--duration-s) var(--ease-out);
  }

  @media (hover: hover) {
    a.intro-line__link:hover {
      color: var(--text-muted);
    }
  }

  /* Hover: the underline is pulled away to the right and drawn back in from
     the left, a quick pen stroke that echoes the hero's scribble. The border
     keeps its space (so nothing shifts) but goes clear, and a line drawn over
     it does the moving. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.intro-line__link {
      position: relative;
      border-bottom-color: transparent;
    }

    a.intro-line__link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: calc(-1 * var(--underline-width));
      height: var(--underline-width);
      background-color: currentColor;
    }

    a.intro-line__link:hover::after {
      animation: intro-underline-redraw 720ms both;
    }
  }

  @keyframes intro-underline-redraw {
    0% {
      scale: 1 1;
      transform-origin: right;
      animation-timing-function: cubic-bezier(0.55, 0, 0.9, 0.4);
    }
    38% {
      scale: 0 1;
      transform-origin: right;
    }
    /* Pen lifted for a beat before it comes back in */
    38.01%,
    48% {
      scale: 0 1;
      transform-origin: left;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.3, 1);
    }
    100% {
      scale: 1 1;
      transform-origin: left;
    }
  }
</style>
