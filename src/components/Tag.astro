---
// Label used in the skills row. Figma: "Tag"
// outline: bordered pill. surface: white pill. plain: text and logos only.
interface Props {
  variant?: 'outline' | 'surface' | 'plain';
}

const { variant = 'outline' } = Astro.props;
---

<span class:list={['tag', `tag--${variant}`, 't-h3']}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-l);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .tag--plain {
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
  }

  .tag--surface {
    background-color: var(--neutral-000);
    gap: var(--space-s);
  }
</style>
