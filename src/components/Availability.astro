---
// Availability pill. Figma: "Currently" / "Availability (hover)"
// Floats bottom right, then parks above the footer: render it as the last
// child of the content that scrolls before the footer.
//
// Click copies the email address. Hover: the lime dot blooms into the neon
// fill, "Open to work" lifts away and "Copy email" springs in from below.
// Leaving runs the other way: the labels hand back first, then the fill
// settles into the dot. Pressing gives a small bounce.
interface Props {
  label: string;
  email: string;
}

const { label, email } = Astro.props;
---

<div class="availability-rail">
  <button
    class="availability t-h3"
    type="button"
    data-email={email}
    aria-label={`${label}. Copy email address ${email}`}
  >
    <span class="availability__fill" aria-hidden="true"></span>
    <span class="availability__rest" aria-hidden="true">{label}</span>
    <span class="availability__dot" aria-hidden="true"></span>
    <span class="availability__hover" aria-hidden="true">
      <span class="availability__action">Copy email</span>
      <span class="availability__done">Copied</span>
    </span>
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-availability-status></span>
</div>

<script>
  // How long "Copied" holds when the pointer stays on the pill (or on touch)
  const COPIED_FOR = 1800;
  // Minimum time "Copied" shows before the pill follows a pointer that's left
  const COPIED_MIN = 500;
  // Matches the leave sequence, so the label only resets once it's hidden
  const EXIT_TIME = 460;
  // The bouncy spring from tokens.css
  const BOUNCE =
    getComputedStyle(document.documentElement).getPropertyValue('--ease-bounce').trim() || 'ease-out';

  // Clipboard API first, then the older selection-based copy for browsers
  // or embeds that block it
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.cssText = 'position: fixed; opacity: 0; pointer-events: none;';
      document.body.append(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      return copied;
    }
  }

  // Entrance: the pill waits for the hero. It rises in just after the
  // scribble lifts off "miss", so the opening reads headline, scribble, then
  // "Open to work". It comes in straight away if the hero isn't on screen,
  // or as soon as the reader scrolls it away.
  //
  // Held at the bottom of the screen, it rises up from below the edge. If
  // it's already parked above the footer (a jump to the end), a rise from
  // below would pass over the footer, so it settles in from just below its
  // spot instead.
  const ENTER_AFTER_SCRIBBLE = 150;
  const ENTER_AT_MOST = 4000;
  const heroCircle = document.querySelector('.hero__circle');
  const heroOnScreen = (() => {
    if (!heroCircle) return false;
    const { top, bottom } = heroCircle.getBoundingClientRect();
    return bottom > 0 && top < window.innerHeight;
  })();

  document.querySelectorAll<HTMLElement>('.availability-rail').forEach((rail) => {
    let entered = false;
    const enter = () => {
      if (entered) return;
      entered = true;
      const held = rail.getBoundingClientRect().bottom >= window.innerHeight - 1;
      rail.dataset.in = held ? 'rise' : 'settle';
    };
    if (!heroOnScreen || !heroCircle || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      enter();
      return;
    }
    document.addEventListener('hero:drawn', () => window.setTimeout(enter, ENTER_AFTER_SCRIBBLE), { once: true });
    const heroGone = new IntersectionObserver(([entry]) => {
      // The showreel's loader slides the page in from above: the hero is
      // briefly off screen then, but it's arriving, not gone
      if (!entry.isIntersecting && !document.documentElement.hasAttribute('data-intro')) {
        heroGone.disconnect();
        enter();
      }
    });
    heroGone.observe(heroCircle);
    // Never later than this, in case the scribble doesn't play; counted
    // from when the showreel's intro has settled, if it's playing
    const fallback = () => window.setTimeout(enter, ENTER_AT_MOST);
    if (document.documentElement.hasAttribute('data-intro')) document.addEventListener('intro:done', fallback, { once: true });
    else fallback();
  });

  document.querySelectorAll<HTMLButtonElement>('.availability').forEach((button) => {
    const status = button.parentElement?.querySelector('[data-availability-status]');
    const email = button.dataset.email ?? '';
    let release: number | undefined;
    let relabel: number | undefined;
    let copiedAt = 0;
    let lastPointer = '';
    button.addEventListener('pointerdown', (event) => {
      lastPointer = event.pointerType;
    });

    // Two flags: data-held keeps the pill open without hover, data-copied
    // swaps the label. Releasing drops the hold first and resets the label
    // once the pill has closed, so the text doesn't change mid-exit.
    const releaseAfter = (delay: number) => {
      window.clearTimeout(release);
      release = window.setTimeout(() => {
        delete button.dataset.held;
        window.clearTimeout(relabel);
        relabel = window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = '';
        }, EXIT_TIME);
      }, delay);
    };

    // The fill is a circle centred on the dot. Its radius is set to reach the
    // far corner of the pill exactly, so it moves from the very first frame.
    const measure = () => {
      const dot = button.querySelector('.availability__dot');
      if (!dot) return;
      const pill = button.getBoundingClientRect();
      const d = dot.getBoundingClientRect();
      const cx = d.left + d.width / 2 - pill.left;
      const cy = d.top + d.height / 2 - pill.top;
      const r = Math.hypot(Math.max(cx, pill.width - cx), Math.max(cy, pill.height - cy));
      button.style.setProperty('--cover-r', `${Math.ceil(r)}px`);
    };
    new ResizeObserver(measure).observe(button);
    document.fonts?.ready.then(measure);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    button.addEventListener('click', async () => {
      // Press bounce: a quick dip, then a spring back with a little rebound.
      // Played on click so a fast tap gets the same feel as a held press.
      if (!reducedMotion.matches) {
        button.animate(
          [
            { scale: 0.94, offset: 0.14, easing: BOUNCE },
            { scale: 1 },
          ],
          { duration: 640, easing: 'linear' },
        );
      }

      if (!(await copy(email))) {
        // Nothing could copy: open the mail app instead
        window.location.href = `mailto:${email}`;
        return;
      }
      window.clearTimeout(relabel);
      button.dataset.copied = '';
      button.dataset.held = '';
      copiedAt = performance.now();
      if (status) status.textContent = 'Email address copied';
      // If a mouse has already left by the time the copy lands, don't hold
      const mouseGone = lastPointer === 'mouse' && !button.matches(':hover');
      releaseAfter(mouseGone ? COPIED_MIN : COPIED_FOR);
    });

    // A mouse leaving takes the pill with it, once "Copied" has had a moment
    button.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse' || !('held' in button.dataset)) return;
      releaseAfter(Math.max(0, copiedAt + COPIED_MIN - performance.now()));
    });
  });
</script>

<style>
  /* Zero-height sticky rail at the end of the scrolling content. It holds the
     pill to the bottom of the viewport until the footer arrives, then stays
     put so the footer takes over. */
  .availability-rail {
    position: sticky;
    bottom: 0;
    z-index: 10;
    height: 0;
  }

  /* Whatever the rail parks in is clipped to its own box, so the pill never
     draws over the footer below it, even mid-entrance. clip (unlike hidden)
     isn't a scroll container, so the rail still sticks. */
  :global(:has(> .availability-rail)) {
    overflow: clip;
  }

  /* Entrance (timed by the script): hidden until the hero's scribble is
     done, then rises in from below the fold on the soft spring */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .availability-rail:not([data-in]) {
      visibility: hidden;
      opacity: 0;
    }

    .availability-rail[data-in='rise'] {
      animation:
        availability-rise 800ms var(--ease-spring) both,
        availability-fade 240ms var(--ease-out) both;
    }

    .availability-rail[data-in='settle'] {
      animation:
        availability-settle 600ms var(--ease-spring) both,
        availability-fade 240ms var(--ease-out) both;
    }
  }

  /* Parked above the footer: a short way up into place, so it never passes
     over the footer below it */
  @keyframes availability-settle {
    from {
      translate: 0 0.4em;
    }
  }

  @keyframes availability-rise {
    from {
      translate: 0 calc(100% + 1.5 * var(--page-gutter) + 3em);
    }
  }

  @keyframes availability-fade {
    from {
      opacity: 0;
    }
  }

  .availability {
    --bloom: cubic-bezier(0.32, 0.72, 0, 1);
    --settle: cubic-bezier(0.25, 0.8, 0.3, 1);
    --accelerate: cubic-bezier(0.4, 0, 1, 1);
    /* Dot centre, measured from the pill's right edge */
    --dot-x: calc(var(--space-m) + 6px);

    position: absolute;
    right: var(--page-gutter);
    bottom: var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    /* 200 × 56 at 33px type. Figma strokes sit inside the box, so the
       border is taken out of the padding. */
    min-width: 6.06em;
    padding: calc(var(--space-xs) - var(--border-width)) calc(var(--space-m) - var(--border-width));
    overflow: hidden;
    isolation: isolate;
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-l);
    background-color: var(--neutral-000);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--h3-size);
    line-height: var(--h3-lh);
    white-space: nowrap;
    cursor: pointer;
    /* Leaving: border fades back in step with the retreating fill */
    transition:
      border-color 300ms var(--settle) 60ms,
      scale 620ms var(--ease-bounce);
  }

  /* Neon fill: a circle clipped out of a full-size layer, centred on the dot.
     At rest it's exactly the dot; on hover it grows to the far corner. */
  .availability__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--brand-neon);
    clip-path: circle(6px at calc(100% - var(--dot-x)) 50%);
    /* Leaving: starts straight away and eases softly into the dot */
    transition: clip-path 380ms var(--settle) 60ms;
  }

  .availability__dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--brand-neon);
    box-shadow: inset 0 0 0 var(--border-width) var(--brand-neon-edge);
    /* Leaving: the edge only returns once the fill has landed */
    transition: box-shadow 160ms var(--ease-out) 360ms;
  }

  .availability__rest,
  .availability__hover {
    transition-property: transform, opacity, filter;
  }

  /* Leaving: "Open to work" comes back down once the hover label has cleared */
  .availability__rest {
    transition-duration: 340ms, 220ms, 220ms;
    transition-timing-function: var(--settle);
    transition-delay: 110ms;
  }

  .availability__hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(55%);
    filter: blur(2px);
    /* Leaving: slips back down, quick and quiet */
    transition-duration: 140ms;
    transition-timing-function: var(--accelerate);
  }

  /* "Copy email" and "Copied" share a cell and swap vertically */
  .availability__action,
  .availability__done {
    grid-area: 1 / 1;
    transition:
      transform 420ms var(--ease-spring),
      opacity 180ms var(--ease-out);
  }

  .availability__done {
    opacity: 0;
    transform: translateY(60%);
  }

  .availability[data-copied] .availability__action {
    opacity: 0;
    transform: translateY(-60%);
  }

  .availability[data-copied] .availability__done {
    opacity: 1;
    transform: none;
  }

  /* Held after a copy: keeps the filled state without hover (on touch screens
     this is the only time it shows), then plays the leave sequence */
  .availability[data-held] {
    border-color: var(--brand-neon-edge);
  }

  .availability[data-held] .availability__fill {
    clip-path: circle(var(--cover-r, 125%) at calc(100% - var(--dot-x)) 50%);
    transition: clip-path 460ms var(--bloom);
  }

  .availability[data-held] .availability__dot {
    box-shadow: inset 0 0 0 var(--border-width) transparent;
    transition: box-shadow 120ms var(--ease-out);
  }

  .availability[data-held] .availability__rest {
    opacity: 0;
    transform: translateY(-55%);
    filter: blur(2px);
    transition-duration: 200ms;
    transition-timing-function: var(--accelerate);
    transition-delay: 0ms;
  }

  .availability[data-held] .availability__hover {
    opacity: 1;
    transform: none;
    filter: none;
    transition-duration: 560ms, 240ms, 240ms;
    transition-timing-function: var(--ease-spring), var(--ease-out), var(--ease-out);
    transition-delay: 90ms;
  }

  @media (hover: hover) {
    .availability:hover,
    .availability:focus-visible {
      border-color: var(--brand-neon-edge);
      transition:
        border-color 240ms var(--ease-out),
        scale 620ms var(--ease-bounce);
    }

    /* Arriving: the dot blooms into the fill */
    .availability:hover .availability__fill,
    .availability:focus-visible .availability__fill {
      clip-path: circle(var(--cover-r, 125%) at calc(100% - var(--dot-x)) 50%);
      transition: clip-path 460ms var(--bloom);
    }

    .availability:hover .availability__dot,
    .availability:focus-visible .availability__dot {
      box-shadow: inset 0 0 0 var(--border-width) transparent;
      transition: box-shadow 120ms var(--ease-out);
    }

    /* "Open to work" accelerates up and away, with a touch of motion blur */
    .availability:hover .availability__rest,
    .availability:focus-visible .availability__rest {
      opacity: 0;
      transform: translateY(-55%);
      filter: blur(2px);
      transition-duration: 200ms;
      transition-timing-function: var(--accelerate);
      transition-delay: 0ms;
    }

    /* "Copy email" follows just behind on a soft spring */
    .availability:hover .availability__hover,
    .availability:focus-visible .availability__hover {
      opacity: 1;
      transform: none;
      filter: none;
      transition-duration: 560ms, 240ms, 240ms;
      transition-timing-function: var(--ease-spring), var(--ease-out), var(--ease-out);
      transition-delay: 90ms;
    }
  }

  /* Press: dips quickly, then releases on the bouncy spring */
  .availability:active {
    scale: 0.94;
    transition:
      border-color 240ms var(--ease-out),
      scale 90ms var(--ease-out);
  }

  .availability:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .availability,
    .availability:active {
      scale: none;
    }

    .availability *,
    .availability *::before {
      transform: none !important;
      filter: none !important;
    }

    .availability__fill {
      clip-path: none;
      opacity: 0;
      transition: opacity 200ms linear;
    }

    .availability:hover .availability__fill,
    .availability:focus-visible .availability__fill {
      clip-path: none;
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .availability {
      --dot-x: calc(var(--space-s) + 6px);
      font-size: var(--body-size);
      line-height: var(--body-lh);
      padding-inline: calc(var(--space-s) - var(--border-width));
    }
  }
</style>
