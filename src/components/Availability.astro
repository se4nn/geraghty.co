---
import sg from '../assets/logos/sg.svg';

interface Props {
  label: string;
  email: string;
}

const { label, email } = Astro.props;
---

<div data-availability-end></div>
<div class="availability-rail mark">
  <a class="availability-mark" href="/" aria-label="Sean Geraghty, home">
    <img src={sg.src} width="32" height="32" alt="" />
  </a>
</div>
<div class="availability-rail">
  <button
    class="availability t-h3"
    type="button"
    data-email={email}
    aria-label={`${label}. Copy email address ${email}`}
  >
    <span class="fill" aria-hidden="true"></span>
    <span class="rest" aria-hidden="true">{label}</span>
    <span class="dot" aria-hidden="true"></span>
    <span class="hover" aria-hidden="true">
      <span class="action">Copy email</span>
      <span class="done">Copied</span>
    </span>
  </button>
  <span class="visually-hidden" role="status" aria-live="polite" data-availability-status></span>
</div>

<script>
  import { reducedMotion, token } from '../scripts/arrival';

  // Copy

  const COPIED_FOR = 1800;
  const COPIED_MIN = 500;
  const EXIT_TIME = 460;
  const BOUNCE = token('--ease-bounce', 'ease-out');

  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.cssText = 'position: fixed; opacity: 0; pointer-events: none;';
      document.body.append(field);
      field.select();
      const copied = document.execCommand('copy');
      field.remove();
      return copied;
    }
  }

  // Entrance

  const root = document.documentElement;
  const rails = document.querySelectorAll<HTMLElement>('.availability-rail');
  const loading = () => root.hasAttribute('data-intro') && root.dataset.intro !== 'settling';

  if (loading()) {
    const intro = new MutationObserver(() => {
      if (loading()) return;
      intro.disconnect();
      rails.forEach((rail) => (rail.dataset.in = 'rise'));
    });
    intro.observe(root, { attributeFilter: ['data-intro'] });
  } else {
    rails.forEach((rail) => {
      const held = rail.getBoundingClientRect().bottom >= window.innerHeight - 1;
      rail.dataset.in = held ? 'rise' : 'settle';
    });
  }

  // Phones

  const phone = window.matchMedia('(max-width: 700px)');
  const end = document.querySelector<HTMLElement>('[data-availability-end]');
  const NUDGE = 8;
  const BACK_AFTER_STOP = 800;
  let lastY = window.scrollY;
  let frame = 0;
  let stopped: number | undefined;

  const away = (on: boolean) => rails.forEach((rail) => rail.toggleAttribute('data-away', on));
  const parked = () => !end || end.getBoundingClientRect().top < window.innerHeight;
  const holding = () => Boolean(document.querySelector('.availability[data-held]'));

  const update = () => {
    frame = 0;
    const y = window.scrollY;
    const dy = y - lastY;
    if (y <= NUDGE || Math.abs(dy) > window.innerHeight || parked() || holding()) {
      away(false);
      lastY = y;
    } else if (Math.abs(dy) >= NUDGE) {
      away(dy > 0);
      lastY = y;
    }
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!phone.matches) return;
      if (!frame) frame = requestAnimationFrame(update);
      window.clearTimeout(stopped);
      stopped = window.setTimeout(() => away(false), BACK_AFTER_STOP);
    },
    { passive: true },
  );
  phone.addEventListener('change', () => {
    away(false);
    lastY = window.scrollY;
  });

  // Pill

  document.querySelectorAll<HTMLButtonElement>('.availability').forEach((button) => {
    const status = button.parentElement?.querySelector('[data-availability-status]');
    const email = button.dataset.email ?? '';
    let release: number | undefined;
    let relabel: number | undefined;
    let copiedAt = 0;
    let lastPointer = '';
    button.addEventListener('pointerdown', (event) => {
      lastPointer = event.pointerType;
    });

    const releaseAfter = (delay: number) => {
      window.clearTimeout(release);
      release = window.setTimeout(() => {
        delete button.dataset.held;
        window.clearTimeout(relabel);
        relabel = window.setTimeout(() => {
          delete button.dataset.copied;
          if (status) status.textContent = '';
        }, EXIT_TIME);
      }, delay);
    };

    const measure = () => {
      const dot = button.querySelector('.dot');
      if (!dot) return;
      const pill = button.getBoundingClientRect();
      const d = dot.getBoundingClientRect();
      const cx = d.left + d.width / 2 - pill.left;
      const cy = d.top + d.height / 2 - pill.top;
      const r = Math.hypot(Math.max(cx, pill.width - cx), Math.max(cy, pill.height - cy));
      button.style.setProperty('--cover-r', `${Math.ceil(r)}px`);
    };
    new ResizeObserver(measure).observe(button);
    document.fonts?.ready.then(measure);

    button.addEventListener('click', async () => {
      if (!reducedMotion.matches) {
        button.animate(
          [
            { scale: 0.94, offset: 0.14, easing: BOUNCE },
            { scale: 1 },
          ],
          { duration: 640, easing: 'linear' },
        );
      }

      if (!(await copy(email))) {
        window.location.href = `mailto:${email}`;
        return;
      }
      window.clearTimeout(relabel);
      button.dataset.copied = '';
      button.dataset.held = '';
      copiedAt = performance.now();
      if (status) status.textContent = 'Email address copied';
      const mouseGone = lastPointer === 'mouse' && !button.matches(':hover');
      releaseAfter(mouseGone ? COPIED_MIN : COPIED_FOR);
    });

    button.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse' || !('held' in button.dataset)) return;
      releaseAfter(Math.max(0, copiedAt + COPIED_MIN - performance.now()));
    });
  });
</script>

<style>
  /* Rails */

  .availability-rail {
    --below: calc(1.5 * var(--page-gutter) + 3em);

    position: sticky;
    bottom: 0;
    z-index: 10;
    height: 0;
  }

  :global(:has(> .availability-rail)) {
    overflow: clip;
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .availability-rail:not([data-in]) {
      visibility: hidden;
      opacity: 0;
    }

    .availability-rail[data-in='rise'] {
      animation:
        availability-rise var(--duration-page) var(--ease-in-out) both,
        availability-fade 240ms var(--ease-out) both;
    }

    .availability-rail[data-in='settle'] {
      animation:
        availability-settle var(--duration-page) var(--ease-in-out) both,
        availability-fade 240ms var(--ease-out) both;
    }
  }

  @keyframes availability-settle {
    from {
      translate: 0 0.4em;
    }
  }

  @keyframes availability-rise {
    from {
      translate: 0 calc(var(--below) + var(--intro-shift, 0px));
    }
  }

  @media (max-width: 700px) and (prefers-reduced-motion: no-preference) {
    .availability-rail {
      transition: transform var(--duration-l) var(--ease-out);
    }

    .availability-rail[data-away]:not(:has(:focus-visible)) {
      transform: translateY(var(--below));
      transition-duration: var(--duration-s);
    }

    .availability-rail:has(:focus-visible) {
      transition: none;
    }
  }

  @keyframes availability-fade {
    from {
      opacity: 0;
    }
  }

  /* SG Mark */

  .availability-mark {
    position: absolute;
    left: var(--page-gutter);
    bottom: var(--page-gutter);
    display: grid;
    place-items: center;
    height: calc(var(--h3-size) * var(--h3-lh) + 2 * var(--space-xs));
    aspect-ratio: 1;
    transition: opacity var(--duration-s) var(--ease-out);
  }

  .availability-rail.mark {
    mix-blend-mode: difference;
  }

  .availability-mark img {
    display: block;
    width: 32px;
    height: 32px;
    filter: brightness(0) invert(1);
  }

  @media (hover: hover) {
    .availability-mark:hover {
      opacity: 0.6;
    }
  }

  .availability-mark:focus-visible {
    outline: 2px solid var(--brand-neon-edge);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }

  /* Pill */

  .availability {
    --bloom: cubic-bezier(0.32, 0.72, 0, 1);
    --settle: cubic-bezier(0.25, 0.8, 0.3, 1);
    --accelerate: cubic-bezier(0.4, 0, 1, 1);
    --dot-x: calc(var(--space-m) + 6px);

    position: absolute;
    right: var(--page-gutter);
    bottom: var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    min-width: 6.06em;
    padding: calc(var(--space-xs) - var(--border-width)) calc(var(--space-m) - var(--border-width));
    overflow: hidden;
    isolation: isolate;
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-l);
    background-color: var(--neutral-000);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--h3-size);
    line-height: var(--h3-lh);
    white-space: nowrap;
    cursor: pointer;
    transition:
      border-color 300ms var(--settle) 60ms,
      scale 620ms var(--ease-bounce);
  }

  .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--brand-neon);
    clip-path: circle(6px at calc(100% - var(--dot-x)) 50%);
    transition: clip-path 380ms var(--settle) 60ms;
  }

  .dot {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--brand-neon);
    box-shadow: inset 0 0 0 var(--border-width) var(--brand-neon-edge);
    transition: box-shadow 160ms var(--ease-out) 360ms;
  }

  .rest,
  .hover {
    transition-property: transform, opacity, filter;
  }

  .rest {
    transition-duration: 340ms, 220ms, 220ms;
    transition-timing-function: var(--settle);
    transition-delay: 110ms;
  }

  .hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(55%);
    filter: blur(2px);
    transition-duration: 140ms;
    transition-timing-function: var(--accelerate);
  }

  .action,
  .done {
    grid-area: 1 / 1;
    transition:
      transform 420ms var(--ease-spring),
      opacity 180ms var(--ease-out);
  }

  .done {
    opacity: 0;
    transform: translateY(60%);
  }

  .availability[data-copied] .action {
    opacity: 0;
    transform: translateY(-60%);
  }

  .availability[data-copied] .done {
    opacity: 1;
    transform: none;
  }

  .availability[data-held] {
    border-color: var(--brand-neon-edge);
  }

  .availability[data-held] .fill {
    clip-path: circle(var(--cover-r, 125%) at calc(100% - var(--dot-x)) 50%);
    transition: clip-path 460ms var(--bloom);
  }

  .availability[data-held] .dot {
    box-shadow: inset 0 0 0 var(--border-width) transparent;
    transition: box-shadow 120ms var(--ease-out);
  }

  .availability[data-held] .rest {
    opacity: 0;
    transform: translateY(-55%);
    filter: blur(2px);
    transition-duration: 200ms;
    transition-timing-function: var(--accelerate);
    transition-delay: 0ms;
  }

  .availability[data-held] .hover {
    opacity: 1;
    transform: none;
    filter: none;
    transition-duration: 560ms, 240ms, 240ms;
    transition-timing-function: var(--ease-spring), var(--ease-out), var(--ease-out);
    transition-delay: 90ms;
  }

  /* Hover */

  @media (hover: hover) {
    .availability:hover,
    .availability:focus-visible {
      border-color: var(--brand-neon-edge);
      transition:
        border-color 240ms var(--ease-out),
        scale 620ms var(--ease-bounce);
    }

    .availability:hover .fill,
    .availability:focus-visible .fill {
      clip-path: circle(var(--cover-r, 125%) at calc(100% - var(--dot-x)) 50%);
      transition: clip-path 460ms var(--bloom);
    }

    .availability:hover .dot,
    .availability:focus-visible .dot {
      box-shadow: inset 0 0 0 var(--border-width) transparent;
      transition: box-shadow 120ms var(--ease-out);
    }

    .availability:hover .rest,
    .availability:focus-visible .rest {
      opacity: 0;
      transform: translateY(-55%);
      filter: blur(2px);
      transition-duration: 200ms;
      transition-timing-function: var(--accelerate);
      transition-delay: 0ms;
    }

    .availability:hover .hover,
    .availability:focus-visible .hover {
      opacity: 1;
      transform: none;
      filter: none;
      transition-duration: 560ms, 240ms, 240ms;
      transition-timing-function: var(--ease-spring), var(--ease-out), var(--ease-out);
      transition-delay: 90ms;
    }
  }

  /* Press */

  .availability:active {
    scale: 0.94;
    transition:
      border-color 240ms var(--ease-out),
      scale 90ms var(--ease-out);
  }

  .availability:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .availability,
    .availability:active {
      scale: none;
    }

    .availability *,
    .availability *::before {
      transform: none !important;
      filter: none !important;
    }

    .fill {
      clip-path: none;
      opacity: 0;
      transition: opacity 200ms linear;
    }

    .availability:hover .fill,
    .availability:focus-visible .fill {
      clip-path: none;
      opacity: 1;
    }
  }

  @media (max-width: 700px) {
    .availability {
      --dot-x: calc(var(--space-s) + 6px);
      padding-inline: calc(var(--space-s) - var(--border-width));
    }
  }
</style>
