---
// Project thumbnail: gradient artwork (live LensFlare, or a still with a
// grain overlay) and a centred logo. Shared by the work grid tiles, the
// skill chip hover card and the case study hero. Size and shape come from
// the parent; this fills whatever box it's given.
//
// transitionName ties the art and logo to the same project elsewhere, so a
// homepage tile morphs into its case study hero (view transitions). Give it
// to one TileArt per project per page only: the hover card leaves it off.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import grain from '../assets/work/grain.jpg';
import LensFlare from './LensFlare.astro';

interface Props {
  image: ImageMetadata;
  logo: ImageMetadata;
  // Logo width as a share of the thumbnail width
  logoScale: number;
  grain?: boolean;
  // Off where many thumbnails share a page (each live gradient is a WebGL
  // canvas, and browsers cap how many can run): the still and grain show
  live?: boolean;
  // Live gradient over the still, from the project's front matter
  gradient?: {
    from: string;
    to: string;
    seed: number;
    darkness?: number;
    fringe: 'auto' | 'warm' | 'cool';
    dither: 'grain' | 'crt';
  };
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  transitionName?: string;
  class?: string;
}

const {
  image,
  logo,
  logoScale,
  grain: showGrain = true,
  live = true,
  gradient: projectGradient,
  alt,
  sizes,
  widths = [480, 820, 1640],
  eager = false,
  transitionName,
  class: className,
} = Astro.props;
const gradient = live ? projectGradient : undefined;
const grainImage = await getImage({ src: grain, width: 2000, format: 'webp', quality: 70 });
const loading = eager ? 'eager' : 'lazy';
---

<div
  class:list={['tile-art', className]}
  style={[
    `--logo-scale: ${logoScale};`,
    transitionName && `view-transition-name: art-${transitionName}; view-transition-class: art;`,
  ]
    .filter(Boolean)
    .join(' ')}
>
  {
    gradient ? (
      <LensFlare
        class="tile-art__image"
        from={gradient.from}
        to={gradient.to}
        seed={gradient.seed}
        darkness={gradient.darkness}
        fringe={gradient.fringe}
        dither={gradient.dither}
      >
        <Image
          class="tile-art__poster"
          src={image}
          alt=""
          widths={widths}
          sizes={sizes}
          loading={loading}
          fetchpriority={eager ? 'high' : undefined}
        />
      </LensFlare>
    ) : (
      <Image
        class="tile-art__image"
        src={image}
        alt=""
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={eager ? 'high' : undefined}
      />
    )
  }
  {showGrain && !gradient && <img class="tile-art__grain" src={grainImage.src} alt="" loading={loading} />}
  <img
    class="tile-art__logo"
    src={logo.src}
    alt={alt}
    width={logo.width}
    height={logo.height}
    style={transitionName ? `view-transition-name: logo-${transitionName}; view-transition-class: logo;` : undefined}
  />
</div>

<style>
  .tile-art {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-s);
    isolation: isolate;
  }

  .tile-art__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Still under the live gradient, shown until it's ready */
  .tile-art__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Grain from Figma: oversized and offset, colour-dodged at half strength */
  .tile-art__grain {
    position: absolute;
    top: -56.59%;
    left: -109.88%;
    width: 319.75%;
    height: 213.17%;
    max-width: none;
    mix-blend-mode: color-dodge;
    opacity: 0.5;
    pointer-events: none;
  }

  .tile-art__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--logo-scale) * 100%);
    height: auto;
    transform: translate(-50%, -50%);
  }
</style>
