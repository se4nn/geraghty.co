---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import grain from '../assets/work/grain.jpg';
import LensFlare from './LensFlare.astro';

interface Props {
  image: ImageMetadata;
  logo: ImageMetadata;
  logoScale: number;
  grain?: boolean;
  live?: boolean;
  gradient?: {
    from: string;
    to: string;
    seed: number;
    darkness?: number;
    fringe: 'auto' | 'warm' | 'cool';
    dither: 'grain' | 'crt';
  };
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  transitionName?: string;
  showLogo?: boolean;
  class?: string;
}

const {
  image,
  logo,
  logoScale,
  grain: showGrain = true,
  live = true,
  gradient: projectGradient,
  alt,
  sizes,
  widths = [480, 820, 1640],
  eager = false,
  transitionName,
  showLogo = true,
  class: className,
} = Astro.props;
const gradient = live ? projectGradient : undefined;
const grainImage = await getImage({ src: grain, width: 2000, format: 'webp', quality: 70 });
const loading = eager ? 'eager' : 'lazy';
---

<div
  class:list={['tile-art', className]}
  style={[
    `--logo-scale: ${logoScale};`,
    transitionName && `view-transition-name: art-${transitionName}; view-transition-class: art;`,
  ]
    .filter(Boolean)
    .join(' ')}
>
  {
    gradient ? (
      <LensFlare
        class="image"
        from={gradient.from}
        to={gradient.to}
        seed={gradient.seed}
        darkness={gradient.darkness}
        fringe={gradient.fringe}
        dither={gradient.dither}
      >
        <Image
          class="poster"
          src={image}
          alt=""
          widths={widths}
          sizes={sizes}
          quality={90}
          loading={loading}
          fetchpriority={eager ? 'high' : undefined}
        />
      </LensFlare>
    ) : (
      <Image
        class="image"
        src={image}
        alt=""
        widths={widths}
        sizes={sizes}
        quality={90}
        loading={loading}
        fetchpriority={eager ? 'high' : undefined}
      />
    )
  }
  {showGrain && !gradient && <img class="grain" src={grainImage.src} alt="" loading={loading} />}
  {
    showLogo && (
      <img
        class="logo"
        src={logo.src}
        alt={alt}
        width={logo.width}
        height={logo.height}
        style={transitionName ? `view-transition-name: logo-${transitionName}; view-transition-class: logo;` : undefined}
      />
    )
  }
</div>

<style>
  .tile-art {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-s);
    isolation: isolate;
  }

  .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grain {
    position: absolute;
    top: -56.59%;
    left: -109.88%;
    width: 319.75%;
    height: 213.17%;
    max-width: none;
    mix-blend-mode: color-dodge;
    opacity: 0.5;
    pointer-events: none;
  }

  .logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--logo-scale) * 100%);
    height: auto;
    transform: translate(-50%, -50%);
  }
</style>
