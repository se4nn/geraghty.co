---
// Project thumbnail: gradient artwork (live LensFlare, or a still with a
// grain overlay) and a centred logo.
// Shared by the work grid tiles and the skill chip hover card.
// Size and shape come from the parent; this fills whatever box it's given.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import grain from '../assets/work/grain.jpg';
import LensFlare from './LensFlare.astro';

interface Props {
  image: ImageMetadata;
  logo: ImageMetadata;
  // Logo width as a share of the thumbnail width
  logoScale: number;
  grain?: boolean;
  // Live gradient over the still, from the project's front matter
  gradient?: {
    from: string;
    to: string;
    seed: number;
    darkness?: number;
    fringe: 'auto' | 'warm' | 'cool';
  };
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
}

const {
  image,
  logo,
  logoScale,
  grain: showGrain = true,
  gradient,
  alt,
  sizes,
  widths = [480, 820, 1640],
  class: className,
} = Astro.props;
const grainImage = await getImage({ src: grain, width: 2000, format: 'webp', quality: 70 });
---

<div class:list={['tile-art', className]}>
  {
    gradient ? (
      <LensFlare
        class="tile-art__image"
        from={gradient.from}
        to={gradient.to}
        seed={gradient.seed}
        darkness={gradient.darkness}
        fringe={gradient.fringe}
      >
        <Image class="tile-art__poster" src={image} alt="" widths={widths} sizes={sizes} />
      </LensFlare>
    ) : (
      <Image class="tile-art__image" src={image} alt="" widths={widths} sizes={sizes} />
    )
  }
  {showGrain && !gradient && <img class="tile-art__grain" src={grainImage.src} alt="" loading="lazy" />}
  <img
    class="tile-art__logo"
    src={logo.src}
    alt={alt}
    width={logo.width}
    height={logo.height}
    style={`width: ${logoScale * 100}%;`}
  />
</div>

<style>
  .tile-art {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-s);
    isolation: isolate;
  }

  .tile-art__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-m) var(--ease-out);
  }

  /* Still under the live gradient, shown until it's ready */
  .tile-art__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Grain from Figma: oversized and offset, colour-dodged at half strength */
  .tile-art__grain {
    position: absolute;
    top: -56.59%;
    left: -109.88%;
    width: 319.75%;
    height: 213.17%;
    max-width: none;
    mix-blend-mode: color-dodge;
    opacity: 0.5;
    pointer-events: none;
  }

  .tile-art__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    height: auto;
    transform: translate(-50%, -50%);
  }
</style>
