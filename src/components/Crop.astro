---
// A Figma crop frame: a window sized to the grid with a larger image behind
// it, placed where the design puts it. Everything is measured in Figma px
// and scaled by --s, the window's width over its Figma width, so the crop
// holds at every size.
//
// window: the frame's Figma size [w, h]
// src + rect: the image behind and its box [x, y, w, h] relative to the
//   window (the export's full bounds, shadows included)
// bleed: let the image run past the window (the section clips at the page)
// min: smallest scale, in px per Figma px. On narrow screens the window
//   stops shrinking the art and crops in instead, from the left edge
// focus: on phones, the Figma x to centre instead (the chart on the map)
// motion: how CropImages with from/to offsets move.
//   arrive: once, as the crop is first seen (words stay put, images arrive)
//   scroll: tied to scroll while the crop crosses the screen
// range, ease: the scroll range and easing (default: the whole crossing,
//   linear)
// caption: a line under the image (Body in Neutral 600, 24 below, starting
//   48 Figma px in, in line with the screen inside the panel). The crop
//   becomes a figure with a figcaption
// captionInset: that indent, in Figma px (default 48)
// More layers (CropImage, CropLink) can be slotted on top.
import type { ImageMetadata } from 'astro';
import CropImage from './CropImage.astro';

interface Props {
  window: [number, number];
  src?: ImageMetadata;
  rect?: [number, number, number, number];
  alt?: string;
  bg?: string;
  bleed?: boolean;
  min?: number;
  focus?: number;
  motion?: 'arrive' | 'scroll';
  range?: string;
  ease?: string;
  eager?: boolean;
  caption?: string;
  captionInset?: number;
  class?: string;
}

const {
  window: [w, h],
  src,
  rect,
  alt = '',
  bg,
  bleed = false,
  min = 0,
  focus,
  motion,
  range,
  ease,
  eager = false,
  caption,
  captionInset = 48,
  class: className,
} = Astro.props;
const Root = caption ? 'figure' : 'div';

const style = [
  `--w: ${w}`,
  `--h: ${h}`,
  `--s-min: ${min}px`,
  focus !== undefined && `--fx: ${focus}`,
  bg && `--crop-bg: ${bg}`,
  range && `--drift-range: ${range}`,
  ease && `--drift-ease: ${ease}`,
  caption && `--caption-inset: ${captionInset}`,
]
  .filter(Boolean)
  .join('; ');
---

<Root
  class:list={['crop', { 'crop--bleed': bleed, 'crop--focus': focus !== undefined }, motion && `crop--${motion}`, className]}
  style={style}
>
  <div class="crop__window">
    {src && rect && <CropImage src={src} rect={rect} window={w} alt={alt} eager={eager} />}
    <slot />
  </div>
  {caption && <figcaption class="crop__caption t-body">{caption}</figcaption>}
</Root>

<style>
  .crop {
    margin: 0;
    container-type: inline-size;
    /* 0: layers sit at their Figma x. 1: centred on --fx (phones only) */
    --anchor: 0;
  }

  @media (max-width: 700px) {
    .crop--focus {
      --anchor: 1;
    }
  }

  .crop__window {
    /* px per Figma px, read by every layer inside */
    --s: max(100cqi / var(--w), var(--s-min));
    position: relative;
    height: calc(var(--h) * var(--s));
    overflow: clip;
    border-radius: var(--radius-s);
    background-color: var(--crop-bg, transparent);
  }

  .crop__caption {
    margin-top: var(--space-l);
    padding-left: calc(var(--caption-inset) / var(--w) * 100cqi);
    color: var(--neutral-600);
  }

  .crop--bleed .crop__window {
    overflow: visible;
  }

  /* Motion. Images only, from the world of the page: phones set down or
     lifted into place, sticker rows sliding past like a sheet. Off with
     reduced motion, where everything simply sits in place. */
  @media (prefers-reduced-motion: no-preference) {
    /* Arrive: held at their start until the crop is seen, then settle on
       the long, soft out (no overshoot) */
    .crop--arrive[data-arrival='waiting'] :global(.crop-image--moves) {
      translate: calc(var(--from-x, 0) * var(--s)) calc(var(--from-y, 0) * var(--s));
    }

    .crop--arrive[data-arrival='arrived'] :global(.crop-image--moves) {
      transition: translate 1600ms var(--ease-out-expo) var(--delay, 0ms);
    }

    /* Scroll: start to end while the crop crosses the screen */
    @supports (animation-timeline: view()) {
      .crop--scroll {
        view-timeline-name: --crop;
      }

      .crop--scroll :global(.crop-image--moves) {
        animation: crop-drift var(--drift-ease, linear) both;
        animation-timeline: --crop;
        animation-range: var(--drift-range, cover 0% cover 100%);
      }
    }
  }

  @keyframes crop-drift {
    from {
      translate: calc(var(--from-x, 0) * var(--s)) calc(var(--from-y, 0) * var(--s));
    }
    to {
      translate: calc(var(--to-x, 0) * var(--s)) calc(var(--to-y, 0) * var(--s));
    }
  }
</style>

<script>
  // Arrivals wait until the crop is seen; anything already on screen at
  // load stays put (src/scripts/arrival.ts)
  import { whenSeen, arrive } from '../scripts/arrival';

  for (const crop of document.querySelectorAll<HTMLElement>('.crop--arrive')) {
    whenSeen(crop, 0.25).then((seen) => {
      if (seen) arrive(crop);
    });
  }
</script>
