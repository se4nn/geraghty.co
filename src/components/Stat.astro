---
import Label from './Label.astro';

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
const hasNote = Astro.slots.has('default');
---

<div class="stat">
  <p class="figure">
    <span class="value t-h1">{value}</span>
    <span class="caption t-h3">{label}</span>
  </p>
  {hasNote && <Label><slot /></Label>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .figure {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .value {
    color: var(--text-strong);
  }

  .caption {
    color: var(--text-muted);
    text-wrap: balance;
  }
</style>
