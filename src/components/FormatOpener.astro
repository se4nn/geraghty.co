---
import { Image } from 'astro:assets';
import Pause from './Pause.astro';
import overview from '../assets/work/format/reports-overview.png';
import briefLong from '../assets/work/format/opener/brief-long.png';
import briefNav from '../assets/work/format/opener/brief-nav.png';
import personCard from '../assets/work/format/wall/popup-person.png';
import companyCard from '../assets/work/format/wall/popup-company.png';
import company from '../assets/work/format/company-page.png';

interface Props {
  alt: string;
}
const { alt } = Astro.props;

const sizes = 'calc(0.7785 * min(100vw - 32px, 1416px))';
const widths = [1102, 1653, 2204, 3024];
---

<div class="format-opener">
  <div class="window" role="img" aria-label={alt}>
    <div class="screen">
      <Image class="page" data-page="overview" src={overview} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="high" data-shown style="z-index: 1" />

      <div class="page scroll" data-page="brief">
        <Image class="long" src={briefLong} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="low" />
        <Image class="nav" src={briefNav} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="low" />
      </div>

      <Image class="page overlay" data-page="person" src={personCard} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="low" />
      <Image class="page overlay" data-page="company-card" src={companyCard} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="low" />
      <Image class="page" data-page="company" src={company} alt="" widths={widths} sizes={sizes} quality={90} loading="eager" fetchpriority="low" />
    </div>

    <div class="cursor" aria-hidden="true">
      <span class="ring" />
      <svg class="arrow" viewBox="0 0 24 24">
        <path d="M5 2.5v17.2l4.6-4.4 2.9 6.5 2.7-1.2-2.9-6.4h6.3z" fill="#111" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
      </svg>
      <svg class="hand" viewBox="0 0 24 24">
        <path d="M9 2.5c-.8 0-1.5.7-1.5 1.5v8.3l-1.3-1.3a1.55 1.55 0 0 0-2.2 0 1.5 1.5 0 0 0 0 2.1l4.6 5.2c.9 1 2.1 1.6 3.4 1.6h3c2.2 0 4-1.8 4-4v-4.6a1.5 1.5 0 0 0-3 0v-1a1.5 1.5 0 0 0-3 0v-.6a1.5 1.5 0 0 0-3-.2V4c0-.8-.7-1.5-1.5-1.5z" fill="#fff" stroke="#111" stroke-width="1.3" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
  <Pause />
</div>

<style>
  .format-opener {
    position: relative;
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .window {
    --u: calc(100cqw / 1416);
    position: relative;
    aspect-ratio: 1416 / 812;
  }

  /* Screen */

  .screen {
    --k: 0.7291;
    position: absolute;
    left: calc(156.8 * var(--u));
    top: calc(48 * var(--u));
    width: calc(1512 * var(--k) * var(--u));
    height: calc(982 * var(--k) * var(--u));
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(12 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.06),
      0 calc(12 * var(--u)) calc(40 * var(--u)) oklch(0% 0 0 / 0.1);
  }

  .page {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: auto;
    max-width: none;
    visibility: hidden;
  }

  .page[data-shown] {
    visibility: visible;
  }

  .page.scroll {
    height: 100%;
    overflow: hidden;
    background-color: var(--neutral-000);
  }

  .long {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    transform: translateY(calc(var(--scroll, 0) * -1 * var(--k) * var(--u)));
  }

  .nav {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* Cursor */

  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: none;
    transform: translate(calc(var(--cx, 1150) * var(--u)), calc(var(--cy, 560) * var(--u)));
    filter: drop-shadow(0 calc(2 * var(--u)) calc(3 * var(--u)) oklch(0% 0 0 / 0.25));
  }

  .cursor svg {
    position: absolute;
    width: calc(26 * var(--u));
    max-width: none;
    height: calc(26 * var(--u));
    transform-origin: top left;
  }

  .arrow {
    left: calc(-5.4 * var(--u));
    top: calc(-2.7 * var(--u));
  }

  .hand {
    left: calc(-9.75 * var(--u));
    top: calc(-2.7 * var(--u));
    visibility: hidden;
  }

  .format-opener[data-hand] .arrow {
    visibility: hidden;
  }

  .format-opener[data-hand] .hand {
    visibility: visible;
  }

  .ring {
    position: absolute;
    left: calc(-19 * var(--u));
    top: calc(-19 * var(--u));
    width: calc(38 * var(--u));
    height: calc(38 * var(--u));
    border-radius: 50%;
    background-color: oklch(from var(--format-cyan-500) l c h / 0.35);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .format-opener[data-live] .cursor {
      display: block;
      transition: transform var(--move, 900ms) cubic-bezier(0.45, 0, 0.2, 1);
    }

    .long {
      transition: transform 3400ms cubic-bezier(0.45, 0, 0.25, 1);
    }

    .cursor svg {
      transition: scale 120ms var(--ease-out);
    }

    .format-opener[data-pressing] .cursor svg {
      scale: 0.86;
    }

    .format-opener[data-pressing] .ring {
      animation: format-opener-click 520ms var(--ease-out);
    }

    .page[data-arriving] {
      animation: format-opener-lift 720ms var(--ease-spring) both;
    }

    .page.overlay[data-arriving] {
      animation: format-opener-appear 200ms var(--ease-out) both;
    }
  }

  @keyframes format-opener-lift {
    from {
      transform: translateY(calc(48 * var(--u)));
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
  }

  @keyframes format-opener-appear {
    from {
      opacity: 0;
    }
  }

  @keyframes format-opener-click {
    0% {
      opacity: 1;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  const K = 0.7291;
  const at = (x: number, y: number) => [156.8 + x * K, 48 + y * K] as const;
  const REST = [1150, 560] as const;
  const SCROLL = 3693;

  for (const opener of document.querySelectorAll<HTMLElement>('.format-opener')) {
    if (reducedMotion.matches) continue;
    const page = (name: string) => opener.querySelector<HTMLElement>(`[data-page="${name}"]`)!;
    const cursor = opener.querySelector<HTMLElement>('.cursor')!;
    const long = opener.querySelector<HTMLElement>('.long')!;
    let run = 0;
    let z = 1;

    const wait = (ms: number, id: number) =>
      new Promise<void>((resolve, reject) => setTimeout(() => (id === run ? resolve() : reject()), ms));

    const move = async ([x, y]: readonly [number, number], ms: number, id: number) => {
      cursor.style.setProperty('--move', `${ms}ms`);
      cursor.style.setProperty('--cx', String(x));
      cursor.style.setProperty('--cy', String(y));
      await wait(ms, id);
    };

    const hand = (on: boolean) => opener.toggleAttribute('data-hand', on);

    const press = async (id: number) => {
      opener.toggleAttribute('data-pressing', true);
      await wait(240, id);
      opener.removeAttribute('data-pressing');
    };

    const show = (name: string, keep: string[] = []) => {
      const el = page(name);
      el.style.zIndex = String(++z);
      el.toggleAttribute('data-shown', true);
      el.removeAttribute('data-arriving');
      void el.offsetWidth;
      el.toggleAttribute('data-arriving', true);
      setTimeout(() => {
        opener.querySelectorAll<HTMLElement>('.page').forEach((p) => {
          if (p !== el && !keep.includes(p.dataset.page!)) p.removeAttribute('data-shown');
        });
      }, 760);
    };

    const scrollTo = (y: number) => long.style.setProperty('--scroll', String(y));

    const loop = async (id: number) => {
      while (id === run) {
        await wait(900, id);
        await move(at(1000, 470), 1000, id);
        hand(true);
        await wait(350, id);
        await press(id);
        hand(false);

        long.style.transition = 'none';
        scrollTo(0);
        void long.offsetWidth;
        long.style.transition = '';
        show('brief');
        await move(at(760, 420), 700, id);
        await wait(500, id);
        scrollTo(SCROLL);
        await wait(3500, id);
        await move(at(339, 525), 800, id);
        hand(true);
        await wait(350, id);
        await press(id);

        show('person', ['brief']);
        hand(false);
        await wait(900, id);
        await move(at(493, 210), 700, id);
        hand(true);
        await wait(450, id);

        show('company-card', ['brief']);
        await wait(1100, id);
        await move(at(560, 237), 400, id);
        await wait(250, id);
        await press(id);
        hand(false);

        show('company');
        await wait(500, id);
        await move(REST, 1100, id);
        await wait(2400, id);
        show('overview');
        await wait(800, id);
      }
    };

    const ready = Promise.all([...opener.querySelectorAll('img')].map((img) => img.decode().catch(() => {})));

    const start = () => {
      const id = ++run;
      opener.toggleAttribute('data-live', true);
      ready.then(() => loop(id)).catch(() => {});
    };

    const stop = () => {
      run++;
      hand(false);
      opener.removeAttribute('data-pressing');
      z = 1;
      opener.querySelectorAll<HTMLElement>('.page').forEach((p) => {
        const first = p.dataset.page === 'overview';
        p.toggleAttribute('data-shown', first);
        p.removeAttribute('data-arriving');
        p.style.zIndex = first ? '1' : '';
      });
      cursor.style.setProperty('--move', '0ms');
      cursor.style.setProperty('--cx', String(REST[0]));
      cursor.style.setProperty('--cy', String(REST[1]));
    };

    let seen = false;
    let paused = false;
    const update = () => (seen && !paused ? start() : stop());
    opener.addEventListener('pausechange', (event) => {
      paused = (event as CustomEvent<boolean>).detail;
      update();
    });
    new IntersectionObserver(
      ([entry]) => {
        seen = entry.isIntersecting;
        update();
      },
      { threshold: 0.3 },
    ).observe(opener);
  }
</script>
