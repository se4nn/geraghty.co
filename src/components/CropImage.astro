---
// One image inside a Crop, placed by its Figma box [x, y, w, h] relative to
// the window. window is the Crop's Figma width, used to size the srcset.
//
// Motion (the Crop's `motion` says when it plays):
// from: where the image starts, as a Figma px offset [x, y] from its place
// to: where it ends up (default: its place). Scroll drifts use both.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  rect: [number, number, number, number];
  window?: number;
  alt?: string;
  eager?: boolean;
  from?: [number, number];
  to?: [number, number];
  // Arrivals: wait this long after the Crop arrives (ms)
  delay?: number;
}

const { src, rect, window = 1416, alt = '', eager = false, from, to, delay = 0 } = Astro.props;
const [x, y, w, h] = rect;

// Rendered width is the image's share of the window, the window at most the
// page's content width. Phones may hold it larger (Crop min), so ask for at
// least a phone screen's worth.
const share = +(w / window).toFixed(4);
const sizes = `max(${share} * min(100vw - 32px, 1416px), ${Math.min(share, 2.5) * 375}px)`;
const widths = [640, 1024, 1600, 2400, 3200, 4000].filter((n) => n < src.width);
widths.push(src.width);

const style = [
  `--x: ${x}; --y: ${y}; --iw: ${w}; --ih: ${h};`,
  from && `--from-x: ${from[0]}; --from-y: ${from[1]};`,
  to && `--to-x: ${to[0]}; --to-y: ${to[1]};`,
  delay && `--delay: ${delay}ms;`,
]
  .filter(Boolean)
  .join(' ');
---

<Image
  class:list={['crop-image', { 'crop-image--moves': from || to }]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  style={style}
/>

<style>
  .crop-image {
    position: absolute;
    left: calc((var(--x) - var(--fx, 0) * var(--anchor)) * var(--s) + 50cqi * var(--anchor));
    top: calc(var(--y) * var(--s));
    width: calc(var(--iw) * var(--s));
    height: calc(var(--ih) * var(--s));
    max-width: none;
  }
</style>
