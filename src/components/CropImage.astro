---
// One image inside a Crop, placed by its Figma box [x, y, w, h] relative to
// the window. window: the Crop's Figma width, for the srcset.
// from, to: Figma px offsets [x, y] from its place to start and end at (the
//   Crop's motion says when; to defaults to its place)
// frame: for flat UI exports. screen: rounded, a hairline and a soft shadow so
//   a light screen holds its edge on a light page. phone: the same in a dark
//   bezel (402-wide mobile frames)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  rect: [number, number, number, number];
  window?: number;
  alt?: string;
  eager?: boolean;
  from?: [number, number];
  to?: [number, number];
  // Arrivals: wait this long after the Crop arrives (ms)
  delay?: number;
  frame?: 'screen' | 'phone';
}

const { src, rect, window = 1416, alt = '', eager = false, from, to, delay = 0, frame } = Astro.props;
const [x, y, w, h] = rect;

// Above 700px the image is w / 1416 of the column. At 700 and below Pairs,
// Trios and ScreenRows stack and Crop min can hold it larger, so ask for at
// least a phone screen's worth.
const share = +(w / window).toFixed(4);
const columnShare = +(w / 1416).toFixed(4);
const sizes = `(max-width: 700px) max(${share} * (100vw - 32px), ${Math.round(Math.min(share, 2.5) * 375)}px), calc(${columnShare} * min(100vw - 32px, 1416px))`;
const widths = [640, 1024, 1600, 2400, 2880, 3200, 4000].filter((n) => n < src.width);
widths.push(src.width);
// Astro's default left text in slides and fine lines soft on Retina
const quality = 90;

const style = [
  `--x: ${x}; --y: ${y}; --iw: ${w}; --ih: ${h};`,
  from && `--from-x: ${from[0]}; --from-y: ${from[1]};`,
  to && `--to-x: ${to[0]}; --to-y: ${to[1]};`,
  delay && `--delay: ${delay}ms;`,
]
  .filter(Boolean)
  .join(' ');
---

<Image
  class:list={['crop-image', { 'crop-image--moves': from || to }, frame && `crop-image--${frame}`]}
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  style={style}
/>

<style>
  .crop-image {
    position: absolute;
    left: calc((var(--x) - var(--fx, 0) * var(--anchor)) * var(--s) + 50cqi * var(--anchor));
    top: calc(var(--y) * var(--s));
    width: calc(var(--iw) * var(--s));
    height: calc(var(--ih) * var(--s));
    max-width: none;
  }

  /* Sizes are Figma px, scaled with the crop */
  .crop-image--screen,
  .crop-image--phone {
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.06),
      0 calc(12 * var(--s)) calc(40 * var(--s)) oklch(0% 0 0 / 0.1);
  }

  .crop-image--screen {
    border-radius: calc(12 * var(--s));
  }

  .crop-image--phone {
    box-sizing: border-box;
    border: calc(10 * var(--s)) solid var(--neutral-1000);
    border-radius: calc(56 * var(--s));
    background-color: var(--neutral-1000);
  }
</style>
