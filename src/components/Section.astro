---
import Label from './Label.astro';

interface Props {
  title?: string;
  tag?: string;
}

const { title, tag } = Astro.props;
---

<section class:list={['section', { untitled: !title && !tag }]}>
  {title && <h2 class="title t-h1">{title}</h2>}
  {tag && <Label class="note">{tag}</Label>}
  <slot />
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .title {
    grid-column: 1 / span 3;
    grid-row: 1;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .section :global(.label.note) {
    grid-column: 5;
    grid-row: 1;
    justify-self: end;
    align-self: center;
  }

  .section > :global(.column) {
    grid-row: 2;
    grid-column: 2 / span 2;
  }

  .section > :global(.column + .column) {
    grid-column: 4 / span 2;
  }

  .section.untitled > :global(.column) {
    grid-row: 1;
  }

  /* Tablet */

  @media (max-width: 1100px) {
    .section {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-xl);
    }

    .title,
    .section :global(.label.note) {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .section :global(.label.note) {
      order: -1;
      justify-self: start;
    }

    .section > :global(.column),
    .section.untitled > :global(.column) {
      grid-row: auto;
      grid-column: 1;
    }

    .section > :global(.column + .column) {
      grid-column: 2;
    }
  }

  /* Phones */

  @media (max-width: 700px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-l);
    }

    .section > :global(.column),
    .section > :global(.column + .column) {
      grid-column: 1;
    }
  }
</style>
