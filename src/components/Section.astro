---
// Figma: a titled text block in a case study ("The Initial Plan",
// "Audience & Demographics"…). The title runs from the left edge; the copy
// sits in two Columns, grid columns 2–3 and 4–5. A tag (a Label) can sit
// at the far right of the title row.
import Label from './Label.astro';

interface Props {
  // Left off where a section carries on from the one above
  title?: string;
  tag?: string;
}

const { title, tag } = Astro.props;
---

<section class:list={['section', { 'section--untitled': !title && !tag }]}>
  {title && <h2 class="section__title t-h1">{title}</h2>}
  {tag && <Label class="section__tag">{tag}</Label>}
  <slot />
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .section__title {
    grid-column: 1 / span 3;
    grid-row: 1;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .section :global(.section__tag) {
    grid-column: 5;
    grid-row: 1;
    justify-self: end;
    align-self: center;
  }

  .section > :global(.column) {
    grid-row: 2;
    grid-column: 2 / span 2;
  }

  .section > :global(.column + .column) {
    grid-column: 4 / span 2;
  }

  /* No title: the columns take the first row */
  .section--untitled > :global(.column) {
    grid-row: 1;
  }

  /* Tablet: the tag above the title, both across, then the two columns
     side by side. Everything flows in order, so no empty rows. */
  @media (max-width: 1100px) {
    .section {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-xl);
    }

    .section__title,
    .section :global(.section__tag) {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .section :global(.section__tag) {
      order: -1;
      justify-self: start;
    }

    .section > :global(.column) {
      grid-row: auto;
      grid-column: 1;
    }

    .section > :global(.column + .column) {
      grid-column: 2;
    }
  }

  /* Phones: one column */
  @media (max-width: 700px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-l);
    }

    .section > :global(.column),
    .section > :global(.column + .column) {
      grid-column: 1;
    }
  }
</style>
