---
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';
import Bar from './Bar.astro';

export type TileShape = 'square' | 'tall';

interface Props {
  project: CollectionEntry<'work'>;
  shape: TileShape;
}

const { project, shape } = Astro.props;
const { title, tags, dates, tile, link } = project.data;
const Wrapper = link ? 'a' : 'div';
---

<Wrapper class:list={['tile', shape]} href={link}>
  <span id={`work-${project.id}`} class="anchor" aria-hidden="true"></span>
  <TileArt
    class="art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="(max-width: 700px) 100vw, 54vw"
    transitionName={project.id}
  />
  <Bar lead={tags} trail={dates} />
</Wrapper>

<style>
  .tile {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--text-strong);
  }

  .tile :global(.tile-art.art) {
    aspect-ratio: 1;
  }

  /* Anchor */

  .tile {
    position: relative;
  }

  .anchor {
    position: absolute;
    top: 50cqi;
    left: 0;
    scroll-margin-top: 50svh;
  }

  .tile.tall .anchor {
    top: calc((3 * var(--col) + 2 * var(--grid-gap)) / 2);
  }

  @media (max-width: 700px) {
    .anchor,
    .tile.tall .anchor {
      top: calc(50cqi * 812 / 1416);
    }
  }

  /* Shapes */

  .tile.tall :global(.tile-art.art) {
    aspect-ratio: auto;
    height: calc(3 * var(--col) + 2 * var(--grid-gap));
  }

  @media (max-width: 700px) {
    .tile :global(.tile-art.art),
    .tile.tall :global(.tile-art.art) {
      height: auto;
      aspect-ratio: 1416 / 812;
    }
  }

  /* Hover */

  .tile :global(.tile-art.art)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px oklch(from var(--neutral-1000) l c h / 0.2),
      inset 0 0 2.5em oklch(from var(--neutral-1000) l c h / 0.4);
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) {
    a.tile:hover :global(.tile-art.art) {
      border-radius: 9cqi;
    }

    a.tile:hover :global(.tile-art.art)::after {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile :global(.tile-art.art),
    .tile :global(.tile-art.art)::after {
      transition:
        border-radius var(--duration-m) var(--ease-out),
        opacity var(--duration-m) var(--ease-out);
    }

    a.tile:hover :global(.tile-art.art),
    a.tile:hover :global(.tile-art.art)::after {
      transition-duration: var(--duration-l);
    }
  }

  a.tile:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }
</style>
