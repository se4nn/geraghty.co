---
// Figma: "Project - X". Gradient artwork (live LensFlare, or a still with a
// grain overlay), centred logo, then a Bar with tags and dates underneath.
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';
import Bar from './Bar.astro';

export type TileShape = 'square' | 'tall';

interface Props {
  project: CollectionEntry<'work'>;
  shape: TileShape;
}

const { project, shape } = Astro.props;
const { title, tags, dates, tile, link } = project.data;
const Wrapper = link ? 'a' : 'div';
---

<Wrapper class:list={['tile', `tile--${shape}`]} href={link}>
  <TileArt
    class="tile__art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="(max-width: 700px) 100vw, 54vw"
    transitionName={project.id}
  />
  <Bar lead={tags} trail={[{ label: dates }]} />
</Wrapper>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--text-strong);
  }

  .tile :global(.tile__art) {
    aspect-ratio: 1;
  }

  /* Tall tiles are two columns wide and three columns high */
  .tile--tall :global(.tile__art) {
    aspect-ratio: auto;
    height: calc(3 * var(--col) + 2 * var(--grid-gap));
  }

  /* Hover: the tile rounds into a CRT screen, corners pulled in with a soft
     glass edge, rather than zooming. Eases in, and back out a little quicker. */
  .tile :global(.tile__art)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px oklch(from var(--neutral-1000) l c h / 0.2),
      inset 0 0 2.5em oklch(from var(--neutral-1000) l c h / 0.4);
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) {
    a.tile:hover :global(.tile__art) {
      border-radius: 9%;
    }

    a.tile:hover :global(.tile__art)::after {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile :global(.tile__art),
    .tile :global(.tile__art)::after {
      transition:
        border-radius var(--duration-m) var(--ease-out),
        opacity var(--duration-m) var(--ease-out);
    }

    a.tile:hover :global(.tile__art),
    a.tile:hover :global(.tile__art)::after {
      transition-duration: var(--duration-l);
    }
  }

  a.tile:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }
</style>
