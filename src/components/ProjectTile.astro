---
// Figma: "Project - X". Gradient artwork (live LensFlare, or a still with a
// grain overlay), centred logo, then a Bar with tags and dates underneath.
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';
import Bar from './Bar.astro';

export type TileShape = 'square' | 'tall';

interface Props {
  project: CollectionEntry<'work'>;
  shape: TileShape;
}

const { project, shape } = Astro.props;
const { title, tags, dates, tile, link } = project.data;
const Wrapper = link ? 'a' : 'div';
---

<Wrapper class:list={['tile', `tile--${shape}`]} href={link}>
  <span id={`work-${project.id}`} class="tile__anchor" aria-hidden="true"></span>
  <TileArt
    class="tile__art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="(max-width: 700px) 100vw, 54vw"
    transitionName={project.id}
  />
  <Bar lead={tags} trail={dates} />
</Wrapper>

<style>
  .tile {
    /* A container so the hover corners can be sized off the tile's width */
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--text-strong);
  }

  .tile :global(.tile__art) {
    aspect-ratio: 1;
  }

  /* The #work-<id> target (Close on a case study, the skill chips). It sits
     at the middle of the art and scrolls to the middle of the screen, so
     a jump here lands with the tile centred, however tall its grid cell */
  .tile {
    position: relative;
  }

  .tile__anchor {
    position: absolute;
    top: 50cqi;
    left: 0;
    scroll-margin-top: 50svh;
  }

  .tile--tall .tile__anchor {
    top: calc((3 * var(--col) + 2 * var(--grid-gap)) / 2);
  }

  @media (max-width: 700px) {
    .tile__anchor,
    .tile--tall .tile__anchor {
      top: calc(50cqi * 812 / 1416);
    }
  }

  /* Tall tiles are two columns wide and three columns high */
  .tile--tall :global(.tile__art) {
    aspect-ratio: auto;
    height: calc(3 * var(--col) + 2 * var(--grid-gap));
  }

  /* Phones: every tile the shape of a case study's full-width image
     (1416 × 812), so the column of work isn't a stack of squares */
  @media (max-width: 700px) {
    .tile :global(.tile__art),
    .tile--tall :global(.tile__art) {
      height: auto;
      aspect-ratio: 1416 / 812;
    }
  }

  /* Hover: the tile rounds into a CRT screen, corners pulled in with a soft
     glass edge, rather than zooming. Eases in, and back out a little quicker. */
  .tile :global(.tile__art)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px oklch(from var(--neutral-1000) l c h / 0.2),
      inset 0 0 2.5em oklch(from var(--neutral-1000) l c h / 0.4);
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) {
    /* 9% of the width, as a length so the tall tile's corners stay round
       rather than stretching into ellipses */
    a.tile:hover :global(.tile__art) {
      border-radius: 9cqi;
    }

    a.tile:hover :global(.tile__art)::after {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile :global(.tile__art),
    .tile :global(.tile__art)::after {
      transition:
        border-radius var(--duration-m) var(--ease-out),
        opacity var(--duration-m) var(--ease-out);
    }

    a.tile:hover :global(.tile__art),
    a.tile:hover :global(.tile__art)::after {
      transition-duration: var(--duration-l);
    }
  }

  a.tile:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }
</style>
