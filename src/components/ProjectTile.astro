---
// Figma: "Project - X". Gradient artwork, grain overlay, centred logo, then a
// bar with tags and dates underneath.
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import grain from '../assets/work/grain.jpg';

export type TileShape = 'square' | 'tall';

interface Props {
  project: CollectionEntry<'work'>;
  shape: TileShape;
}

const { project, shape } = Astro.props;
const { title, tags, dates, tile, link } = project.data;
const Wrapper = link ? 'a' : 'div';
const grainImage = await getImage({ src: grain, width: 2000, format: 'webp', quality: 70 });
---

<Wrapper class:list={['tile', `tile--${shape}`]} href={link}>
  <div class="tile__art">
    <Image
      class="tile__image"
      src={tile.image}
      alt=""
      widths={[480, 820, 1640]}
      sizes="(max-width: 700px) 100vw, 54vw"
    />
    {tile.grain && <img class="tile__grain" src={grainImage.src} alt="" loading="lazy" />}
    <img
      class="tile__logo"
      src={tile.logo.src}
      alt={title}
      width={tile.logo.width}
      height={tile.logo.height}
      style={`width: ${tile.logoScale * 100}%;`}
    />
  </div>
  <p class="tile__bar t-h3">
    <span class="tile__tags t-h3-bold">
      {tags.map((tag, i) => (
        <>{i > 0 && <span class="tile__sep" aria-hidden="true">|</span>}{tag}</>
      ))}
    </span>
    <span class="tile__dates">{dates}</span>
  </p>
</Wrapper>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--text-strong);
  }

  .tile__art {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-s);
    aspect-ratio: 1;
    isolation: isolate;
  }

  /* Tall tiles are two columns wide and three columns high */
  .tile--tall .tile__art {
    aspect-ratio: auto;
    height: calc(3 * var(--col) + 2 * var(--grid-gap));
  }

  .tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-m) var(--ease-out);
  }

  /* Grain from Figma: oversized and offset, colour-dodged at half strength */
  .tile__grain {
    position: absolute;
    top: -56.59%;
    left: -109.88%;
    width: 319.75%;
    height: 213.17%;
    max-width: none;
    mix-blend-mode: color-dodge;
    opacity: 0.5;
    pointer-events: none;
  }

  .tile__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    height: auto;
    transform: translate(-50%, -50%);
  }

  .tile__bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .tile__tags {
    color: var(--text-strong);
  }

  .tile__sep {
    margin-inline: 0.5em;
  }

  .tile__dates {
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.tile:hover .tile__image {
      transform: scale(1.03);
    }
  }

  a.tile:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }
</style>
