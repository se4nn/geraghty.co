---
// Figma: "Project - X". Gradient artwork, grain overlay, centred logo, then a
// bar with tags and dates underneath.
import type { CollectionEntry } from 'astro:content';
import TileArt from './TileArt.astro';

export type TileShape = 'square' | 'tall';

interface Props {
  project: CollectionEntry<'work'>;
  shape: TileShape;
}

const { project, shape } = Astro.props;
const { title, tags, dates, tile, link } = project.data;
const Wrapper = link ? 'a' : 'div';
---

<Wrapper class:list={['tile', `tile--${shape}`]} href={link}>
  <TileArt
    class="tile__art"
    image={tile.image}
    logo={tile.logo}
    logoScale={tile.logoScale}
    grain={tile.grain}
    gradient={tile.gradient}
    alt={title}
    sizes="(max-width: 700px) 100vw, 54vw"
  />
  <p class="tile__bar t-h3">
    <span class="tile__tags t-h3-bold">
      {tags.map((tag, i) => (
        <>{i > 0 && <span class="tile__sep" aria-hidden="true">|</span>}{tag}</>
      ))}
    </span>
    <span class="tile__dates">{dates}</span>
  </p>
</Wrapper>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--text-strong);
  }

  .tile :global(.tile__art) {
    aspect-ratio: 1;
  }

  /* Tall tiles are two columns wide and three columns high */
  .tile--tall :global(.tile__art) {
    aspect-ratio: auto;
    height: calc(3 * var(--col) + 2 * var(--grid-gap));
  }

  /* Dates drop under the tags when a narrow tile can't fit both */
  .tile__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-m);
  }

  .tile__tags {
    color: var(--text-strong);
  }

  .tile__sep {
    margin-inline: 0.5em;
  }

  .tile__dates {
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a.tile:hover :global(.tile-art__image) {
      transform: scale(1.03);
    }
  }

  a.tile:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 8px;
    border-radius: var(--radius-s);
  }
</style>
