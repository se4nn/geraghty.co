---
// A full-width band of a case study. Art that bleeds past the grid, and the
// glow, are clipped at its edges.
// flush: the first block sits right at the top (the opening image)
// glow: a soft darker light across the top, marking a new chapter
interface Props {
  label: string;
  flush?: boolean;
  glow?: boolean;
}

const { label, flush = false, glow = false } = Astro.props;
---

<section class:list={['chapter', { 'chapter--flush': flush, 'chapter--glow': glow }]} aria-label={label}>
  <div class="chapter__inner container"><slot /></div>
</section>

<style>
  .chapter {
    position: relative;
    overflow: clip;
    background-color: var(--bg-work);
  }

  .chapter__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    /* 144 = the 96 between blocks and a section's own 48 */
    padding-block: calc(var(--space-2xl) + var(--space-xl));
  }

  /* A chapter that opens on a Section keeps just the 144 above it */
  .chapter__inner > :global(.section:first-child) {
    padding-top: 0;
  }

  .chapter--flush .chapter__inner {
    padding-top: 0;
  }

  /* Glow */

  .chapter--glow::before {
    content: '';
    position: absolute;
    top: calc(-320 / 1512 * 100vw);
    left: 0;
    right: 0;
    height: calc(640 / 1512 * 100vw);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--neutral-300), var(--neutral-100));
    filter: blur(calc(400 / 1512 * 100vw / 2));
    pointer-events: none;
  }

  /* Swells up as the chapter arrives from below (MOTION.md: Light) */
  @media (prefers-reduced-motion: no-preference) {
    .chapter--glow[data-arrival='waiting']::before {
      opacity: 0.15;
      scale: 0.8 0.6;
    }

    .chapter--glow[data-arrival='arrived']::before {
      transition:
        opacity 2000ms var(--ease-out),
        scale 2400ms var(--ease-out-expo);
    }
  }
</style>

<script>
  import { whenSeen, arrive } from '../scripts/arrival';

  for (const chapter of document.querySelectorAll<HTMLElement>('.chapter--glow')) {
    whenSeen(chapter, 0.08).then((seen) => {
      if (seen) arrive(chapter);
    });
  }
</script>
