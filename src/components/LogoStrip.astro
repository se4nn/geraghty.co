---
// Figma: "Previous"
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  logos: { name: string; src: ImageMetadata }[];
}

const { heading, logos } = Astro.props;
---

<div class="logo-strip">
  <h2 class="logo-strip__heading t-h3">{heading}</h2>
  <ul class="logo-strip__list" role="list">
    {
      logos.map((logo) => (
        <li>
          <img src={logo.src.src} alt={logo.name} width={logo.src.width} height={logo.src.height} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .logo-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .logo-strip__heading {
    color: var(--text-muted);
    text-align: center;
  }

  .logo-strip__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    width: 100%;
    list-style: none;
  }

  .logo-strip__list img {
    height: clamp(16px, 1.59vw, 24px);
    width: auto;
  }

  @media (max-width: 700px) {
    .logo-strip__list {
      justify-content: center;
    }
  }
</style>
