---
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  logos: { name: string; src: ImageMetadata; href?: string }[];
}

const { heading, logos } = Astro.props;
---

<div class="logo-strip">
  <h2 class="heading t-h3">{heading}</h2>
  <ul class="list" role="list">
    {
      logos.map((logo) => (
        <li>
          {logo.href ? (
            <a class="link" href={logo.href} target="_blank" rel="noopener">
              <img src={logo.src.src} alt={logo.name} width={logo.src.width} height={logo.src.height} />
            </a>
          ) : (
            <img src={logo.src.src} alt={logo.name} width={logo.src.width} height={logo.src.height} />
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .logo-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .heading {
    color: var(--text-muted);
    text-align: center;
  }

  .list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l) var(--space-xl);
    width: 100%;
    list-style: none;
  }

  .list img {
    height: clamp(16px, 1.59vw, 24px);
    width: auto;
  }

  .link {
    display: block;
    padding-block: max(0px, (24px - clamp(16px, 1.59vw, 24px)) / 2);
    transition: opacity var(--duration-s) var(--ease-out);
  }

  .link img {
    display: block;
  }

  @media (max-width: 700px) {
    .list {
      justify-content: center;
    }
  }

  /* Hover */

  @media (hover: hover) {
    .link:hover {
      opacity: 0.6;
    }
  }

  /* Focus */

  .link:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 3px;
    border-radius: var(--radius-s);
  }
</style>
