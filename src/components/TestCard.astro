---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import format from '../assets/work/format/insight-world-poster.png';
import fertifa from '../assets/work/fertifa/menopause-posters.jpg';
import studia from '../assets/work/studia/brand-creator-live.png';
import shuffle from '../assets/work/shuffle/poster-billboard.jpg';
import minimum from '../assets/work/minimum/social-grid.png';
import steepclub from '../assets/work/steepclub/boxes-partea.jpg';

const work: Record<string, ImageMetadata> = { format, fertifa, studia, shuffle, minimum, steepclub };

const projects = (await getCollection('work'))
  .filter((p) => p.data.caseStudy)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 8)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    href: p.data.link!,
    art: p.data.tile.image,
    logo: p.data.tile.logo,
    work: work[p.id] ?? p.data.tile.image,
  }));

const cols = 20;
const rows = 12;

const isInk = (r: number, c: number) => {
  if (r === 0) return c === 0 || c % 2 === 1;
  if (r === rows - 1) return c % 2 === 0 || c === cols - 1;
  if (c === 0) return r % 2 === 1;
  if (c === cols - 1) return r % 2 === 0;
  return false;
};
const isEdge = (r: number, c: number) => r === 0 || c === 0 || r === rows - 1 || c === cols - 1;
const cells = Array.from({ length: rows * cols }, (_, i) => {
  const r = Math.floor(i / cols);
  const c = i % cols;
  return isEdge(r, c) ? (isInk(r, c) ? 'ink' : 'paper') : '';
});

const barStart = Math.floor((cols - projects.length * 2) / 2);
const standbySpan = 8;
const standbyStart = Math.floor((cols - standbySpan) / 2);
---

<section class="test-card" style={`--cols: ${cols}; --rows: ${rows}`}>
  <h1 class="visually-hidden">Nothing on this channel</h1>

  <div class="cells" aria-hidden="true">
    {cells.map((name) => <span class={name || undefined} />)}
  </div>

  <div class="layer">
    {
      projects.map((p, i) => (
        <a
          class="tune"
          href={p.href}
          data-id={p.id}
          data-title={p.title}
          style={`grid-area: 3 / ${barStart + i * 2 + 1} / span 1 / span 2`}
        >
          <span class="visually-hidden">{p.title}</span>
          <Image class="art" src={p.art} alt="" widths={[600, 1200]} sizes="(max-width: 900px) 70vw, 35vw" quality={90} />
          <Image class="peek" src={p.work} alt="" widths={[300, 600]} sizes="(max-width: 900px) 25vw, 12vw" quality={90} loading="lazy" />
        </a>
      ))
    }

    <p class="standby t-h3-bold" aria-live="polite" style={`grid-area: ${rows - 2} / ${standbyStart + 1} / span 1 / span ${standbySpan}`}>
      Please stand by…
    </p>

    <a class="home" href="/" style={`grid-area: ${rows} / 1`}>
      <span class="visually-hidden">Back to all work</span>
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M13.25 4L12.5 4L12.5795 4.71575C12.5973 4.87563 12.412 4.99402 12.269 4.92041C11.6388 4.59602 10.1836 4 8 4C5 4 2.125 5.5 2.125 9.625C2.125 16 10.75 15.625 11.5 21.625C11.875 25.75 9.25 26.875 7 26.875C2.86103 26.875 2.50001 25.75 1.75 22H1L1.75 27.75H2.75L2.62145 27.1072C2.58507 26.9253 2.83287 26.778 2.99115 26.8748C4.05862 27.5273 6.00672 28 7.75 28C11.125 28 15.25 26.875 15.25 21.25C15.25 14.1222 5.125 13.375 4.75 8.875C4.5625 6.25 6.5 5 9 5C12 5 13 6.5 13.25 8H14L13.25 4Z" />
        <path d="M28.25 4H27.5L27.6299 4.51959C27.6564 4.62543 27.4539 4.75539 27.3592 4.70114C26.8451 4.40649 25.7315 4 23.5 4C18 4 15.5 10.875 15.5 16C15.5 22.375 18 28 23.5 28C28 28 29.5 27 29.5 21V16.3604C29.5 16.1452 29.6377 15.9541 29.8419 15.886L31 15.5V15H25V15.5L26.1581 15.886C26.3623 15.9541 26.5 16.1452 26.5 16.3604V23C26.5 26 26 27 24 27C18.5 27 18.6872 18.2464 18.5 16C18.5 13 18.5 5 24 5C27 5 28 6.5 28.25 8H29L28.25 4Z" />
      </svg>
    </a>

    <p class="code t-h3-bold" style={`grid-area: ${rows} / ${cols}`}>404</p>
  </div>

  <div class="circle">
    {
      projects.map((p, i) => (
        <img
          class={i === 0 ? 'logo on' : 'logo'}
          data-id={p.id}
          src={p.logo.src}
          width={p.logo.width}
          height={p.logo.height}
          alt=""
          style={`--logo-aspect: ${(p.logo.width / p.logo.height).toFixed(4)}`}
        />
      ))
    }
  </div>

  <div class="saver" hidden>
    <div class="thumb">
      {projects.map((p) => <Image class="work" data-id={p.id} src={p.work} alt="" widths={[400, 800]} sizes="(max-width: 700px) 40vw, 24vw" quality={90} loading="lazy" />)}
    </div>
    <p class="wake t-label">Tap anywhere to come back</p>
  </div>
</section>

<style>
  .test-card {
    position: relative;
    height: 100svh;
    overflow: clip;
    background-color: var(--neutral-000);
    --cell: calc(100vw / var(--cols));
  }

  /* Grid */
  .cells,
  .layer {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows), minmax(0, 1fr));
    gap: 2px;
  }

  .cells :global(span) {
    border-radius: 2px;
    background-color: var(--neutral-300);
  }

  .cells :global(span.ink) {
    background-color: var(--neutral-1000);
  }

  .cells :global(span.paper) {
    background-color: var(--neutral-000);
  }

  /* Colour Bars */
  .tune {
    position: relative;
    display: block;
    overflow: clip;
    border-radius: 2px;
    background-color: var(--neutral-1000);
  }

  .tune .art,
  .peek {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tune .art {
    scale: 3;
  }

  .peek {
    visibility: hidden;
  }

  .tune:focus-visible {
    outline: 2px solid var(--neutral-1000);
    outline-offset: 3px;
    z-index: 1;
  }

  .tune:focus-visible .peek {
    visibility: visible;
  }

  @media (hover: hover) {
    .tune:hover .peek {
      visibility: visible;
    }
  }

  /* Labels */
  .standby,
  .code,
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    border-radius: 2px;
    background-color: var(--neutral-1000);
    color: var(--neutral-000);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: clip;
  }

  .code {
    font-size: min(var(--h3-size), calc(var(--cell) * 0.42));
  }

  .home svg {
    width: 44%;
    fill: currentColor;
  }

  .home:focus-visible {
    outline: 2px solid var(--neutral-1000);
    outline-offset: 3px;
  }

  /* Circle */
  .circle {
    position: absolute;
    left: 50%;
    top: var(--circle-y, 50%);
    width: var(--circle, calc(var(--cell) * 4.44));
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 2px solid var(--neutral-000);
    border-radius: 50%;
    background-color: var(--neutral-100);
    pointer-events: none;
  }

  .logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(calc(32.7% * sqrt(var(--logo-aspect))), 82%);
    max-height: 50%;
    height: auto;
    object-fit: contain;
    translate: -50% -50%;
    filter: brightness(0);
    visibility: hidden;
  }

  .logo.on {
    visibility: visible;
  }

  /* Screensaver */
  .saver {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--neutral-1000);
    cursor: pointer;
  }

  .saver[hidden] {
    display: none;
  }

  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(160px, 24vw, 420px);
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-l);
    overflow: clip;
    will-change: transform;
  }

  .thumb .work {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
  }

  .thumb .work.on {
    visibility: visible;
  }

  .wake {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-xl);
    margin: 0;
    color: var(--text-on-dark-muted);
    text-align: center;
  }

  /* Motion */
  @media (prefers-reduced-motion: no-preference) {
    .test-card {
      animation: screen-on 1000ms 200ms both;
    }

    .thumb.corner {
      animation: corner 900ms var(--ease-out);
    }
  }

  @keyframes corner {
    0%,
    40% {
      filter: brightness(2.2) saturate(1.4);
    }
  }
</style>

<script>
  const IDLE = 5000;
  const SPEED = 0.09;

  for (const card of document.querySelectorAll<HTMLElement>('.test-card')) {
    const cells = card.querySelector<HTMLElement>('.cells')!;
    const bars = [...card.querySelectorAll<HTMLElement>('.tune')];
    const standby = card.querySelector<HTMLElement>('.standby')!;
    const home = card.querySelector<HTMLElement>('.home')!;
    const code = card.querySelector<HTMLElement>('.code')!;
    const logos = [...card.querySelectorAll<HTMLImageElement>('.circle .logo')];
    const saver = card.querySelector<HTMLElement>('.saver')!;
    const thumb = card.querySelector<HTMLElement>('.thumb')!;
    const thumbs = [...thumb.querySelectorAll<HTMLImageElement>('.work')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const waiting = standby.textContent!.trim();

    /* Layout */
    const layout = () => {
      const w = card.clientWidth;
      const h = card.clientHeight;
      const cols = w >= 900 ? 20 : w >= 600 ? 14 : 10;
      const cell = w / cols;
      const rows = Math.max(9, Math.round(h / cell));
      const cellH = h / rows;
      card.style.setProperty('--cols', String(cols));
      card.style.setProperty('--rows', String(rows));

      const ink = (r: number, c: number) => {
        if (r === 0) return c === 0 || c % 2 === 1;
        if (r === rows - 1) return c % 2 === 0 || c === cols - 1;
        if (c === 0) return r % 2 === 1;
        if (c === cols - 1) return r % 2 === 0;
        return false;
      };
      const html: string[] = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const edge = r === 0 || c === 0 || r === rows - 1 || c === cols - 1;
          html.push(edge ? `<span class="${ink(r, c) ? 'ink' : 'paper'}"></span>` : '<span></span>');
        }
      }
      cells.innerHTML = html.join('');

      const perRow = Math.min(bars.length, Math.floor((cols - 4) / 2));
      const barRows = Math.ceil(bars.length / perRow);
      bars.forEach((bar, i) => {
        const row = Math.floor(i / perRow);
        const inRow = Math.min(perRow, bars.length - row * perRow);
        const start = Math.floor((cols - inRow * 2) / 2);
        bar.style.gridArea = `${3 + row} / ${start + (i % perRow) * 2 + 1} / span 1 / span 2`;
      });

      const span = Math.min(8, cols - 2);
      const standbyRow = rows - 3;
      standby.style.gridArea = `${standbyRow + 1} / ${Math.floor((cols - span) / 2) + 1} / span 1 / span ${span}`;
      home.style.gridArea = `${rows} / 1`;
      code.style.gridArea = `${rows} / ${cols}`;

      const top = (2 + barRows) * cellH;
      const bottom = standbyRow * cellH;
      const room = bottom - top - cellH * 0.5;
      const size = Math.min(cell * (cols >= 20 ? 4.44 : cols * 0.6), room);
      card.style.setProperty('--circle', `${size}px`);
      card.style.setProperty('--circle-y', `${(top + bottom) / 2}px`);
    };

    layout();
    new ResizeObserver(layout).observe(card);

    /* Tuning */
    const resting = logos[Math.floor(Math.random() * logos.length)]?.dataset.id;
    const show = (id?: string) => logos.forEach((img) => img.classList.toggle('on', img.dataset.id === id));
    show(resting);

    let intent = 0;
    const tune = (bar: HTMLElement | null) => {
      clearTimeout(intent);
      intent = window.setTimeout(() => {
        show(bar?.dataset.id ?? resting);
        standby.textContent = bar ? `Now showing: ${bar.dataset.title}` : waiting;
      }, 100);
    };

    for (const bar of bars) {
      bar.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && tune(bar));
      bar.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && tune(null));
      bar.addEventListener('focus', () => tune(bar));
      bar.addEventListener('blur', () => tune(null));
    }

    /* Screensaver */
    let running = false;
    let frame = 0;
    let last = 0;
    let x = 0;
    let y = 0;
    let vx = 1;
    let vy = 1;
    let index = 0;
    let idle = 0;
    let swallow = false;

    const pick = (i: number) => {
      index = (i + thumbs.length) % thumbs.length;
      thumbs.forEach((img, n) => img.classList.toggle('on', n === index));
    };

    const step = (now: number) => {
      const dt = Math.min(now - last, 100) / 1000;
      last = now;
      const maxX = innerWidth - thumb.offsetWidth;
      const maxY = innerHeight - thumb.offsetHeight;
      const speed = SPEED * Math.max(innerWidth, innerHeight);
      x += vx * speed * dt;
      y += vy * speed * dt;
      let hitX = false;
      let hitY = false;
      if (x <= 0 || x >= maxX) {
        x = Math.min(Math.max(x, 0), maxX);
        vx = -vx;
        hitX = true;
      }
      if (y <= 0 || y >= maxY) {
        y = Math.min(Math.max(y, 0), maxY);
        vy = -vy;
        hitY = true;
      }
      const near = 6;
      const cornered = (hitX && (y <= near || y >= maxY - near)) || (hitY && (x <= near || x >= maxX - near));
      if (hitX || hitY) pick(index + 1);
      if (cornered) {
        thumb.classList.remove('corner');
        void thumb.offsetWidth;
        thumb.classList.add('corner');
      }
      thumb.style.transform = `translate(${x}px, ${y}px)`;
      frame = requestAnimationFrame(step);
    };

    const start = () => {
      if (running || reduced.matches) return;
      running = true;
      saver.hidden = false;
      x = Math.random() * Math.max(innerWidth - thumb.offsetWidth, 0);
      y = Math.random() * Math.max(innerHeight - thumb.offsetHeight, 0);
      vx = Math.random() < 0.5 ? -1 : 1;
      vy = Math.random() < 0.5 ? -1 : 1;
      pick(Math.floor(Math.random() * thumbs.length));
      last = performance.now();
      frame = requestAnimationFrame(step);
    };

    const stop = () => {
      if (!running) return;
      running = false;
      cancelAnimationFrame(frame);
      saver.hidden = true;
      thumb.classList.remove('corner');
    };

    const wait = () => {
      clearTimeout(idle);
      if (!running) idle = window.setTimeout(start, IDLE);
    };

    addEventListener('pointermove', () => !running && wait(), { passive: true });
    addEventListener('scroll', () => !running && wait(), { passive: true });
    addEventListener(
      'pointerdown',
      () => {
        if (running) {
          swallow = true;
          stop();
        }
        wait();
      },
      { capture: true },
    );
    addEventListener(
      'click',
      (e) => {
        if (!swallow) return;
        swallow = false;
        e.preventDefault();
        e.stopPropagation();
      },
      { capture: true },
    );
    addEventListener('keydown', () => {
      stop();
      wait();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) start();
    });

    wait();
  }
</script>
