---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  from: string;
  to: string;
  mid?: string;
  seed?: number;
  fringe?: 'auto' | 'warm' | 'cool';
  dither?: 'grain' | 'crt';
  darkness?: number;
  period?: number;
  intensity?: number;
  scale?: number;
  grain?: number;
}

const {
  from,
  to,
  mid = 'var(--neutral-1000)',
  seed = 0,
  fringe = 'auto',
  dither = 'grain',
  darkness,
  period,
  intensity,
  scale,
  grain,
  class: className,
  ...attrs
} = Astro.props;
---

<lens-flare
  {...attrs}
  class:list={['lens-flare', className]}
  style={`--lf-from: ${from}; --lf-mid: ${mid}; --lf-to: ${to};`}
  data-seed={seed}
  data-fringe={fringe}
  data-dither={dither}
  data-darkness={darkness}
  data-period={period}
  data-intensity={intensity}
  data-scale={scale}
  data-grain={grain}
>
  <slot />
  <canvas class="canvas" aria-hidden="true"></canvas>
</lens-flare>

<style>
  :where(.lens-flare) {
    position: relative;
    display: block;
  }

  .lens-flare {
    overflow: hidden;
    background: linear-gradient(100deg, var(--lf-from) 30%, var(--lf-mid) 50%, var(--lf-to) 70%);
  }

  .canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-l) var(--ease-out);
  }

  .lens-flare[data-ready] .canvas {
    opacity: 1;
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  // Settings

  const DEFAULTS = {
    darkness: 0.49,
    period: 61,
    intensity: 1.7,
    scale: 1.03,
    grain: 0.3,
  };

  const FIELD_SCALE = 0.6;
  const DPR_CAP = 1.5;
  const FPS_CAP = 30;
  const REF_ASPECT = 16 / 9;
  const DITHER_ROWS = 540;
  const CRT_CELL = 3;
  const SCREEN_FPS = 30;
  const BEAM_Y = 0.5;
  const BEAM_FOLLOW = 90;
  const BEAM_REST = 0.45;
  const BEAM_TRAIL_REST = 0.03;
  const BEAM_TRAIL_MAX = 0.25;
  const BEAM_FULL_SPEED = 1;
  const BEAM_SETTLE = 300;
  const TAU = Math.PI * 2;

  // Shaders

  const VERT = `#version 300 es
    in vec2 a_pos;
    out vec2 v_uv;
    void main() {
      v_uv = a_pos * 0.5 + 0.5;
      gl_Position = vec4(a_pos, 0.0, 1.0);
    }`;

  const FRAG_FIELD = `#version 300 es
    precision highp float;
    in vec2 v_uv;
    out vec4 outColor;

    uniform vec2 u_res;
    uniform float u_phase;
    uniform float u_seed;
    uniform float u_scale;
    uniform float u_darkness;
    uniform float u_crop;
    uniform vec3 u_from;
    uniform vec3 u_mid;
    uniform vec3 u_to;

    const float WARP = 0.6;
    const float LOOP_RADIUS = 0.9;
    const float TILT_X = 0.95;
    const float TEXTURE = 0.62;

    // Ashima 4D simplex noise, github.com/ashima/webgl-noise (MIT)
    vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    float mod289(float x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
    float permute(float x) { return mod289(((x * 34.0) + 1.0) * x); }
    vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
    float taylorInvSqrt(float r) { return 1.79284291400159 - 0.85373472095314 * r; }

    vec4 grad4(float j, vec4 ip) {
      const vec4 ones = vec4(1.0, 1.0, 1.0, -1.0);
      vec4 p, s;
      p.xyz = floor(fract(vec3(j) * ip.xyz) * 7.0) * ip.z - 1.0;
      p.w = 1.5 - dot(abs(p.xyz), ones.xyz);
      s = vec4(lessThan(p, vec4(0.0)));
      p.xyz = p.xyz + (s.xyz * 2.0 - 1.0) * s.www;
      return p;
    }

    float snoise(vec4 v) {
      const vec4 C = vec4(0.138196601125011, 0.276393202250021,
                          0.414589803375032, -0.447213595499958);
      const float F4 = 0.309016994374947451;
      vec4 i = floor(v + dot(v, vec4(F4)));
      vec4 x0 = v - i + dot(i, C.xxxx);
      vec4 i0;
      vec3 isX = step(x0.yzw, x0.xxx);
      vec3 isYZ = step(x0.zww, x0.yyz);
      i0.x = isX.x + isX.y + isX.z;
      i0.yzw = 1.0 - isX;
      i0.y += isYZ.x + isYZ.y;
      i0.zw += 1.0 - isYZ.xy;
      i0.z += isYZ.z;
      i0.w += 1.0 - isYZ.z;
      vec4 i3 = clamp(i0, 0.0, 1.0);
      vec4 i2 = clamp(i0 - 1.0, 0.0, 1.0);
      vec4 i1 = clamp(i0 - 2.0, 0.0, 1.0);
      vec4 x1 = x0 - i1 + C.xxxx;
      vec4 x2 = x0 - i2 + C.yyyy;
      vec4 x3 = x0 - i3 + C.zzzz;
      vec4 x4 = x0 + C.wwww;
      i = mod289(i);
      float j0 = permute(permute(permute(permute(i.w) + i.z) + i.y) + i.x);
      vec4 j1 = permute(permute(permute(permute(
                  i.w + vec4(i1.w, i2.w, i3.w, 1.0))
                + i.z + vec4(i1.z, i2.z, i3.z, 1.0))
                + i.y + vec4(i1.y, i2.y, i3.y, 1.0))
                + i.x + vec4(i1.x, i2.x, i3.x, 1.0));
      vec4 ip = vec4(1.0 / 294.0, 1.0 / 49.0, 1.0 / 7.0, 0.0);
      vec4 p0 = grad4(j0, ip);
      vec4 p1 = grad4(j1.x, ip);
      vec4 p2 = grad4(j1.y, ip);
      vec4 p3 = grad4(j1.z, ip);
      vec4 p4 = grad4(j1.w, ip);
      vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
      p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
      p4 *= taylorInvSqrt(dot(p4, p4));
      vec3 m0 = max(0.6 - vec3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0);
      vec2 m1 = max(0.6 - vec2(dot(x3, x3), dot(x4, x4)), 0.0);
      m0 = m0 * m0;
      m1 = m1 * m1;
      return 49.0 * (dot(m0 * m0, vec3(dot(p0, x0), dot(p1, x1), dot(p2, x2)))
                   + dot(m1 * m1, vec2(dot(p3, x3), dot(p4, x4))));
    }

    float loopNoise(vec2 p, float revs, float off) {
      float a = 6.28318530718 * u_phase * revs;
      off += u_seed * 17.3;
      return snoise(vec4(p.x + off, p.y - off, cos(a) * LOOP_RADIUS, sin(a) * LOOP_RADIUS));
    }

    void main() {
      vec2 p = (v_uv - 0.5) * vec2(u_res.x / u_res.y, 1.0);

      vec2 w = vec2(
        loopNoise(p * u_scale, 3.0, 0.0),
        loopNoise(p * u_scale + 4.7, 1.0, 11.3)
      );
      vec2 pw = p + w * WARP;

      float f = 0.5 + 0.5 * loopNoise(pw * u_scale * 0.62, 3.0, 3.1);
      f = 0.5 + (f - 0.5) * TEXTURE;
      f += TILT_X * (v_uv.x - 0.5) * u_crop;
      f = clamp(f, 0.0, 1.0);
      f = pow(f, 1.0 + 1.15 * u_darkness);

      vec3 c = mix(u_from, u_mid, smoothstep(0.3, 0.5, f));
      c = mix(c, u_to, smoothstep(0.5, 0.7, f));
      outColor = vec4(c, 1.0);
    }`;

  const FRAG_POST = `#version 300 es
    precision highp float;
    in vec2 v_uv;
    out vec4 outColor;

    uniform sampler2D u_tex;
    uniform float u_frame;
    uniform vec2 u_abDir;
    uniform float u_exposure;
    uniform float u_grain;
    uniform float u_cell;
    uniform int u_mode;
    uniform vec2 u_res;
    uniform float u_crtCell;
    uniform vec2 u_origin;
    uniform vec2 u_screen;
    uniform float u_scan;
    uniform float u_trail;
    uniform float u_beamAmt;
    uniform float u_screenFrame;
    uniform float u_live;

    const int TAPS = 32;
    const float AB_AMOUNT = 0.03;
    const float AB_BLUE = -0.3;
    const float AB_SPREAD = 1.1;
    const float CONTRAST = 0.95;
    const float SATURATION = 0.95;
    const float DITHER_GAIN = 0.46;
    const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
    const float LEVELS = 8.0;
    const float MASK = 0.18;
    const float MASK_BORDER = 0.7;
    const float SCANLINES = 0.1;
    const float CELL_SOFTEN = 0.35;
    const float DITHER_MIX = 0.6;
    const float CRT_GAIN_SCAN = 1.05;
    const float CRT_GAIN_MASK = 1.15;
    const float BEAM_GLOW = 0.22;
    const float BEAM_LEAD = 0.012;
    const float BEAM_JITTER = 1.5;
    const float VIGNETTE = 0.35;
    const float FLICKER = 0.025;
    const float BLOOM = 0.45;
    const float BLOOM_THRESHOLD = 0.5;
    const float BLOOM_RADIUS = 4.0;
    const float BLOOM_BEAM = 1.5;

    float hash(uvec3 v) {
      uint h = v.x * 1973u + v.y * 9277u + v.z * 26699u;
      h = (h ^ (h >> 16u)) * 0x7feb352du;
      h = (h ^ (h >> 15u)) * 0x846ca68bu;
      h ^= h >> 16u;
      return float(h) / 4294967295.0;
    }

    float bayer2(vec2 a) {
      a = floor(a);
      return fract(dot(a, vec2(0.5, a.y * 0.75)));
    }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
    float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

    void main() {
      vec2 screenPx = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y) + u_origin;
      vec2 coord = screenPx / u_crtCell;
      vec2 cellOffset = vec2(0.0, mod(floor(coord.x), 2.0) * 0.5);
      vec2 cellId = floor(coord + cellOffset);
      vec2 cellCentre = (cellId - cellOffset + 0.5) * u_crtCell;
      vec2 local = cellCentre - u_origin;
      vec2 uv = u_mode == 1 ? mix(vec2(local.x, u_res.y - local.y) / u_res, v_uv, CELL_SOFTEN) : v_uv;
      float maskFade = smoothstep(3.5, 6.0, u_crtCell);

      float beam = 0.0;
      if (u_mode == 1 && u_live > 0.5) {
        float d = u_scan - cellCentre.y / u_screen.y;
        float dd = u_trail >= 0.0 ? d : -d;
        float trail = max(abs(u_trail), 1e-3);
        beam = dd >= 0.0 ? exp(-dd / trail) : exp(-(dd * dd) / (BEAM_LEAD * BEAM_LEAD));
        beam *= u_beamAmt;
        float edge = exp(-(d * d) / (4.0 * BEAM_LEAD * BEAM_LEAD));
        float shift = hash(uvec3(uint(max(cellId.y, 0.0)), uint(u_screenFrame), 7u)) - 0.5;
        uv.x += shift * BEAM_JITTER * edge * u_beamAmt * u_crtCell / u_res.x;
      }

      float spread = AB_AMOUNT * AB_SPREAD;
      float cR = -AB_AMOUNT;
      float cB = AB_AMOUNT * (1.0 + AB_BLUE);
      float cG = mix(cR, cB, 0.5);
      vec3 sum = vec3(0.0);
      for (int i = 0; i < TAPS; i++) {
        float base = float(i) / float(TAPS - 1) * 2.0 - 1.0;
        sum.r += texture(u_tex, uv + u_abDir * (cR + spread * base)).r;
        sum.g += texture(u_tex, uv + u_abDir * (cG + spread * base)).g;
        sum.b += texture(u_tex, uv + u_abDir * (cB + spread * base)).b;
      }
      vec3 col = sum / float(TAPS);

      col *= u_exposure;
      col = (col - 0.5) * CONTRAST + 0.5;
      col = mix(vec3(dot(col, LUMA)), col, SATURATION);

      if (u_mode == 0) {
        uvec3 cell = uvec3(uvec2(gl_FragCoord.xy / u_cell), uint(u_frame));
        col += (hash(cell) - 0.5) * u_grain * DITHER_GAIN;
      } else {
        col *= mix(CRT_GAIN_SCAN, CRT_GAIN_MASK, maskFade);
        col *= 1.0 + BEAM_GLOW * beam;

        col = clamp(col, 0.0, 1.0);
        float steps = LEVELS - 1.0;
        vec3 q = floor((col + (bayer8(floor(coord)) - 0.5) / steps) * steps + 0.5) / steps;
        col = mix(col, clamp(q, 0.0, 1.0), DITHER_MIX);

        vec2 sub = coord * vec2(3.0, 1.0);
        float slot = mod(floor(sub.x), 3.0);
        vec3 mask = vec3(slot == 0.0, slot == 1.0, slot == 2.0);
        vec2 slotUv = fract(sub + cellOffset) * 2.0 - 1.0;
        vec2 border = 1.0 - slotUv * slotUv * MASK_BORDER;
        mask *= border.x * border.y;
        col *= mix(vec3(1.0), 0.25 + 0.75 * mask, MASK * maskFade);

        float line = 0.5 - 0.5 * cos(6.28318530718 * fract(coord.y + cellOffset.y));
        col *= 1.0 - SCANLINES * line * (1.0 - 0.6 * beam);

        vec3 glow = vec3(0.0);
        for (int i = 0; i < 8; i++) {
          float a = 6.28318530718 * (float(i) + 0.5) / 8.0;
          vec2 dir = vec2(cos(a), sin(a)) * BLOOM_RADIUS * u_crtCell / u_res;
          glow += texture(u_tex, v_uv + dir).rgb;
          glow += texture(u_tex, v_uv + dir * 0.5).rgb;
        }
        glow = (glow / 16.0 * u_exposure - 0.5) * CONTRAST + 0.5;
        col += max(glow - BLOOM_THRESHOLD, 0.0) * BLOOM * (1.0 + BLOOM_BEAM * beam);

        col *= 1.0 + (hash(uvec3(0u, 0u, uint(u_screenFrame))) - 0.5) * FLICKER * u_live;

        float r = length(screenPx / u_screen - 0.5);
        col *= 1.0 - VIGNETTE * smoothstep(0.3, 0.72, r);
      }

      outColor = vec4(clamp(col, 0.0, 1.0), 1.0);
    }`;

  // Helpers

  function loopOsc(phase: number, seed: number) {
    return (
      (Math.sin(TAU * (phase + seed * 0.37)) * 0.6 +
        Math.sin(TAU * (2 * phase + seed * 0.71)) * 0.3 +
        Math.sin(TAU * (3 * phase + seed * 0.13)) * 0.15) /
      1.05
    );
  }

  const swatch = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
  function toRgb(css: string): [number, number, number] {
    swatch.clearRect(0, 0, 1, 1);
    swatch.fillStyle = '#000';
    swatch.fillStyle = css.trim();
    swatch.fillRect(0, 0, 1, 1);
    const [r, g, b] = swatch.getImageData(0, 0, 1, 1).data;
    return [r / 255, g / 255, b / 255];
  }

  // Beam

  const scrollState = { y: window.scrollY, t: performance.now(), vel: 0 };
  window.addEventListener(
    'scroll',
    () => {
      const t = performance.now();
      const v = ((window.scrollY - scrollState.y) / Math.max(8, t - scrollState.t)) * 1000;
      scrollState.vel = scrollState.vel * 0.6 + v * 0.4;
      scrollState.y = window.scrollY;
      scrollState.t = t;
    },
    { passive: true },
  );

  const beamState = { y: BEAM_Y, target: BEAM_Y, t: 0, vel: 0 };
  window.addEventListener(
    'pointermove',
    (e) => {
      if (e.pointerType === 'touch') return;
      beamState.target = Math.min(1, Math.max(0, e.clientY / window.innerHeight));
    },
    { passive: true },
  );

  function stepBeam(now: number) {
    if (!beamState.t) beamState.t = now;
    const dt = Math.min(now - beamState.t, 100);
    if (dt <= 0) return;
    beamState.t = now;
    const prev = beamState.y;
    beamState.y += (beamState.target - beamState.y) * (1 - Math.exp(-dt / BEAM_FOLLOW));
    const v = ((beamState.y - prev) / dt) * 1000;
    beamState.vel = beamState.vel * 0.6 + v * 0.4;
  }

  // Element

  class LensFlare extends HTMLElement {
    canvas!: HTMLCanvasElement;
    gl!: WebGL2RenderingContext;
    progField!: WebGLProgram;
    progPost!: WebGLProgram;
    fbo!: WebGLFramebuffer;
    fboTex!: WebGLTexture;
    fbW = 0;
    fbH = 0;
    uf: Record<string, WebGLUniformLocation | null> = {};
    up: Record<string, WebGLUniformLocation | null> = {};
    opts = { ...DEFAULTS, seed: 0 };
    colours = { from: [0, 0, 0], mid: [0, 0, 0], to: [0, 0, 0] } as Record<string, number[]>;
    rafId: number | null = null;
    lastDraw = 0;
    lastTick = 0;
    clock = 0;
    frame = 0;
    visible = false;
    needsRedraw = true;
    io?: IntersectionObserver;
    ro?: ResizeObserver;

    connectedCallback() {
      this.canvas = this.querySelector('canvas')!;
      const gl = this.canvas.getContext('webgl2', { antialias: false, alpha: false });
      if (!gl) return;

      this.gl = gl;
      for (const k of Object.keys(DEFAULTS) as (keyof typeof DEFAULTS)[]) {
        const v = parseFloat(this.dataset[k] ?? '');
        if (!Number.isNaN(v)) this.opts[k] = v;
      }
      this.opts.seed = parseFloat(this.dataset.seed ?? '0') || 0;
      this.readColours();

      this.canvas.addEventListener('webglcontextlost', (e) => {
        e.preventDefault();
        this.pause();
        this.removeAttribute('data-ready');
      });
      this.canvas.addEventListener('webglcontextrestored', () => {
        this.init();
        this.redraw();
      });

      this.init();

      const box = this.getBoundingClientRect();
      if (box.bottom > 0 && box.top < window.innerHeight && box.width > 0) {
        this.visible = true;
        this.draw(this.phase());
      }

      this.io = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible) this.play();
        else this.pause();
      });
      this.io.observe(this);
      this.ro = new ResizeObserver(() => this.redraw());
      this.ro.observe(this);
      reducedMotion.addEventListener('change', this.redraw);
      document.addEventListener('visibilitychange', this.redraw);
      window.addEventListener('scroll', this.onMove, { passive: true });
      window.addEventListener('pointermove', this.onMove, { passive: true });
    }

    disconnectedCallback() {
      this.pause();
      this.io?.disconnect();
      this.ro?.disconnect();
      reducedMotion.removeEventListener('change', this.redraw);
      document.removeEventListener('visibilitychange', this.redraw);
      window.removeEventListener('scroll', this.onMove);
      window.removeEventListener('pointermove', this.onMove);
    }

    readColours() {
      const style = getComputedStyle(this);
      for (const k of ['from', 'mid', 'to']) {
        this.colours[k] = toRgb(style.getPropertyValue(`--lf-${k}`));
      }
    }

    compile(type: number, src: string) {
      const { gl } = this;
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src.trim());
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? '');
      return s;
    }

    link(fs: string) {
      const { gl } = this;
      const p = gl.createProgram()!;
      gl.attachShader(p, this.compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(p, this.compile(gl.FRAGMENT_SHADER, fs));
      gl.bindAttribLocation(p, 0, 'a_pos');
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) ?? '');
      return p;
    }

    init() {
      const { gl } = this;
      this.progField = this.link(FRAG_FIELD);
      this.progPost = this.link(FRAG_POST);
      this.uf = {};
      this.up = {};

      gl.bindVertexArray(gl.createVertexArray());
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

      this.fboTex = gl.createTexture()!;
      gl.bindTexture(gl.TEXTURE_2D, this.fboTex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      this.fbo = gl.createFramebuffer()!;
      gl.bindFramebuffer(gl.FRAMEBUFFER, this.fbo);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, this.fboTex, 0);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);

      this.canvas.width = 0;
    }

    resize() {
      const { gl, canvas } = this;
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      const w = Math.max(1, Math.round(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.round(canvas.clientHeight * dpr));
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      this.fbW = Math.max(1, Math.round(w * FIELD_SCALE));
      this.fbH = Math.max(1, Math.round(h * FIELD_SCALE));
      gl.bindTexture(gl.TEXTURE_2D, this.fboTex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, this.fbW, this.fbH, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
    }

    draw(phase: number) {
      const { gl, opts, colours } = this;
      const uf = (n: string) => (n in this.uf ? this.uf[n] : (this.uf[n] = gl.getUniformLocation(this.progField, n)));
      const up = (n: string) => (n in this.up ? this.up[n] : (this.up[n] = gl.getUniformLocation(this.progPost, n)));
      this.resize();

      gl.bindFramebuffer(gl.FRAMEBUFFER, this.fbo);
      gl.viewport(0, 0, this.fbW, this.fbH);
      gl.useProgram(this.progField);
      gl.uniform2f(uf('u_res'), this.fbW, this.fbH);
      gl.uniform1f(uf('u_phase'), phase);
      gl.uniform1f(uf('u_seed'), opts.seed);
      gl.uniform1f(uf('u_scale'), opts.scale);
      gl.uniform1f(uf('u_darkness'), opts.darkness);
      const crop = Math.min(1, this.fbW / this.fbH / REF_ASPECT);
      gl.uniform1f(uf('u_crop'), crop);
      gl.uniform3fv(uf('u_from'), colours.from);
      gl.uniform3fv(uf('u_mid'), colours.mid);
      gl.uniform3fv(uf('u_to'), colours.to);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, this.canvas.width, this.canvas.height);
      gl.useProgram(this.progPost);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, this.fboTex);
      gl.uniform1i(up('u_tex'), 0);
      gl.uniform1f(up('u_frame'), this.frame++ % 1024);
      let dx = loopOsc(phase, 1);
      if (this.dataset.fringe === 'warm') dx = Math.abs(dx);
      else if (this.dataset.fringe === 'cool') dx = -Math.abs(dx);
      const dy = loopOsc(phase, 4);
      const len = Math.hypot(dx, dy) || 1;
      gl.uniform2f(up('u_abDir'), dx / len / crop, dy / len);
      gl.uniform1f(up('u_exposure'), opts.intensity);
      gl.uniform1f(up('u_grain'), opts.grain);
      gl.uniform1f(up('u_cell'), Math.max(1, this.canvas.height / DITHER_ROWS));
      gl.uniform1i(up('u_mode'), this.dataset.dither === 'crt' ? 1 : 0);
      gl.uniform2f(up('u_res'), this.canvas.width, this.canvas.height);
      const dpr = this.canvas.width / Math.max(1, this.canvas.clientWidth);
      const rect = this.canvas.getBoundingClientRect();
      const now = performance.now() / 1000;
      gl.uniform1f(up('u_crtCell'), CRT_CELL * dpr);
      gl.uniform2f(up('u_origin'), rect.left * dpr, rect.top * dpr);
      gl.uniform2f(up('u_screen'), window.innerWidth * dpr, window.innerHeight * dpr);
      stepBeam(performance.now());
      const scrolling = scrollState.vel * Math.exp(-(performance.now() - scrollState.t) / BEAM_SETTLE);
      const speed = scrolling / window.innerHeight + beamState.vel;
      const pace = Math.min(1, Math.abs(speed) / BEAM_FULL_SPEED);
      const trail = BEAM_TRAIL_REST + (BEAM_TRAIL_MAX - BEAM_TRAIL_REST) * pace;
      gl.uniform1f(up('u_scan'), beamState.y);
      gl.uniform1f(up('u_trail'), speed < 0 ? -trail : trail);
      gl.uniform1f(up('u_beamAmt'), BEAM_REST + (1 - BEAM_REST) * pace);
      gl.uniform1f(up('u_screenFrame'), Math.floor(now * SCREEN_FPS) % 1024);
      gl.uniform1f(up('u_live'), reducedMotion.matches ? 0 : 1);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      this.setAttribute('data-ready', '');
    }

    phase() {
      return ((this.clock / 1000 / this.opts.period + this.opts.seed * 0.137) % 1 + 1) % 1;
    }

    tick = (now: number) => {
      if (!this.visible || document.hidden) {
        this.rafId = null;
        return;
      }
      const still = reducedMotion.matches;
      if (still && !this.needsRedraw) {
        this.rafId = null;
        return;
      }
      this.rafId = requestAnimationFrame(this.tick);
      if (!still) this.clock += this.lastTick ? Math.min(now - this.lastTick, 100) : 0;
      this.lastTick = now;
      if (!still && !this.needsRedraw && now - this.lastDraw < 1000 / FPS_CAP - 1) return;
      this.lastDraw = now;
      this.needsRedraw = false;
      this.draw(this.phase());
    };

    play() {
      if (this.rafId === null) {
        this.lastTick = 0;
        this.rafId = requestAnimationFrame(this.tick);
      }
    }

    pause() {
      if (this.rafId !== null) cancelAnimationFrame(this.rafId);
      this.rafId = null;
    }

    onMove = () => {
      if (this.dataset.dither === 'crt' && !reducedMotion.matches) this.redraw();
    };

    redraw = () => {
      this.needsRedraw = true;
      if (this.visible) this.play();
    };
  }

  customElements.define('lens-flare', LensFlare);
</script>
