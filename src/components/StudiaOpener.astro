---
// Studia's case study opener, in layers so the pieces around the wordmark
// can move (MOTION.md: Live). The neon and wordmark are one image; the rest
// sit on top in Figma px on the 1416 × 812 frame, scaled by --s.
import { Image } from 'astro:assets';
import base from '../assets/work/studia/opener/base.png';
import card from '../assets/work/studia/opener/card.png';
import quote from '../assets/work/studia/opener/quote.png';
import fire from '../assets/work/studia/opener/fire.png';
import tag from '../assets/work/studia/opener/tag.png';

interface Props {
  alt: string;
}
const { alt } = Astro.props;

const W = 1416;
const share = (w: number) => `max(${(w / W).toFixed(4)} * min(100vw - 32px, ${W}px), ${Math.min(1, (w / W) * 2.5) * 375}px)`;
---

<div class="so" role="img" aria-label={alt}>
  <div class="so__window">
    <Image class="so__base" src={base} alt="" widths={[1024, 1600, 2400, base.width]} sizes={share(W)} quality={90} loading="eager" fetchpriority="high" />

    <div class="so__item so__item--card" style="--x: 64; --y: 134; --w: 312; --h: 114; --r: -4deg;">
      <div class="so__drift"><div class="so__arrive"><div class="so__live">
        <div class="so__pane so__pane--glass" style="--radius: 18; --fill: 0.52; --stroke: 2.25;">
          <Image src={card} alt="" widths={[card.width / 2, card.width]} sizes={share(312)} quality={90} />
        </div>
      </div></div></div>
    </div>

    <div class="so__item so__item--quote" style="--x: 1087; --y: 144; --w: 307; --h: 42; --r: 10deg;">
      <div class="so__drift"><div class="so__arrive"><div class="so__live">
        <div class="so__pane so__pane--blur" style="--radius: 36; --fill: 0.68; --stroke: 2.25;">
          <Image src={quote} alt="" widths={[quote.width / 2, quote.width]} sizes={share(307)} quality={90} />
        </div>
      </div></div></div>
    </div>

    <div class="so__item so__item--fire" style="--x: 36; --y: 434; --w: 132; --h: 132; --r: -15deg;">
      <div class="so__drift"><div class="so__arrive"><div class="so__live">
        <div class="so__pane so__pane--glass" style="--radius: 66; --fill: 0.32; --stroke: 1.5;">
          <Image class="so__emoji" src={fire} alt="" widths={[fire.width / 2, fire.width]} sizes={share(132)} quality={90} />
        </div>
        <div class="so__reactions" aria-hidden="true"></div>
      </div></div></div>
    </div>

    {/* Sophia's cursor: the image carries 30px of room for the pointer and shadow */}
    <div class="so__item so__item--cursor" style="--x: 897; --y: 391; --w: 191; --h: 108; --r: 0deg;">
      <div class="so__arrive-x"><div class="so__arrive-y"><div class="so__live">
        <Image src={tag} alt="" widths={[tag.width / 2, tag.width]} sizes={share(191)} quality={90} />
      </div></div></div>
    </div>
  </div>
</div>

<style>
  .so {
    container-type: inline-size;
  }

  .so__window {
    --s: calc(100cqi / 1416);
    position: relative;
    height: calc(812 * var(--s));
    overflow: clip; /* hides the pieces waiting to arrive */
    border-radius: var(--radius-s);
    background-color: oklch(92.8% 0.2202 125); /* #c6ff33, under the image */
  }

  .so__base {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .so__item {
    position: absolute;
    left: calc(var(--x) * var(--s));
    top: calc(var(--y) * var(--s));
    width: calc(var(--w) * var(--s));
    height: calc(var(--h) * var(--s));
  }

  .so__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .so__drift,
  .so__arrive,
  .so__arrive-x,
  .so__arrive-y,
  .so__live {
    width: 100%;
    height: 100%;
  }

  /* Panes */

  /* Glass in CSS, not baked into the images, so it blurs the real wordmark
     as it moves. Rotates about its top left corner, as in Figma */
  .so__pane {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--radius) * var(--s));
    transform-origin: 0 0;
    rotate: var(--r);
    background:
      linear-gradient(135deg, oklch(100% 0 0 / 0.22), oklch(100% 0 0 / 0) 55%),
      oklch(100% 0 0 / var(--fill));
    box-shadow:
      inset 0 0 0 calc(var(--stroke) * var(--s)) oklch(100% 0 0 / 0.4),
      0 calc(6.75 * var(--s)) calc(18 * var(--s)) calc(-3.375 * var(--s)) oklch(19.27% 0.0201 233.09 / 0.2);
  }

  /* Figma's background blur (40) is about half that radius in CSS */
  .so__pane--glass {
    backdrop-filter: blur(calc(16 * var(--s))) saturate(1.15);
  }

  .so__pane--blur {
    backdrop-filter: blur(calc(20 * var(--s)));
  }

  /* Reactions float up from the fire, over everything else */
  .so__item--fire {
    z-index: 1;
  }

  .so__reactions {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .so__reactions :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Arrive */

    .so[data-arrival='waiting'] .so__item--card .so__arrive {
      translate: 0 calc(-300 * var(--s));
      rotate: -6deg;
    }

    .so[data-arrival='waiting'] .so__item--quote .so__arrive {
      translate: 0 calc(-260 * var(--s));
      rotate: 6deg;
    }

    .so[data-arrival='waiting'] .so__item--fire .so__arrive {
      scale: 0;
    }

    .so[data-arrival='arrived'] .so__item--fire .so__arrive {
      transition: scale 760ms var(--ease-bounce) 420ms;
    }

    .so[data-arrival='waiting'] .so__item--cursor .so__arrive-x {
      translate: calc(560 * var(--s)) 0;
    }

    .so[data-arrival='waiting'] .so__item--cursor .so__arrive-y {
      translate: 0 calc(260 * var(--s));
    }

    .so[data-arrival='arrived'] .so__arrive {
      transition:
        translate 1600ms var(--ease-out-expo) var(--delay, 0ms),
        rotate 1600ms var(--ease-out-expo) var(--delay, 0ms);
    }

    .so__item--quote {
      --delay: 140ms;
    }

    .so__item--fire {
      --delay: 280ms;
    }

    /* Separate x and y easings bring the cursor in on a curve */
    .so[data-arrival='arrived'] .so__arrive-x {
      transition: translate 1900ms var(--ease-out-expo) 650ms;
    }

    .so[data-arrival='arrived'] .so__arrive-y {
      transition: translate 1900ms var(--ease-in-out) 650ms;
    }

    /* Live (the cursor and the fire's pops are scripted) */

    .so__item--card .so__live {
      animation: so-float 7.2s var(--ease-in-out) 1.6s infinite alternate;
      --float: 6;
    }

    .so__item--quote .so__live {
      animation: so-float 5.6s var(--ease-in-out) 1.9s infinite alternate-reverse;
      --float: 7;
    }

    .so:not([data-live]) .so__live {
      animation-play-state: paused;
    }

    /* Drift */

    @supports (animation-timeline: view()) {
      .so {
        view-timeline-name: --studia-opener;
      }

      .so__drift {
        animation: so-drift linear both;
        animation-timeline: --studia-opener;
        animation-range: cover 0% cover 100%;
      }

      .so__item--card .so__drift {
        --depth: 36;
      }

      .so__item--quote .so__drift {
        --depth: 24;
      }

      .so__item--fire .so__drift {
        --depth: 56;
      }
    }
  }

  @keyframes so-float {
    from { translate: 0 0; }
    to { translate: 0 calc(var(--float) * var(--s)); }
  }

  @keyframes so-drift {
    from { translate: 0 calc(var(--depth, 0) * var(--s)); }
    to { translate: 0 calc(var(--depth, 0) * -1 * var(--s)); }
  }
</style>

<script>
  import { whenSeen, arrive, reducedMotion, wait, token } from '../scripts/arrival';

  const DRIFT = token('--ease-drift', 'cubic-bezier(0.3, 0.45, 0.2, 1)');

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  for (const opener of document.querySelectorAll<HTMLElement>('.so')) {
    // Live only while it's on screen; `whenLive` waits for it to come back
    let live = false;
    let wake: (() => void) | null = null;
    const whenLive = () => (live ? Promise.resolve() : new Promise<void>((r) => (wake = r)));
    new IntersectionObserver(([entry]) => {
      live = entry.isIntersecting;
      opener.toggleAttribute('data-live', live);
      if (live && wake) (wake(), (wake = null));
    }).observe(opener);

    // Already on screen at load, it skips the arrival
    whenSeen(opener, 0.3).then(async (seen) => {
      if (reducedMotion.matches) return;
      if (seen) {
        arrive(opener);
        await wait(2600);
      }
      wander(opener.querySelector<HTMLElement>('.so__item--cursor .so__live')!);
      react(opener.querySelector<HTMLElement>('.so__item--fire')!);
    });

    // Sophia's cursor, in Figma px from where the tag sits. Moves follow a
    // minimum-jerk profile on a slight curve, timed by distance (Fitts' law)
    async function wander(el: HTMLElement) {
      let x = 0;
      let y = 0;
      const place = (px: number, py: number) => {
        el.style.translate = `calc(${px.toFixed(2)} * var(--s)) calc(${py.toFixed(2)} * var(--s))`;
      };
      const frame = () => new Promise<number>((r) => requestAnimationFrame(r));

      async function move(tx: number, ty: number, duration: number) {
        const sx = x;
        const sy = y;
        const d = Math.hypot(tx - sx, ty - sy);
        // A control point off to one side bends the path a little
        const bend = rand(-0.22, 0.22) * d;
        const cx = (sx + tx) / 2 - ((ty - sy) / (d || 1)) * bend;
        const cy = (sy + ty) / 2 + ((tx - sx) / (d || 1)) * bend;
        let start = 0;
        let t = 0;
        while (t < 1) {
          await whenLive();
          const now = await frame();
          if (!start) start = now;
          t = Math.min(1, (now - start) / duration);
          const e = t * t * t * (10 - 15 * t + 6 * t * t);
          const u = 1 - e;
          x = u * u * sx + 2 * u * e * cx + e * e * tx;
          y = u * u * sy + 2 * u * e * cy + e * e * ty;
          place(x, y);
        }
      }

      async function rest(ms: number) {
        const bx = x;
        const by = y;
        const a = rand(0.004, 0.007);
        const b = rand(0.002, 0.005);
        let start = 0;
        for (;;) {
          await whenLive();
          const now = await frame();
          if (!start) start = now;
          const k = now - start;
          if (k >= ms) break;
          place(bx + Math.sin(k * a) * 0.7, by + Math.sin(k * b + 1) * 0.6);
        }
        place(bx, by);
      }

      for (;;) {
        // Somewhere over the wordmark, not too near where it is now
        let tx = 0;
        let ty = 0;
        do {
          tx = rand(-330, 150);
          ty = rand(-170, 70);
        } while (Math.hypot(tx - x, ty - y) < 50);
        // Drift home now and then, so it never strays for long
        if (Math.random() < 0.2) (tx = rand(-12, 12)), (ty = rand(-8, 8));

        const d = Math.hypot(tx - x, ty - y);
        const duration = 240 + 125 * Math.log2(1 + d / 14);
        if (Math.random() < 0.35) {
          const over = rand(0.04, 0.09);
          await move(tx + (tx - x) * over, ty + (ty - y) * over, duration);
          await move(tx, ty, rand(160, 240));
        } else {
          await move(tx, ty, duration);
        }
        if (Math.random() < 0.3) {
          await rest(rand(180, 420));
          await move(x + rand(-16, 16), y + rand(-10, 10), rand(200, 300));
        }
        await rest(rand(500, 2600));
      }
    }

    async function react(item: HTMLElement) {
      const emoji = item.querySelector<HTMLElement>('.so__emoji')!;
      const stream = item.querySelector<HTMLElement>('.so__reactions')!;
      for (;;) {
        await wait(rand(2600, 5200));
        await whenLive();
        emoji.animate(
          [
            { scale: 1, rotate: '0deg' },
            { scale: 1.34, rotate: '-10deg', offset: 0.28 },
            { scale: 0.9, rotate: '5deg', offset: 0.55 },
            { scale: 1.06, rotate: '-2deg', offset: 0.78 },
            { scale: 1, rotate: '0deg' },
          ],
          { duration: 680, easing: 'ease-out' },
        );
        const ghost = emoji.cloneNode(true) as HTMLElement;
        ghost.removeAttribute('class');
        stream.append(ghost);
        const rise = rand(150, 240);
        const sway = rand(-26, 26);
        const spin = rand(-18, 18);
        const s = 'var(--s)';
        ghost
          .animate(
            [
              { translate: '0 0', scale: 0.6, rotate: '0deg', opacity: 0 },
              { translate: `calc(${sway * 0.4} * ${s}) calc(${-rise * 0.25} * ${s})`, scale: 1.05, rotate: `${spin * 0.5}deg`, opacity: 1, offset: 0.18 },
              { translate: `calc(${-sway * 0.6} * ${s}) calc(${-rise * 0.65} * ${s})`, scale: 0.95, rotate: `${-spin * 0.4}deg`, opacity: 0.9, offset: 0.6 },
              { translate: `calc(${sway} * ${s}) calc(${-rise} * ${s})`, scale: 0.8, rotate: `${spin}deg`, opacity: 0 },
            ],
            { duration: rand(1700, 2300), easing: DRIFT },
          )
          .finished.then(() => ghost.remove());
      }
    }
  }
</script>
