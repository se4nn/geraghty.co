---
import LetsTalk from './LetsTalk.astro';

interface Props {
  email: string;
  label: string;
}

const { email, label } = Astro.props;
---

<section class="footer" aria-label={label}>
  <div class="container inner">
    <slot />
    <LetsTalk email={email} />
  </div>
</section>

<style>
  .footer {
    position: relative;
    overflow-x: clip;
    background-color: var(--bg-dark);
    padding-top: clamp(80px, 10.58vw, 160px);
  }

  .inner {
    container-type: inline-size;
    --three-columns: calc(3 * (100cqi - 4 * var(--grid-gap)) / 5 + 2 * var(--grid-gap));
    --quote-width: var(--three-columns);
    --attribution-width: var(--three-columns);
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer :global(.testimonial[data-arrival='waiting'] .words),
    .footer :global(.testimonial[data-arrival='waiting'] .row) {
      opacity: 0;
    }

    .footer :global(.testimonial[data-arrival='arrived'] .words) {
      --drift: 4rem;
      animation: footer-drift 2200ms var(--ease-drift) both;
    }

    .footer :global(.testimonial[data-arrival='arrived'] .row) {
      --drift: 2rem;
      animation: footer-drift 1800ms var(--ease-drift) 550ms both;
    }
  }

  @keyframes footer-drift {
    from {
      opacity: 0;
      translate: 0 var(--drift);
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 1100px) {
    .inner {
      --quote-width: 100cqi;
    }
  }

  @media (max-width: 700px) {
    .inner {
      --attribution-width: 100cqi;
    }
  }
</style>

<script>
  import { whenSeen, arrive, wait } from '../scripts/arrival';

  const TALK_AFTER_QUOTE = 1300;

  for (const footer of document.querySelectorAll<HTMLElement>('.footer')) {
    const quote = footer.querySelector<HTMLElement>('.testimonial');
    const talk = footer.querySelector<HTMLElement>('.lets-talk');

    const quoteIn = quote
      ? whenSeen(quote, 0.4).then((waited) => {
          if (waited) arrive(quote);
          return waited;
        })
      : Promise.resolve(false);

    if (talk) {
      Promise.all([whenSeen(talk, 0.5), quoteIn.then((waited) => waited && wait(TALK_AFTER_QUOTE))]).then(
        ([waited]) => {
          if (waited) arrive(talk);
        },
      );
    }
  }
</script>
