---
// Dark close to every page: whatever's slotted in (the testimonial on the
// homepage), then "Let's talk." cropped by the bottom of the page.
import LetsTalk from './LetsTalk.astro';

interface Props {
  email: string;
  label: string;
}

const { email, label } = Astro.props;
---

<section class="footer" aria-label={label}>
  <div class="container footer__inner">
    <slot />
    <LetsTalk email={email} />
  </div>
</section>

<style>
  .footer {
    position: relative;
    /* Sideways only: "Let's talk." hangs below the page (LetsTalk) */
    overflow-x: clip;
    background-color: var(--bg-dark);
    padding-top: clamp(80px, 10.58vw, 160px);
  }

  /* The quote and its attribution span the middle three grid columns.
     "Let's talk." is sized from the quote's width so the two always line up. */
  .footer__inner {
    container-type: inline-size;
    --three-columns: calc(3 * (100cqi - 4 * var(--grid-gap)) / 5 + 2 * var(--grid-gap));
    --quote-width: var(--three-columns);
    --attribution-width: var(--three-columns);
  }

  /* Sequence: once the footer is reached, the quote drifts slowly up from
     the base of the page, then its attribution, then "Let's talk." rises
     from below the page edge with its light (see LetsTalk). Played once, and
     only for what wasn't already on screen (src/scripts/arrival.ts). */
  @media (prefers-reduced-motion: no-preference) {
    .footer :global(.testimonial[data-arrival='waiting'] .testimonial__quote),
    .footer :global(.testimonial[data-arrival='waiting'] .testimonial__row) {
      opacity: 0;
    }

    .footer :global(.testimonial[data-arrival='arrived'] .testimonial__quote) {
      --drift: 4rem;
      animation: footer-drift 2200ms var(--ease-drift) both;
    }

    .footer :global(.testimonial[data-arrival='arrived'] .testimonial__row) {
      --drift: 2rem;
      animation: footer-drift 1800ms var(--ease-drift) 550ms both;
    }
  }

  /* Fully there well before it has finished settling */
  @keyframes footer-drift {
    from {
      opacity: 0;
      translate: 0 var(--drift);
    }
    55% {
      opacity: 1;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Tablets and phones: the quote takes the full five columns, while the
     attribution keeps its desktop measure until phones */
  @media (max-width: 1100px) {
    .footer__inner {
      --quote-width: 100cqi;
    }
  }

  @media (max-width: 700px) {
    .footer__inner {
      --attribution-width: 100cqi;
    }
  }
</style>

<script>
  import { whenSeen, arrive, wait } from '../scripts/arrival';

  // "Let's talk." follows the quote: if both come into view together (a jump
  // to the end), it still waits for the quote and its attribution to start
  const TALK_AFTER_QUOTE = 1300;

  for (const footer of document.querySelectorAll<HTMLElement>('.footer')) {
    const quote = footer.querySelector<HTMLElement>('.testimonial');
    const talk = footer.querySelector<HTMLElement>('.lets-talk');

    const quoteIn = quote
      ? whenSeen(quote, 0.4).then((waited) => {
          if (waited) arrive(quote);
          return waited;
        })
      : Promise.resolve(false);

    if (talk) {
      Promise.all([whenSeen(talk, 0.5), quoteIn.then((waited) => waited && wait(TALK_AFTER_QUOTE))]).then(
        ([waited]) => {
          if (waited) arrive(talk);
        },
      );
    }
  }
</script>
