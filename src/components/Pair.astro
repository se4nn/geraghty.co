---
// Two images side by side, half the grid each (Figma: two 684 frames with a
// 48 gap). They stack on phones.
---

<div class="pair"><slot /></div>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 700px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }
  }
</style>
