---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  video: string;
  still: ImageMetadata;
  alt: string;
  scale: number;
  bg: string;
}

const { video, still, alt, scale, bg } = Astro.props;
---

<div class="logo-card" style={`--video-scale: ${scale}; --card-bg: ${bg};`}>
  <Image class="still" src={still} alt={alt} widths={[640, 1342]} sizes="(max-width: 700px) 90vw, 42vw" quality={90} />
  <video class="video" src={video} muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video>
</div>

<style>
  .logo-card {
    display: grid;
    place-items: center;
    aspect-ratio: 684 / 812;
    overflow: clip;
    border-radius: var(--radius-s);
    background-color: var(--card-bg);
  }

  .logo-card > * {
    grid-area: 1 / 1;
    width: calc(var(--video-scale) * 100%);
    height: auto;
  }

  .video {
    visibility: hidden;
    --feather-x: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    --feather-y: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
    mask-image: var(--feather-x), var(--feather-y);
    mask-composite: intersect;
  }

  .logo-card[data-playing] .video {
    visibility: visible;
  }

  .logo-card[data-playing] .still {
    visibility: hidden;
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  for (const card of document.querySelectorAll<HTMLElement>('.logo-card')) {
    const video = card.querySelector('video');
    if (!video || reducedMotion.matches) continue;
    card.dataset.playing = '';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.33 },
    );
    io.observe(card);
  }
</script>
