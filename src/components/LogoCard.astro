---
// The Shuffle logo animation in its brand card (Figma: frame "8" in Mission
// & Branding). The video opens on an empty frame before the logo animates
// in; that's part of the animation, so it plays from the start, once it's
// on screen, and loops. Reduced motion (or no script) shows its last frame.
// The card is the video's own background colour, and the video's edges are
// feathered into it: browsers put video through a different colour path
// from CSS (on wide-gamut screens especially), so an exact match can't be
// guaranteed and a hard edge would show. The logo sits well inside the
// feathered margin.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  video: string;
  still: ImageMetadata;
  alt: string;
  // Video width as a share of the card, so the logo lands at its Figma size
  scale: number;
  bg: string;
}

const { video, still, alt, scale, bg } = Astro.props;
---

<div class="logo-card" style={`--video-scale: ${scale}; --card-bg: ${bg};`}>
  <Image class="logo-card__still" src={still} alt={alt} widths={[640, 1342]} sizes="(max-width: 700px) 90vw, 42vw" quality={90} />
  <video class="logo-card__video" src={video} muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1"></video>
</div>

<style>
  .logo-card {
    display: grid;
    place-items: center;
    aspect-ratio: 684 / 812;
    overflow: clip;
    border-radius: var(--radius-s);
    background-color: var(--card-bg);
  }

  .logo-card > * {
    grid-area: 1 / 1;
    width: calc(var(--video-scale) * 100%);
    height: auto;
  }

  /* Until the script takes over, the finished logo shows */
  .logo-card__video {
    visibility: hidden;
    --feather-x: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    --feather-y: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent);
    mask-image: var(--feather-x), var(--feather-y);
    mask-composite: intersect;
  }

  .logo-card[data-playing] .logo-card__video {
    visibility: visible;
  }

  .logo-card[data-playing] .logo-card__still {
    visibility: hidden;
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  // Swap to the video straight away (its first frame is the empty card, so
  // nothing visibly changes), then play while a third of it is on screen.

  for (const card of document.querySelectorAll<HTMLElement>('.logo-card')) {
    const video = card.querySelector('video');
    if (!video || reducedMotion.matches) continue;
    card.dataset.playing = '';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      },
      { threshold: 0.33 },
    );
    io.observe(card);
  }
</script>
