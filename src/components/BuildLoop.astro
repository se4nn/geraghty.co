---
// Format's component build loop, in motion (Figma: Portfolio › "Steps",
// 2439:20237). Seven steps as a row of numbers along the top; under them,
// the artefacts that step produces (one or two cards); under those, the
// step's name in the serif with a line beneath. The steps come from
// Format's component-build-workflow.md, the examples from its learning log.
//
// Motion: while on screen it plays through the steps, 4.8s each, the active
// step's underline filling in Brand/Blue. Words stay put (the numbers only
// change colour, the step's name swaps in place); the cards lift in on the
// spring, the second a beat after the first. Clicking a number jumps to it
// and holds there.
// Reduced motion: no autoplay and no lift; the numbers still work.
// Built at the grid's 1416 × 812 and scaled as one piece (--u).

interface Line {
  k: string;
  v: string;
}

interface Card {
  file: string;
  lines?: Line[];
  code?: string;
  // Mark this snippet in the code (the value that's wrong)
  mark?: string;
  compare?: 'wrong' | 'right';
}

interface Step {
  title: string;
  line: string;
  cards: Card[];
}

const steps: Step[] = [
  {
    title: 'Read every rule',
    line: 'And the log of past mistakes',
    cards: [
      {
        file: 'design-system-rules.md',
        lines: [
          { k: 'Tokens first.', v: 'No raw colours, spacing or radius in a component.' },
          { k: 'Code owns structure.', v: 'Variants, states and the API.' },
          { k: 'Figma owns values.', v: 'Fonts, padding, colour, radius.' },
        ],
      },
      {
        file: 'learning-log.md',
        lines: [
          { k: 'Mistake:', v: 'Icon stroke width set by reasoning from code.' },
          { k: 'Fix:', v: 'Inspect the rendered SVG.' },
          { k: 'Rule:', v: 'Check what renders before calling an SVG change done.' },
        ],
      },
    ],
  },
  {
    title: 'Spec from Figma',
    line: 'Never from a screenshot',
    cards: [
      {
        file: 'figma · Select',
        lines: [
          { k: 'Assumed:', v: '4 states.' },
          { k: 'In Figma:', v: '6 states.' },
          { k: 'Rule:', v: 'List every variant and state before building.' },
        ],
      },
      {
        file: 'token-mapping',
        lines: [
          { k: 'color/neutral/900', v: '→ var(--neutral-900)' },
          { k: 'spacing/3', v: '→ px-3 · 12px' },
          { k: 'radius/rounded', v: '→ var(--radius)' },
        ],
      },
    ],
  },
  {
    title: 'Build with tokens',
    line: 'No raw values, the standard shadcn API',
    cards: [
      {
        file: 'src/components/ui/button.tsx',
        code: `const buttonVariants = cva(base, {
  variants: {
    variant: { default: 'bg-primary text-primary-foreground' },
    size: { default: 'h-9 px-2 gap-1' },
  },
})`,
        mark: `'h-9 px-2 gap-1'`,
      },
    ],
  },
  {
    title: 'Check what renders',
    line: 'In the browser, against Figma',
    cards: [{ file: 'visual QA · /design/design-system', compare: 'wrong' }],
  },
  {
    title: 'Fix and recheck',
    line: 'Three tries, then it comes to me',
    cards: [
      {
        file: 'button.tsx · iteration 1 of 3',
        code: `-  default: 'h-9 px-2 gap-1',
+  default: 'h-9 px-3 gap-1',`,
      },
      { file: 'visual QA · recheck', compare: 'right' },
    ],
  },
  {
    title: 'Two approval gates',
    line: 'Nothing ships on the AI’s say-so',
    cards: [
      {
        file: 'before building',
        lines: [
          { k: 'Token mapping', v: 'approved' },
          { k: 'Changes to stock shadcn', v: 'approved' },
          { k: 'Proposed API', v: 'approved' },
        ],
      },
      {
        file: 'before it’s done',
        lines: [
          { k: 'Code and live page', v: 'reviewed' },
          { k: 'QA results', v: 'reviewed' },
          { k: 'Known deviations', v: 'reviewed' },
        ],
      },
    ],
  },
  {
    title: 'Write it down',
    line: 'So it can’t happen twice',
    cards: [
      {
        file: 'learning-log.md',
        lines: [
          { k: 'Mistake:', v: 'A merge conflict set a colour token wrong.' },
          { k: 'Rule:', v: 'Check Figma before accepting either side.' },
        ],
      },
      {
        file: 'same pull request',
        lines: [
          { k: 'Component write-up', v: 'added' },
          { k: 'Rulebook and log', v: 'updated' },
          { k: 'Live component library', v: 'updated' },
        ],
      },
    ],
  },
];

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const codeHtml = (card: Card) => {
  let html = escape(card.code!);
  if (card.mark) html = html.replace(escape(card.mark), `<mark>${escape(card.mark)}</mark>`);
  return html
    .replace(/^(-.*)$/gm, '<span class="del">$1</span>')
    .replace(/^(\+.*)$/gm, '<span class="add">$1</span>');
};
---

<div class="build-loop" role="group" aria-label="The component build loop: seven steps, each with what it produces">
  <div class="build-loop__frame">
    <ol class="build-loop__steps" role="list">
      {
        steps.map((step, i) => (
          <li>
            <button class="build-loop__step" type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}. ${step.title}`}>
              {String(i + 1).padStart(2, '0')}
              <span class="build-loop__rail" aria-hidden="true" />
            </button>
          </li>
        ))
      }
    </ol>

    <div class="build-loop__stage">
      {
        steps.map((step, i) => (
          <section class="build-loop__scene" data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class:list={['build-loop__cards', { 'build-loop__cards--one': step.cards.length === 1 }]}>
              {step.cards.map((card) => (
                <div class="build-loop__card">
                  <p class="build-loop__file">{card.file}</p>
                  {card.lines &&
                    card.lines.map((line) => (
                      <p class="build-loop__line">
                        <b>{line.k}</b> {line.v}
                      </p>
                    ))}
                  {card.code && (
                    <pre class="build-loop__code">
                      <code set:html={codeHtml(card)} />
                    </pre>
                  )}
                  {card.compare && (
                    <div class="build-loop__compare">
                      <figure>
                        <span class="build-loop__measure">
                          <span class="pad">12</span>
                          <span class="btn">Button</span>
                          <span class="pad">12</span>
                        </span>
                        <figcaption>Figma</figcaption>
                      </figure>
                      <figure>
                        <span class:list={['build-loop__measure', `build-loop__measure--${card.compare}`]}>
                          <span class="pad">{card.compare === 'wrong' ? '8' : '12'}</span>
                          <span class="btn">Button</span>
                          <span class="pad">{card.compare === 'wrong' ? '8' : '12'}</span>
                        </span>
                        <figcaption>Browser, computed</figcaption>
                      </figure>
                    </div>
                  )}
                </div>
              ))}
            </div>
            <div class="build-loop__caption">
              <p class="build-loop__title">{step.title}</p>
              <p class="build-loop__sub">{step.line}</p>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</div>

<style>
  .build-loop {
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  /* --u is one Figma px at this width */
  .build-loop__frame {
    --u: calc(100cqw / 1416);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: calc(48 * var(--u));
    aspect-ratio: 1416 / 812;
    padding: calc(64 * var(--u));
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
  }

  /* Steps: numbers that only change colour */
  .build-loop__steps {
    display: flex;
    gap: calc(16 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .build-loop__steps li {
    flex: 1;
    min-width: 0;
  }

  .build-loop__step {
    position: relative;
    width: 100%;
    padding: calc(8 * var(--u));
    border: 0;
    border-bottom: 2px solid var(--neutral-300);
    color: var(--neutral-600);
    background: none;
    font: inherit;
    font-size: calc(33 * var(--u));
    line-height: calc(40 / 33);
    font-weight: var(--weight-bold);
    font-feature-settings: 'tnum';
    cursor: pointer;
    transition: color var(--duration-m) var(--ease-out);
  }

  .build-loop__step[aria-pressed='true'] {
    color: var(--neutral-900);
  }

  /* The underline: Brand/Blue under the active step, filling while it plays */
  .build-loop__rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--brand-blue);
    transform: scaleX(0);
    transform-origin: left;
  }

  .build-loop__step[aria-pressed='true'] .build-loop__rail {
    transform: scaleX(1);
  }

  .build-loop__step:focus-visible {
    outline: 2px solid var(--brand-blue);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .build-loop__step:hover {
      color: var(--neutral-900);
    }
  }

  /* Scenes: one step's cards and name at a time */
  .build-loop__stage {
    display: grid;
    min-height: 0;
  }

  .build-loop__scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: calc(48 * var(--u));
    min-height: 0;
    visibility: hidden;
  }

  .build-loop__scene[data-active] {
    visibility: visible;
  }

  .build-loop__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(48 * var(--u));
    align-items: center;
    min-height: 0;
  }

  .build-loop__cards--one {
    grid-template-columns: minmax(0, calc(820 * var(--u)));
    justify-content: center;
  }

  .build-loop__card {
    display: grid;
    gap: calc(16 * var(--u));
    align-content: start;
    min-width: 0;
    padding: calc(32 * var(--u));
    border: 0.5px solid var(--neutral-300);
    border-radius: calc(8 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 calc(9.8 * var(--u)) calc(9.8 * var(--u)) calc(-6.5 * var(--u)) oklch(from var(--neutral-900) l c h / 0.15),
      0 calc(1.6 * var(--u)) calc(1.6 * var(--u)) calc(-1.6 * var(--u)) oklch(from var(--neutral-900) l c h / 0.2);
  }

  .build-loop__file {
    margin: 0;
    color: var(--neutral-600);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: calc(17 * var(--u));
    line-height: calc(24 / 17);
  }

  .build-loop__line {
    margin: 0;
    padding-bottom: calc(16 * var(--u));
    border-bottom: 1px solid var(--neutral-100);
    color: var(--neutral-700);
    font-size: calc(23 * var(--u));
    line-height: calc(32 / 23);
    font-weight: 260;
  }

  .build-loop__line:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .build-loop__line b {
    color: var(--neutral-900);
    font-weight: var(--weight-bold);
  }

  .build-loop__code {
    margin: 0;
    padding: calc(20 * var(--u)) calc(24 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--neutral-100);
    background-color: var(--neutral-900);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: calc(16 * var(--u));
    line-height: 1.55;
    white-space: pre;
    overflow: hidden;
  }

  .build-loop__code :global(mark) {
    color: inherit;
    background: none;
    outline: calc(2 * var(--u)) solid var(--format-red-400);
    outline-offset: calc(2 * var(--u));
    border-radius: calc(3 * var(--u));
  }

  .build-loop__code :global(.del) {
    color: var(--format-red-300);
  }

  .build-loop__code :global(.add) {
    color: var(--format-green-300);
  }

  .build-loop__compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(16 * var(--u));
  }

  .build-loop__compare figure {
    display: grid;
    justify-items: center;
    gap: calc(12 * var(--u));
    margin: 0;
    padding: calc(32 * var(--u)) calc(12 * var(--u)) calc(16 * var(--u));
    border-radius: calc(6 * var(--u));
    background-color: var(--neutral-050);
  }

  .build-loop__compare figcaption {
    color: var(--neutral-600);
    font-size: calc(17 * var(--u));
  }

  .build-loop__measure {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--u));
    font-size: calc(22 * var(--u));
  }

  .build-loop__measure .btn {
    padding: calc(8 * var(--u)) calc(12 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--neutral-000);
    background-color: var(--neutral-900);
  }

  .build-loop__measure .pad {
    min-width: calc(36 * var(--u));
    padding: calc(4 * var(--u)) calc(6 * var(--u));
    border-radius: calc(4 * var(--u));
    color: var(--format-cyan-600);
    background-color: var(--format-cyan-100);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: calc(18 * var(--u));
    text-align: center;
  }

  .build-loop__measure--wrong .pad {
    color: var(--format-red-600);
    background-color: var(--format-red-100);
  }

  .build-loop__measure--right .pad {
    color: var(--format-green-600);
    background-color: var(--format-green-100);
  }

  /* The step's name: H1 serif over an H3 line */
  .build-loop__caption {
    display: grid;
    gap: calc(8 * var(--u));
    justify-items: center;
    text-align: center;
  }

  .build-loop__title {
    margin: 0;
    color: var(--neutral-900);
    font-family: var(--font-serif);
    font-size: calc(57 * var(--u));
    line-height: calc(72 / 57);
    letter-spacing: -0.012em;
    font-variation-settings: normal;
  }

  .build-loop__sub {
    margin: 0;
    color: var(--neutral-600);
    font-size: calc(33 * var(--u));
    line-height: calc(40 / 33);
    font-weight: 260;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Cards lift in on the spring, the second a beat later; they leave quick */
    .build-loop__card {
      opacity: 0;
      transform: translateY(calc(28 * var(--u)));
      transition:
        opacity var(--duration-s) var(--ease-out),
        transform var(--duration-s) var(--ease-out);
    }

    .build-loop__scene[data-active] .build-loop__card {
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-m) var(--ease-out) 80ms,
        transform 720ms var(--ease-spring) 80ms;
    }

    .build-loop__scene[data-active] .build-loop__card:nth-child(2) {
      transition-delay: 200ms;
    }

    .build-loop[data-playing] .build-loop__step[aria-pressed='true'] .build-loop__rail {
      transform: scaleX(0);
      animation: build-loop-fill var(--step-ms, 4800ms) linear forwards;
    }
  }

  @keyframes build-loop-fill {
    to {
      transform: scaleX(1);
    }
  }

  /* Phones: the cards stack and the frame grows to fit them */
  @container (max-width: 720px) {
    .build-loop__frame {
      --u: calc(100cqw / 760);
      aspect-ratio: auto;
      gap: 24px;
      padding: 16px;
    }

    .build-loop__steps {
      gap: 4px;
    }

    .build-loop__step {
      padding: 6px 0;
      font-size: 15px;
    }

    .build-loop__scene {
      gap: 24px;
    }

    .build-loop__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .build-loop__cards--one {
      grid-template-columns: 1fr;
    }

    .build-loop__card {
      padding: 20px;
    }

    .build-loop__line {
      font-size: 15px;
    }

    .build-loop__file {
      font-size: 12px;
    }

    .build-loop__title {
      font-size: 32px;
    }

    .build-loop__sub {
      font-size: 17px;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const STEP_MS = 4800;

  for (const loop of document.querySelectorAll<HTMLElement>('.build-loop')) {
    const buttons = [...loop.querySelectorAll<HTMLButtonElement>('.build-loop__step')];
    const scenes = [...loop.querySelectorAll<HTMLElement>('.build-loop__scene')];
    loop.style.setProperty('--step-ms', `${STEP_MS}ms`);
    let index = 0;
    let timer = 0;
    let inView = false;
    // Set once someone picks a step: it holds there
    let held = reducedMotion.matches;

    const show = (i: number) => {
      index = i;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      scenes.forEach((s, j) => {
        s.toggleAttribute('data-active', j === i);
        if (j === i) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
    };

    const schedule = () => {
      clearTimeout(timer);
      loop.removeAttribute('data-playing');
      if (held || !inView) return;
      // Restart the underline: drop the playing state, then set it next frame
      requestAnimationFrame(() => requestAnimationFrame(() => loop.setAttribute('data-playing', '')));
      timer = window.setTimeout(() => {
        show((index + 1) % scenes.length);
        schedule();
      }, STEP_MS);
    };

    buttons.forEach((button, i) =>
      button.addEventListener('click', () => {
        held = true;
        show(i);
        schedule();
      }),
    );

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.35 },
    ).observe(loop);

    show(0);
  }
</script>
