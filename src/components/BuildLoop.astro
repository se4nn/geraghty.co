---
import Caption from './BuildLoopCaption.astro';

const steps = [
  { title: 'Read every rule', line: 'And the log of past mistakes' },
  { title: 'Spec from Figma', line: 'Never from a screenshot' },
  { title: 'Build with tokens', line: 'No raw values, the standard shadcn API' },
  { title: 'Check what renders', line: 'In the browser, against Figma' },
  { title: 'Fix and recheck', line: 'Three tries, then it comes to me' },
  { title: 'Two approval gates', line: 'Nothing ships on the AI’s say-so' },
  { title: 'Write it down', line: 'So it can’t happen twice' },
];
---

<div class="build-loop" role="group" aria-label="The component build loop: seven steps, each with what it produces">
  <div class="frame">
    <ol class="steps" role="list">
      {
        steps.map((step, i) => (
          <li>
            <button class="step" type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}. ${step.title}`}>
              {String(i + 1).padStart(2, '0')}
              <span class="rail" aria-hidden="true" />
            </button>
          </li>
        ))
      }
    </ol>

    <div class="stage">
      <section class="scene" data-active="">
        <div class="cards">
          <div class="card">
            <p class="file"><span class="dot" />design-system-rules.md</p>
            <ul class="rules" role="list">
              <li><b>Tokens first.</b> No raw colours, spacing or radius in a component.</li>
              <li><b>Code owns structure.</b> Variants, states and the API.</li>
              <li><b>Figma owns values.</b> Fonts, padding, colour, radius.</li>
            </ul>
          </div>
          <div class="card">
            <p class="file"><span class="dot log" />learning-log.md</p>
            <p class="entry-title">Icon stroke width</p>
            <p class="entry">Set by reasoning from the code, not by looking at the rendered SVG.</p>
            <p class="rule"><b>Rule:</b> check what renders before calling an SVG change done.</p>
          </div>
        </div>
        <Caption {...steps[0]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot figma" />Figma · Button</p>
            <div class="mock-buttons">
              <span class="mock-button">Default</span>
              <span class="mock-button outline">Outline</span>
              <span class="mock-button ghost">Ghost</span>
              <span class="mock-button danger">Destructive</span>
              <span class="states">6 states · not the 4 I’d assumed</span>
            </div>
            <table class="table">
              <thead><tr><th>Figma</th><th>Code</th></tr></thead>
              <tbody>
                <tr><td>color/neutral/900</td><td>var(--neutral-900)</td></tr>
                <tr><td>spacing/3</td><td>px-3 · 12px</td></tr>
                <tr><td>radius/rounded</td><td>var(--radius)</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <Caption {...steps[1]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot code" />src/components/ui/button.tsx</p>
            <pre class="snippet"><code><span class="keyword">const</span> buttonVariants = <span class="function">cva</span>(base, {'{'}
  variants: {'{'}
    variant: {'{'} default: <span class="string">'bg-primary text-primary-foreground'</span> {'}'},
    size: {'{'} default: <span class="string flag">'h-9 px-2 gap-1'</span> {'}'},
  {'}'},
{'}'})</code></pre>
          </div>
        </div>
        <Caption {...steps[2]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot qa" />Visual QA · /design/design-system</p>
            <div class="comparison">
              <figure><span class="measure"><span class="padding">12</span><span class="measured">Button</span><span class="padding">12</span></span><figcaption>Figma</figcaption></figure>
              <figure><span class="measure wrong"><span class="padding">8</span><span class="measured">Button</span><span class="padding">8</span></span><figcaption>Browser, computed</figcaption></figure>
            </div>
            <p class="status fail">1 issue · padding 8px, spec 12px</p>
          </div>
        </div>
        <Caption {...steps[3]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot qa" />Visual QA · iteration 1 of 3</p>
            <pre class="snippet diff"><code><span class="removed">-  default: 'h-9 px-2 gap-1',</span>
<span class="added">+  default: 'h-9 px-3 gap-1',</span></code></pre>
            <div class="comparison">
              <figure><span class="measure"><span class="padding">12</span><span class="measured">Button</span><span class="padding">12</span></span><figcaption>Figma</figcaption></figure>
              <figure><span class="measure right"><span class="padding">12</span><span class="measured">Button</span><span class="padding">12</span></span><figcaption>Browser, computed</figcaption></figure>
            </div>
            <p class="status pass">All variants match</p>
          </div>
        </div>
        <Caption {...steps[4]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot gate" />Approval gates · Button</p>
            <div class="gates">
              <div>
                <p class="gate-title">Before building</p>
                <ul class="checks" role="list">
                  <li>Token mapping</li>
                  <li>Changes to stock shadcn</li>
                  <li>Proposed API</li>
                </ul>
              </div>
              <div>
                <p class="gate-title">Before it’s done</p>
                <ul class="checks" role="list">
                  <li>Code and live page</li>
                  <li>QA results</li>
                  <li>Known deviations</li>
                </ul>
              </div>
            </div>
            <p class="status pass">Approved by me, not the AI</p>
          </div>
        </div>
        <Caption {...steps[5]} />
      </section>

      <section class="scene" aria-hidden="true">
        <div class="cards one">
          <div class="card">
            <p class="file"><span class="dot log" />learning-log.md · same pull request</p>
            <p class="entry-title">Token merge conflict</p>
            <p class="entry">A merge conflict set a colour token to the wrong value.</p>
            <p class="rule"><b>Rule:</b> check Figma before accepting either side of a token conflict.</p>
            <div class="chips">
              <span>Component write-up</span>
              <span>Rulebook updated</span>
              <span>Live library updated</span>
            </div>
          </div>
        </div>
        <Caption {...steps[6]} />
      </section>
    </div>
  </div>
</div>

<style>
  .build-loop {
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .frame {
    --u: calc(100cqw / 1416);
    display: grid;
    grid-template-rows: auto 1fr;
    gap: calc(48 * var(--u));
    aspect-ratio: 1416 / 812;
    padding: calc(64 * var(--u));
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
  }

  /* Steps */

  .steps {
    display: flex;
    gap: calc(16 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    flex: 1;
    min-width: 0;
  }

  .step {
    position: relative;
    width: 100%;
    padding: calc(8 * var(--u));
    border: 0;
    border-bottom: 2px solid var(--neutral-300);
    color: var(--neutral-600);
    background: none;
    font: inherit;
    font-size: calc(33 * var(--u));
    line-height: calc(40 / 33);
    font-weight: var(--weight-bold);
    font-feature-settings: 'tnum';
    cursor: pointer;
    transition: color var(--duration-m) var(--ease-out);
  }

  .step[aria-pressed='true'] {
    color: var(--neutral-900);
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--brand-blue);
    transform: scaleX(0);
    transform-origin: left;
  }

  .step[aria-pressed='true'] .rail {
    transform: scaleX(1);
  }

  .step:focus-visible {
    outline: 2px solid var(--brand-blue);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .step:hover {
      color: var(--neutral-900);
    }
  }

  /* Scenes */

  .stage {
    display: grid;
    min-height: 0;
  }

  .scene {
    grid-area: 1 / 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: calc(48 * var(--u));
    min-height: 0;
    visibility: hidden;
  }

  .scene[data-active] {
    visibility: visible;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(48 * var(--u));
    align-items: center;
    min-height: 0;
  }

  .cards.one {
    grid-template-columns: minmax(0, calc(820 * var(--u)));
    justify-content: center;
  }

  .card {
    display: grid;
    gap: calc(16 * var(--u));
    align-content: start;
    min-width: 0;
    padding: calc(32 * var(--u));
    border: 0.5px solid var(--neutral-300);
    border-radius: calc(8 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 calc(9.8 * var(--u)) calc(9.8 * var(--u)) calc(-6.5 * var(--u)) oklch(from var(--neutral-900) l c h / 0.15),
      0 calc(1.6 * var(--u)) calc(1.6 * var(--u)) calc(-1.6 * var(--u)) oklch(from var(--neutral-900) l c h / 0.2);
  }

  /* Card Contents */

  .file {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    margin: 0;
    color: var(--neutral-600);
    font-family: var(--font-mono);
    font-size: calc(17 * var(--u));
    line-height: calc(24 / 17);
  }

  .dot {
    width: calc(10 * var(--u));
    height: calc(10 * var(--u));
    border-radius: 50%;
    background-color: var(--neutral-300);
  }

  .dot.log { background-color: var(--format-yellow-500); }
  .dot.figma { background-color: var(--format-magenta-500); }
  .dot.code { background-color: var(--format-cyan-500); }
  .dot.qa { background-color: var(--format-red-500); }
  .dot.gate { background-color: var(--format-green-500); }

  .rules,
  .checks {
    display: grid;
    gap: calc(14 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--neutral-700);
    font-size: calc(21 * var(--u));
    line-height: 1.4;
    font-weight: 260;
  }

  .rules li,
  .checks li {
    padding-bottom: calc(14 * var(--u));
    border-bottom: 1px solid var(--neutral-100);
  }

  .rules li:last-child,
  .checks li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .rules b,
  .rule b {
    color: var(--neutral-900);
    font-weight: var(--weight-bold);
  }

  .checks li {
    display: flex;
    gap: calc(12 * var(--u));
    color: var(--neutral-900);
  }

  .checks li::before {
    content: '✓';
    color: var(--format-green-600);
    font-weight: var(--weight-bold);
  }

  .gates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(32 * var(--u));
  }

  .gate-title {
    margin: 0 0 calc(14 * var(--u));
    color: var(--neutral-600);
    font-size: calc(17 * var(--u));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .entry-title {
    margin: 0;
    color: var(--neutral-900);
    font-size: calc(27 * var(--u));
    line-height: 1.2;
    font-weight: var(--weight-bold);
  }

  .entry {
    margin: 0;
    color: var(--neutral-700);
    font-size: calc(21 * var(--u));
    line-height: 1.4;
    font-weight: 260;
  }

  .rule {
    margin: 0;
    padding-left: calc(18 * var(--u));
    border-left: calc(3 * var(--u)) solid var(--format-yellow-500);
    color: var(--neutral-700);
    font-size: calc(21 * var(--u));
    line-height: 1.4;
    font-weight: 260;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(8 * var(--u));
  }

  .chips span {
    padding: calc(4 * var(--u)) calc(12 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--format-green-600);
    background-color: var(--format-green-100);
    font-size: calc(16 * var(--u));
  }

  .mock-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(12 * var(--u));
  }

  .mock-button {
    padding: calc(8 * var(--u)) calc(14 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--neutral-000);
    background-color: var(--format-neutral-900);
    font-size: calc(18 * var(--u));
    line-height: 1.2;
  }

  .mock-button.outline {
    color: var(--format-neutral-900);
    background: none;
    box-shadow: inset 0 0 0 1px var(--format-neutral-300);
  }

  .mock-button.ghost {
    color: var(--format-neutral-900);
    background-color: var(--format-neutral-100);
  }

  .mock-button.danger {
    background-color: var(--format-red-600);
  }

  .states {
    margin-left: auto;
    color: var(--format-magenta-600);
    font-size: calc(16 * var(--u));
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: calc(16 * var(--u));
  }

  .table th {
    color: var(--neutral-600);
    font-weight: normal;
    text-align: left;
  }

  .table th,
  .table td {
    padding: calc(10 * var(--u)) 0;
    border-bottom: 1px solid var(--neutral-100);
  }

  .snippet {
    margin: 0;
    padding: calc(20 * var(--u)) calc(24 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--neutral-100);
    background-color: var(--format-neutral-900);
    font-family: var(--font-mono);
    font-size: calc(17 * var(--u));
    line-height: 1.6;
    white-space: pre;
    overflow: hidden;
  }

  .keyword { color: var(--format-magenta-300); }
  .function { color: var(--format-cyan-300); }
  .string { color: var(--format-yellow-300); }
  .removed { color: var(--format-red-300); }
  .added { color: var(--format-green-300); }

  .flag {
    outline: calc(2 * var(--u)) solid var(--format-red-400);
    outline-offset: calc(2 * var(--u));
    border-radius: calc(3 * var(--u));
  }

  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(16 * var(--u));
  }

  .comparison figure {
    display: grid;
    justify-items: center;
    gap: calc(12 * var(--u));
    margin: 0;
    padding: calc(32 * var(--u)) calc(12 * var(--u)) calc(16 * var(--u));
    border-radius: calc(6 * var(--u));
    background-color: var(--neutral-050);
  }

  .comparison figcaption {
    color: var(--neutral-600);
    font-size: calc(17 * var(--u));
  }

  .measure {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--u));
    font-size: calc(22 * var(--u));
  }

  .measure .measured {
    padding: calc(8 * var(--u)) calc(12 * var(--u));
    border-radius: calc(6 * var(--u));
    color: var(--neutral-000);
    background-color: var(--format-neutral-900);
  }

  .measure .padding {
    min-width: calc(36 * var(--u));
    padding: calc(4 * var(--u)) calc(6 * var(--u));
    border-radius: calc(4 * var(--u));
    color: var(--format-cyan-600);
    background-color: var(--format-cyan-100);
    font-family: var(--font-mono);
    font-size: calc(18 * var(--u));
    text-align: center;
  }

  .measure.wrong .padding {
    color: var(--format-red-600);
    background-color: var(--format-red-100);
  }

  .measure.right .padding {
    color: var(--format-green-600);
    background-color: var(--format-green-100);
  }

  .status {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    margin: 0;
    font-size: calc(19 * var(--u));
  }

  .status::before {
    content: '';
    width: calc(10 * var(--u));
    height: calc(10 * var(--u));
    border-radius: 50%;
  }

  .status.fail { color: var(--format-red-600); }
  .status.fail::before { background-color: var(--format-red-500); }
  .status.pass { color: var(--format-green-600); }
  .status.pass::before { background-color: var(--format-green-500); }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      opacity: 0;
      transform: translateY(calc(28 * var(--u)));
      transition:
        opacity var(--duration-s) var(--ease-out),
        transform var(--duration-s) var(--ease-out);
    }

    .scene[data-active] .card {
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-m) var(--ease-out) 80ms,
        transform 720ms var(--ease-spring) 80ms;
    }

    .scene[data-active] .card:nth-child(2) {
      transition-delay: 200ms;
    }

    .build-loop[data-playing] .step[aria-pressed='true'] .rail {
      transform: scaleX(0);
      animation: build-loop-fill var(--step-ms, 4800ms) linear forwards;
    }
  }

  @keyframes build-loop-fill {
    to {
      transform: scaleX(1);
    }
  }

  /* Phones */

  @container (max-width: 720px) {
    .frame {
      --u: calc(100cqw / 760);
      aspect-ratio: auto;
      gap: 24px;
      padding: 16px;
    }

    .steps {
      gap: 4px;
    }

    .step {
      padding: 6px 0;
      font-size: 15px;
    }

    .scene {
      gap: 24px;
    }

    .cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .cards.one {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 20px;
    }

    .card {
      --u: calc(100cqw / 520);
    }

    .gates {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  const STEP_MS = 4800;

  for (const loop of document.querySelectorAll<HTMLElement>('.build-loop')) {
    const buttons = [...loop.querySelectorAll<HTMLButtonElement>('.step')];
    const scenes = [...loop.querySelectorAll<HTMLElement>('.scene')];
    loop.style.setProperty('--step-ms', `${STEP_MS}ms`);
    let index = 0;
    let timer = 0;
    let inView = false;
    let held = reducedMotion.matches;

    const show = (i: number) => {
      index = i;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      scenes.forEach((s, j) => {
        s.toggleAttribute('data-active', j === i);
        if (j === i) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
    };

    const schedule = () => {
      clearTimeout(timer);
      loop.removeAttribute('data-playing');
      if (held || !inView) return;
      requestAnimationFrame(() => requestAnimationFrame(() => loop.setAttribute('data-playing', '')));
      timer = window.setTimeout(() => {
        show((index + 1) % scenes.length);
        schedule();
      }, STEP_MS);
    };

    buttons.forEach((button, i) =>
      button.addEventListener('click', () => {
        held = true;
        show(i);
        schedule();
      }),
    );

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.35 },
    ).observe(loop);

    show(0);
  }
</script>
