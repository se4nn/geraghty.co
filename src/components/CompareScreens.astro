---
// Two exports of the same panel either side of a divider you drag. Each is the
// whole panel at the same framing, so only the clip moves. Sits inside a Crop
// like a CropImage (rect in Figma px, scaled by --s).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Side {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  left: Side;
  right: Side;
  rect: [number, number, number, number];
  window?: number;
  /** what the input announces, e.g. "Compare the student and parent dashboards" */
  name: string;
  /** where the divider starts, as a % of the width */
  start?: number;
}

const { left, right, rect, window = 1416, name, start = 50 } = Astro.props;
const [x, y, w, h] = rect;
const share = +(w / window).toFixed(4);
const sizes = `max(${share} * min(100vw - 32px, 1416px), ${share * 375}px)`;
const widthsFor = (src: ImageMetadata) => {
  const widths = [640, 1024, 1600, 2400, 2880, 3200, 4000].filter((n) => n < src.width);
  widths.push(src.width);
  return widths;
};
---

<div class="compare" style={`--x: ${x}; --y: ${y}; --iw: ${w}; --ih: ${h}; --pos: ${start}%;`}>
  <Image class="compare__side" src={left.src} alt={left.alt} widths={widthsFor(left.src)} sizes={sizes} quality={90} loading="lazy" />
  <Image class="compare__side compare__side--right" src={right.src} alt={right.alt} widths={widthsFor(right.src)} sizes={sizes} quality={90} loading="lazy" />
  <div class="compare__divider" aria-hidden="true">
    <span class="compare__knob">
      <svg viewBox="0 0 18 12" fill="none"><path d="M12 11L17 6L12 1M6 11L1 6L6 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </div>
  <input class="compare__input" type="range" min="0" max="100" value={start} step="1" aria-label={name} />
</div>

<style>
  .compare {
    position: absolute;
    left: calc(var(--x) * var(--s));
    top: calc(var(--y) * var(--s));
    width: calc(var(--iw) * var(--s));
    height: calc(var(--ih) * var(--s));
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .compare :global(.compare__side) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .compare :global(.compare__side--right) {
    clip-path: inset(0 0 0 var(--pos));
  }

  /* Divider */

  .compare__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: max(calc(2 * var(--s)), 1px);
    translate: -50% 0;
    background-color: var(--neutral-300);
    box-shadow: calc(4 * var(--s)) 0 calc(12 * var(--s)) oklch(0% 0 0 / 0.25);
  }

  .compare__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: max(calc(48 * var(--s)), 36px);
    aspect-ratio: 1;
    border: max(calc(2 * var(--s)), 1.5px) solid var(--neutral-300);
    border-radius: 50%;
    background-color: var(--neutral-050);
    color: var(--neutral-900);
    box-shadow: calc(4 * var(--s)) 0 calc(12 * var(--s)) calc(-4 * var(--s)) oklch(0% 0 0 / 0.25);
    transition: scale 400ms var(--ease-spring);
  }

  .compare__knob svg {
    width: calc(18 / 48 * 100%);
  }

  .compare:hover .compare__knob,
  .compare[data-dragging] .compare__knob {
    scale: 1.08;
  }

  .compare__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .compare:has(.compare__input:focus-visible) .compare__knob {
    outline: 2px solid var(--neutral-900);
    outline-offset: 3px;
  }

  /* Eased while it glides (hint, taps, keys); instant under the pointer */
  @media (prefers-reduced-motion: no-preference) {
    .compare[data-glide] :global(.compare__side--right) {
      transition: clip-path 900ms var(--ease-out-expo);
    }

    .compare[data-glide] .compare__divider {
      transition: left 900ms var(--ease-out-expo);
    }
  }
</style>

<script>
  import { whenSeen } from '../scripts/arrival';

  for (const el of document.querySelectorAll<HTMLElement>('.compare')) {
    const input = el.querySelector<HTMLInputElement>('.compare__input')!;
    const start = Number(input.value);
    const set = (pct: number) => {
      const v = Math.min(100, Math.max(0, pct));
      el.style.setProperty('--pos', `${v}%`);
      input.value = String(Math.round(v));
    };
    const fromPointer = (e: PointerEvent) => {
      const r = el.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };
    const beginDrag = (e: PointerEvent) => {
      dragging = true;
      el.dataset.dragging = '';
      delete el.dataset.glide;
      el.setPointerCapture(e.pointerId);
    };

    let startX = 0;
    let startY = 0;
    let dragging = false;
    let pointer: number | null = null;

    el.addEventListener('pointerdown', (e) => {
      pointer = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      // Mice drag straight away; touch waits to see if it's a sideways drag
      if (e.pointerType === 'mouse') {
        beginDrag(e);
        fromPointer(e);
      }
    });
    el.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pointer) return;
      if (!dragging) {
        const dx = Math.abs(e.clientX - startX);
        const dy = Math.abs(e.clientY - startY);
        if (dx < 6 || dx < dy) return;
        beginDrag(e);
      }
      fromPointer(e);
    });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== pointer) return;
      // A tap glides the divider to where you tapped
      if (!dragging && e.type === 'pointerup') {
        el.dataset.glide = '';
        fromPointer(e);
      }
      dragging = false;
      pointer = null;
      delete el.dataset.dragging;
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);

    input.addEventListener('input', () => {
      el.dataset.glide = '';
      set(Number(input.value));
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      el.dataset.glide = '';
      set(Number(input.value) + (e.key === 'ArrowRight' ? 5 : -5));
    });
    el.addEventListener('click', () => input.focus({ preventScroll: true }));

    // On first sight, a nudge each way says it can be dragged
    whenSeen(el, 0.4).then((seen) => {
      if (!seen) return;
      el.dataset.glide = '';
      set(start - 14);
      setTimeout(() => set(start + 14), 700);
      setTimeout(() => set(start), 1400);
    });
  }
</script>
