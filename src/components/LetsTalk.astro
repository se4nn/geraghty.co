---
// "Let's talk." in the Footer, cropped by the bottom of the page and lit from
// below (MOTION.md: Light, Overscroll). SVG text: what it paints outside its
// frame doesn't lengthen the page, where HTML text would.
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="lets-talk">
  <div class="lets-talk__light" aria-hidden="true">
    <div class="lets-talk__glow"></div>
  </div>
  <div class="lets-talk__crop">
    <a class="lets-talk__link" href={`mailto:${email}`} aria-label="Let’s talk.">
      <svg class="lets-talk__word" aria-hidden="true"><text x="50%" y="1.028em" text-anchor="middle">Let’s talk.</text></svg>
    </a>
  </div>
</div>

<style>
  .lets-talk {
    position: relative;
    /* The word is 3.195em wide: 95% of the quote's width, capped at display size */
    font-size: min(var(--display-size), var(--quote-width, 100%) * 0.95 / 3.195);
    /* At 200px type: a 120px gap, then 120px of the 160px line shows. The box
       is the line's middle 0.4em; the 0.2em over it shows above the box */
    margin-top: 0.8em;
    height: 0.4em;
  }

  /* Light */

  /* Clipped: a box left hanging below would make the page longer */
  .lets-talk__light {
    position: absolute;
    left: 50%;
    top: -3em;
    bottom: 0;
    width: 100vw;
    translate: -50% 0;
    overflow: clip;
    pointer-events: none;
  }

  .lets-talk__glow {
    position: absolute;
    left: 0;
    top: 2.76em;
    width: 100%;
    height: 3.2em;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), var(--neutral-1000));
    filter: blur(1em);
    pointer-events: none;
  }

  /* The hot core that warms and pulses on hover */
  .lets-talk__glow::after {
    /* Centred on the word's visible band, not the glow, mostly below the page */
    content: '';
    position: absolute;
    top: -5%;
    left: 22%;
    width: 56%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), transparent);
    opacity: 0;
    transition: opacity var(--duration-m) var(--ease-out);
  }

  .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
    opacity: 0.75;
    transition-duration: var(--duration-l);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
      /* Starts once the core has warmed */
      animation: lets-talk-pulse 4.8s var(--ease-in-out) 600ms infinite;
    }

    /* Sequence (MOTION.md); Footer sets data-arrival */
    .lets-talk[data-arrival='waiting'] .lets-talk__link {
      translate: 0 0.8em;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__link {
      animation: lets-talk-word 1800ms var(--ease-drift) both;
    }

    .lets-talk[data-arrival='waiting'] .lets-talk__glow {
      opacity: 0.1;
      translate: 0 12%;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__glow {
      animation: lets-talk-rise 2200ms var(--ease-drift) both;
    }

    /* At rest (MOTION.md: Light): two loops that don't line up, so it never
       visibly repeats. Opacity only, so it costs nothing to draw */
    .lets-talk__light {
      animation: lets-talk-tv 9.7s linear infinite;
    }

    .lets-talk__glow::before {
      animation: lets-talk-tv-tint 6.1s linear infinite;
    }
  }

  /* The cooler, whiter light, over the neon */
  .lets-talk__glow::before {
    content: '';
    position: absolute;
    inset: 10% 15% 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(from var(--brand-neon) calc(l + 0.06) calc(c * 0.35) calc(h + 40)), transparent);
    opacity: 0;
  }

  @keyframes lets-talk-tv {
    0% { opacity: 1; }
    4% { opacity: 0.93; }
    6% { opacity: 0.97; }
    11% { opacity: 0.9; }
    11.4% { opacity: 1; }
    17% { opacity: 0.95; }
    22% { opacity: 0.98; }
    22.3% { opacity: 0.78; }
    27% { opacity: 0.82; }
    27.3% { opacity: 0.96; }
    33% { opacity: 0.92; }
    38% { opacity: 1; }
    41% { opacity: 0.94; }
    41.3% { opacity: 0.99; }
    48% { opacity: 0.9; }
    54% { opacity: 0.96; }
    54.2% { opacity: 0.86; }
    60% { opacity: 0.93; }
    66% { opacity: 0.97; }
    66.3% { opacity: 1; }
    72% { opacity: 0.91; }
    77% { opacity: 0.95; }
    77.2% { opacity: 0.74; }
    81% { opacity: 0.8; }
    81.3% { opacity: 0.98; }
    88% { opacity: 0.93; }
    94% { opacity: 0.99; }
    100% { opacity: 1; }
  }

  @keyframes lets-talk-tv-tint {
    0% { opacity: 0; }
    14% { opacity: 0.1; }
    14.4% { opacity: 0.32; }
    24% { opacity: 0.26; }
    31% { opacity: 0.3; }
    31.3% { opacity: 0.04; }
    46% { opacity: 0.08; }
    58% { opacity: 0.18; }
    58.4% { opacity: 0.4; }
    67% { opacity: 0.34; }
    67.3% { opacity: 0.12; }
    80% { opacity: 0.16; }
    86% { opacity: 0.06; }
    100% { opacity: 0; }
  }

  @keyframes lets-talk-word {
    from {
      translate: 0 0.8em;
    }
  }

  @keyframes lets-talk-rise {
    from {
      opacity: 0.1;
      translate: 0 12%;
    }
  }

  /* Every move at least half a second, so it reads as talking, not flicker */
  @keyframes lets-talk-pulse {
    0%,
    100% {
      scale: 1;
    }
    22% {
      scale: 1.1;
    }
    34% {
      scale: 1.03;
    }
    46% {
      scale: 1.08;
    }
    60% {
      scale: 1;
    }
    82% {
      scale: 1.12;
    }
  }

  /* Word */

  /* Room above the line for the capitals, down to the page edge. Cropped only
     while the word rises */
  .lets-talk__crop {
    position: absolute;
    inset: -0.5em 0 0;
  }

  .lets-talk[data-arrival]:not([data-settled]) .lets-talk__crop {
    overflow: clip;
  }

  .lets-talk__link {
    position: relative;
    display: block;
    height: 100%;
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    color: var(--brand-neon);
  }

  /* The frame is the crop; the baseline sits where it did in the 0.8em line
     (0.128em under the page edge), and the rest of the word hangs below */
  .lets-talk__word {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: currentColor;
  }

  .lets-talk__link:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 8px;
  }
</style>

<script>
  // Once risen, the crop lets go, so an overscroll can show the rest
  for (const talk of document.querySelectorAll<HTMLElement>('.lets-talk')) {
    talk.querySelector('.lets-talk__link')?.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName.includes('lets-talk-word')) talk.toggleAttribute('data-settled', true);
    });
  }
</script>
