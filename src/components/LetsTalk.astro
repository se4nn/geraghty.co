---
// Figma: "Let's talk." The word is cropped by the bottom of the page
// and lit from below by a blurred neon ellipse, which flickers like the
// light from a television.
//
// The page ends where the word is cropped, but the rest of the word is
// still there below it: pull past the bottom of the page (the bounce of an
// overscroll) and it shows. The word is SVG text: what an SVG paints
// outside its own frame never makes the page longer, where text spilling
// out of its box does (browsers count a line's full font height). Only
// while the word rises into place is it cropped for real (data-arrival,
// until settled).
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="lets-talk">
  <div class="lets-talk__light" aria-hidden="true">
    <div class="lets-talk__glow"></div>
  </div>
  <div class="lets-talk__crop">
    <a class="lets-talk__link" href={`mailto:${email}`} aria-label="Let’s talk.">
      <svg class="lets-talk__word" aria-hidden="true"><text x="50%" y="1.028em" text-anchor="middle">Let’s talk.</text></svg>
    </a>
  </div>
</div>

<style>
  .lets-talk {
    position: relative;
    /* "Let's talk." is 3.195em wide. Size it to fill 95% of the quote above,
       never larger than the display size. */
    font-size: min(var(--display-size), var(--quote-width, 100%) * 0.95 / 3.195);
    /* 120px gap above the 160px line, 120px of it visible, at 200px type.
       The box is the visible band: 0.4em, the line's middle 0.4em with
       0.2em over it, so the word sits as it did in a 0.8em line */
    margin-top: 0.8em;
    height: 0.4em;
  }

  /* The light, cropped by the page edge (it's a box, so left hanging it
     would make the page longer) */
  .lets-talk__light {
    position: absolute;
    left: 50%;
    top: -3em;
    bottom: 0;
    width: 100vw;
    translate: -50% 0;
    overflow: clip;
    pointer-events: none;
  }

  .lets-talk__glow {
    position: absolute;
    left: 0;
    top: 2.76em;
    width: 100%;
    height: 3.2em;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), var(--neutral-1000));
    filter: blur(1em);
    pointer-events: none;
  }

  /* A hotter core that answers the pointer: the light warms up under
     "Let's talk." on hover, then keeps pulsing on an uneven beat, like
     someone talking, until it's left. Cools a little quicker than it warms. */
  .lets-talk__glow::after {
    /* Centred on the visible band of the word, not the whole glow, most
       of which sits below the page */
    content: '';
    position: absolute;
    top: -5%;
    left: 22%;
    width: 56%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), transparent);
    opacity: 0;
    transition: opacity var(--duration-m) var(--ease-out);
  }

  .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
    opacity: 0.75;
    transition-duration: var(--duration-l);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
      /* Waits for the core to warm up, then starts on a slow breath in */
      animation: lets-talk-pulse 4.8s var(--ease-in-out) 600ms infinite;
    }

    /* Last in the footer's arrival sequence (Footer sets data-arrival):
       the word rises from below the page edge that crops it, and the light
       swells up behind it */
    .lets-talk[data-arrival='waiting'] .lets-talk__link {
      translate: 0 0.8em;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__link {
      animation: lets-talk-word 1800ms var(--ease-drift) both;
    }

    .lets-talk[data-arrival='waiting'] .lets-talk__glow {
      opacity: 0.1;
      translate: 0 12%;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__glow {
      animation: lets-talk-rise 2200ms var(--ease-drift) both;
    }

    /* A television in a dark room: the light never sits still. Mostly
       small, quick changes in brightness, now and then a cut to a dimmer
       or brighter scene, and underneath a cooler, whiter light that comes
       and goes on its own beat. The two loops (9.7s and 6.1s) don't line
       up, so it doesn't visibly repeat. Opacity only, so it costs nothing
       to draw. */
    .lets-talk__light {
      animation: lets-talk-tv 9.7s linear infinite;
    }

    .lets-talk__glow::before {
      animation: lets-talk-tv-tint 6.1s linear infinite;
    }
  }

  /* The cooler light of the picture changing, over the neon */
  .lets-talk__glow::before {
    content: '';
    position: absolute;
    inset: 10% 15% 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(from var(--brand-neon) calc(l + 0.06) calc(c * 0.35) calc(h + 40)), transparent);
    opacity: 0;
  }

  @keyframes lets-talk-tv {
    0% { opacity: 1; }
    4% { opacity: 0.93; }
    6% { opacity: 0.97; }
    11% { opacity: 0.9; }
    11.4% { opacity: 1; }
    17% { opacity: 0.95; }
    22% { opacity: 0.98; }
    22.3% { opacity: 0.78; }
    27% { opacity: 0.82; }
    27.3% { opacity: 0.96; }
    33% { opacity: 0.92; }
    38% { opacity: 1; }
    41% { opacity: 0.94; }
    41.3% { opacity: 0.99; }
    48% { opacity: 0.9; }
    54% { opacity: 0.96; }
    54.2% { opacity: 0.86; }
    60% { opacity: 0.93; }
    66% { opacity: 0.97; }
    66.3% { opacity: 1; }
    72% { opacity: 0.91; }
    77% { opacity: 0.95; }
    77.2% { opacity: 0.74; }
    81% { opacity: 0.8; }
    81.3% { opacity: 0.98; }
    88% { opacity: 0.93; }
    94% { opacity: 0.99; }
    100% { opacity: 1; }
  }

  @keyframes lets-talk-tv-tint {
    0% { opacity: 0; }
    14% { opacity: 0.1; }
    14.4% { opacity: 0.32; }
    24% { opacity: 0.26; }
    31% { opacity: 0.3; }
    31.3% { opacity: 0.04; }
    46% { opacity: 0.08; }
    58% { opacity: 0.18; }
    58.4% { opacity: 0.4; }
    67% { opacity: 0.34; }
    67.3% { opacity: 0.12; }
    80% { opacity: 0.16; }
    86% { opacity: 0.06; }
    100% { opacity: 0; }
  }

  @keyframes lets-talk-word {
    from {
      translate: 0 0.8em;
    }
  }

  @keyframes lets-talk-rise {
    from {
      opacity: 0.1;
      translate: 0 12%;
    }
  }

  /* Phrases, not a metronome: a slow swell in, a short answer, a rest,
     then a longer one. Every move takes at least half a second, so it reads
     as breathing and talking rather than a flicker. */
  @keyframes lets-talk-pulse {
    0%,
    100% {
      scale: 1;
    }
    22% {
      scale: 1.1;
    }
    34% {
      scale: 1.03;
    }
    46% {
      scale: 1.08;
    }
    60% {
      scale: 1;
    }
    82% {
      scale: 1.12;
    }
  }

  /* Room above the line for the tops of the capitals, down to the page
     edge. Cropped only while the word is rising into place */
  .lets-talk__crop {
    position: absolute;
    inset: -0.5em 0 0;
  }

  .lets-talk[data-arrival]:not([data-settled]) .lets-talk__crop {
    overflow: clip;
  }

  .lets-talk__link {
    position: relative;
    display: block;
    height: 100%;
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    color: var(--brand-neon);
  }

  /* The frame is the crop; the baseline sits where it did in the 0.8em line
     (0.128em under the page edge), and the rest of the word hangs below */
  .lets-talk__word {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: currentColor;
  }

  .lets-talk__link:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 8px;
  }
</style>

<script>
  // Once the word has risen into place, its crop lets go, so the rest of it
  // hangs below the page for an overscroll to show
  for (const talk of document.querySelectorAll<HTMLElement>('.lets-talk')) {
    talk.querySelector('.lets-talk__link')?.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName.includes('lets-talk-word')) talk.toggleAttribute('data-settled', true);
    });
  }
</script>
