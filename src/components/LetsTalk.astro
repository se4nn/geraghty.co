---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="lets-talk">
  <div class="light" aria-hidden="true">
    <div class="glow"></div>
  </div>
  <div class="frame">
    <a class="link" href={`mailto:${email}`} aria-label="Let’s talk.">
      <svg class="word" aria-hidden="true"><text x="50%" y="1.028em" text-anchor="middle">Let’s talk.</text></svg>
    </a>
  </div>
</div>

<style>
  .lets-talk {
    position: relative;
    font-size: min(var(--display-size), var(--quote-width, 100%) * 0.95 / 3.195);
    margin-top: 0.8em;
    height: 0.4em;
  }

  /* Light */

  .light {
    position: absolute;
    left: 50%;
    top: -3em;
    bottom: 0;
    width: 100vw;
    translate: -50% 0;
    overflow: clip;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    left: 0;
    top: 2.76em;
    width: 100%;
    height: 3.2em;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), var(--neutral-1000));
    filter: blur(1em);
    pointer-events: none;
  }

  .glow::after {
    content: '';
    position: absolute;
    top: -5%;
    left: 22%;
    width: 56%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), transparent);
    opacity: 0;
    transition: opacity var(--duration-m) var(--ease-out);
  }

  .lets-talk:has(.link:hover, .link:focus-visible) .glow::after {
    opacity: 0.75;
    transition-duration: var(--duration-l);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lets-talk:has(.link:hover, .link:focus-visible) .glow::after {
      animation: lets-talk-pulse 4.8s var(--ease-in-out) 600ms infinite;
    }

    .lets-talk[data-arrival='waiting'] .link {
      translate: 0 0.8em;
    }

    .lets-talk[data-arrival='arrived'] .link {
      animation: lets-talk-word 1800ms var(--ease-drift) both;
    }

    .lets-talk[data-arrival='waiting'] .glow {
      opacity: 0.1;
      translate: 0 12%;
    }

    .lets-talk[data-arrival='arrived'] .glow {
      animation: lets-talk-rise 2200ms var(--ease-drift) both;
    }

    .light {
      animation: lets-talk-tv 9.7s linear infinite;
    }

    .glow::before {
      animation: lets-talk-tv-tint 6.1s linear infinite;
    }
  }

  .glow::before {
    content: '';
    position: absolute;
    inset: 10% 15% 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(from var(--brand-neon) calc(l + 0.06) calc(c * 0.35) calc(h + 40)), transparent);
    opacity: 0;
  }

  @keyframes lets-talk-tv {
    0% { opacity: 1; }
    4% { opacity: 0.93; }
    6% { opacity: 0.97; }
    11% { opacity: 0.9; }
    11.4% { opacity: 1; }
    17% { opacity: 0.95; }
    22% { opacity: 0.98; }
    22.3% { opacity: 0.78; }
    27% { opacity: 0.82; }
    27.3% { opacity: 0.96; }
    33% { opacity: 0.92; }
    38% { opacity: 1; }
    41% { opacity: 0.94; }
    41.3% { opacity: 0.99; }
    48% { opacity: 0.9; }
    54% { opacity: 0.96; }
    54.2% { opacity: 0.86; }
    60% { opacity: 0.93; }
    66% { opacity: 0.97; }
    66.3% { opacity: 1; }
    72% { opacity: 0.91; }
    77% { opacity: 0.95; }
    77.2% { opacity: 0.74; }
    81% { opacity: 0.8; }
    81.3% { opacity: 0.98; }
    88% { opacity: 0.93; }
    94% { opacity: 0.99; }
    100% { opacity: 1; }
  }

  @keyframes lets-talk-tv-tint {
    0% { opacity: 0; }
    14% { opacity: 0.1; }
    14.4% { opacity: 0.32; }
    24% { opacity: 0.26; }
    31% { opacity: 0.3; }
    31.3% { opacity: 0.04; }
    46% { opacity: 0.08; }
    58% { opacity: 0.18; }
    58.4% { opacity: 0.4; }
    67% { opacity: 0.34; }
    67.3% { opacity: 0.12; }
    80% { opacity: 0.16; }
    86% { opacity: 0.06; }
    100% { opacity: 0; }
  }

  @keyframes lets-talk-word {
    from {
      translate: 0 0.8em;
    }
  }

  @keyframes lets-talk-rise {
    from {
      opacity: 0.1;
      translate: 0 12%;
    }
  }

  @keyframes lets-talk-pulse {
    0%,
    100% {
      scale: 1;
    }
    22% {
      scale: 1.1;
    }
    34% {
      scale: 1.03;
    }
    46% {
      scale: 1.08;
    }
    60% {
      scale: 1;
    }
    82% {
      scale: 1.12;
    }
  }

  /* Word */

  .frame {
    position: absolute;
    inset: -0.5em 0 0;
  }

  .lets-talk[data-arrival]:not([data-settled]) .frame {
    overflow: clip;
  }

  .link {
    position: relative;
    display: block;
    height: 100%;
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    color: var(--brand-neon);
  }

  .word {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: currentColor;
  }

  .link:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 8px;
  }
</style>

<script>
  for (const talk of document.querySelectorAll<HTMLElement>('.lets-talk')) {
    talk.querySelector('.link')?.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName.includes('lets-talk-word')) talk.toggleAttribute('data-settled', true);
    });
  }
</script>
