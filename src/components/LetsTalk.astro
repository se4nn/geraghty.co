---
// Figma: "Let's talk." The word is cropped by the bottom of the page
// and lit from below by a blurred neon ellipse. Pushing on past the end of
// the page (an overscroll: a wheel or trackpad, or a pull on a touch screen)
// raises the word in its crop to show the rest of it, and it settles back
// down when let go.
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="lets-talk">
  <div class="lets-talk__glow" aria-hidden="true"></div>
  <a class="lets-talk__link" href={`mailto:${email}`}>Let’s talk.</a>
</div>

<style>
  .lets-talk {
    position: relative;
    /* "Let's talk." is 3.195em wide. Size it to fill 95% of the quote above,
       never larger than the display size. */
    font-size: min(var(--display-size), var(--quote-width, 100%) * 0.95 / 3.195);
    /* 120px gap above, 120px of the 160px line visible, at 200px type */
    margin-top: 0.6em;
    height: 0.6em;
  }

  .lets-talk__glow {
    position: absolute;
    left: 50%;
    top: -0.24em;
    width: 100vw;
    height: 3.2em;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), var(--neutral-1000));
    filter: blur(1em);
    pointer-events: none;
  }

  /* A hotter core that answers the pointer: the light warms up under
     "Let's talk." on hover, then keeps pulsing on an uneven beat, like
     someone talking, until it's left. Cools a little quicker than it warms. */
  .lets-talk__glow::after {
    /* Centred on the visible band of the word, not the whole glow, most
       of which sits below the page */
    content: '';
    position: absolute;
    top: -5%;
    left: 22%;
    width: 56%;
    height: 50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--brand-neon), transparent);
    opacity: 0;
    transition: opacity var(--duration-m) var(--ease-out);
  }

  .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
    opacity: 0.75;
    transition-duration: var(--duration-l);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lets-talk:has(.lets-talk__link:hover, .lets-talk__link:focus-visible) .lets-talk__glow::after {
      /* Waits for the core to warm up, then starts on a slow breath in */
      animation: lets-talk-pulse 4.8s var(--ease-in-out) 600ms infinite;
    }

    /* Last in the footer's arrival sequence (Footer sets data-arrival):
       the word rises from below the page edge that crops it, and the light
       swells up behind it */
    .lets-talk[data-arrival='waiting'] .lets-talk__link {
      translate: 0 0.8em;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__link {
      animation: lets-talk-word 1800ms var(--ease-drift) both;
    }

    .lets-talk[data-arrival='waiting'] .lets-talk__glow {
      opacity: 0.1;
      translate: 0 12%;
    }

    .lets-talk[data-arrival='arrived'] .lets-talk__glow {
      animation: lets-talk-rise 2200ms var(--ease-drift) both;
    }
  }

  @keyframes lets-talk-word {
    from {
      translate: 0 0.8em;
    }
  }

  @keyframes lets-talk-rise {
    from {
      opacity: 0.1;
      translate: 0 12%;
    }
  }

  /* Phrases, not a metronome: a slow swell in, a short answer, a rest,
     then a longer one. Every move takes at least half a second, so it reads
     as breathing and talking rather than a flicker. */
  @keyframes lets-talk-pulse {
    0%,
    100% {
      scale: 1;
    }
    22% {
      scale: 1.1;
    }
    34% {
      scale: 1.03;
    }
    46% {
      scale: 1.08;
    }
    60% {
      scale: 1;
    }
    82% {
      scale: 1.12;
    }
  }

  .lets-talk__link {
    position: relative;
    display: block;
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    line-height: var(--display-lh);
    text-align: center;
    color: var(--brand-neon);
    white-space: nowrap;
  }

  /* The overscroll lift is a transform, so it stacks with the arrival's
     translate rather than fighting it. Following the hand closely while
     pulled, settling back on the way the light cools: unhurried */
  .lets-talk__link {
    transform: translateY(calc(-1 * var(--pull, 0px)));
    transition: transform 80ms linear;
  }

  .lets-talk:not([data-pulling]) .lets-talk__link {
    transition: transform 520ms var(--ease-out);
  }

  .lets-talk__link:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 8px;
  }
</style>

<script>
  // How far the word lifts: what the crop hides of its line, plus a little
  // room under it, in em of the word's size
  const LIFT = 0.3;
  // A pull moves the word less than the hand, as a rubber band does
  const GIVE = 0.4;
  // Let go once the wheel has been still this long
  const SETTLE = 140;

  for (const talk of document.querySelectorAll<HTMLElement>('.lets-talk')) {
    let pull = 0;
    let timer = 0;
    const atEnd = () => window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    const most = () => LIFT * parseFloat(getComputedStyle(talk).fontSize);
    const set = (px: number) => {
      pull = Math.max(0, Math.min(most(), px));
      talk.style.setProperty('--pull', `${pull.toFixed(1)}px`);
    };
    const letGo = () => {
      talk.removeAttribute('data-pulling');
      set(0);
    };

    window.addEventListener(
      'wheel',
      (event) => {
        if (!atEnd() || (event.deltaY <= 0 && pull === 0)) return;
        talk.toggleAttribute('data-pulling', true);
        set(pull + event.deltaY * GIVE);
        window.clearTimeout(timer);
        timer = window.setTimeout(letGo, SETTLE);
      },
      { passive: true },
    );

    let startY: number | null = null;
    window.addEventListener('touchstart', (event) => (startY = atEnd() ? event.touches[0].clientY : null), { passive: true });
    window.addEventListener(
      'touchmove',
      (event) => {
        if (startY === null) return;
        talk.toggleAttribute('data-pulling', true);
        set((startY - event.touches[0].clientY) * GIVE);
      },
      { passive: true },
    );
    window.addEventListener('touchend', () => {
      startY = null;
      letGo();
    });
  }
</script>
