---
// Figma: "Services"
import Tag from './Tag.astro';
import LogoStack, { type LogoChip } from './LogoStack.astro';

interface Props {
  items: { label: string; logos: LogoChip[] }[];
}

const { items } = Astro.props;

---

<div class="skills">
  <h2 class="skills__label t-h3-emphasis">Skills</h2>
  <ul class="skills__list" role="list">
    {
      items.map((item) => (
        <li class="skills__item">
          <span class="skills__divider" aria-hidden="true"></span>
          <Tag variant="plain">
            {item.label}
            <LogoStack items={item.logos} />
          </Tag>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Figma: "Services". One row: Skills | tag | tag | tag */
  .skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-l);
    font-size: var(--h3-size);
  }

  .skills__label {
    color: var(--text-strong);
  }

  .skills__list {
    display: contents;
    list-style: none;
  }

  .skills__item {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  /* 1 × 24px rule at 33px type, centred in an 8px slot */
  .skills__divider {
    width: 1px;
    height: 0.7273em;
    margin-inline: 3.5px;
    background-color: var(--neutral-300);
  }

  /* The whole tag reacts on hover, so the whole tag gets the pointer */
  .skills__list :global(.tag) {
    cursor: pointer;
    transition: color var(--duration-s) var(--ease-out);
  }

  /* Phones: stack the tags, no dividers */
  @media (max-width: 700px) {
    .skills {
      flex-direction: column;
      gap: var(--space-s);
    }

    .skills__divider {
      display: none;
    }
  }

  @media (hover: hover) {
    .skills__list :global(.tag:hover) {
      color: var(--text-strong);
    }

    /* While a chip's hover card is open, lift its tag above the content
       around it */
    .skills__item:has(:global(a.chip--preview)) {
      position: relative;
      z-index: 0;
      /* Stay raised until the card has finished leaving */
      transition: z-index 0s linear 180ms;
    }

    .skills__item:has(:global(a.chip--preview:hover)) {
      z-index: 30;
      transition-delay: 0s;
    }
  }
</style>
