---
import Tag from './Tag.astro';
import LogoStack, { type LogoChip } from './LogoStack.astro';

interface Props {
  items: { label: string; logos: LogoChip[] }[];
}

const { items } = Astro.props;

---

<div class="skills">
  <h2 class="heading t-h3-emphasis">Skills</h2>
  <ul class="list" role="list">
    {
      items.map((item) => (
        <li class="item">
          <span class="divider" aria-hidden="true"></span>
          <Tag>
            {item.label}
            {item.logos.length > 0 && <LogoStack items={item.logos} />}
          </Tag>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const INTENT = 100;
  const COOL = 300;

  for (const row of document.querySelectorAll<HTMLElement>('.skills')) {
    let warmUp: number | undefined;
    let coolDown: number | undefined;

    for (const chip of row.querySelectorAll<HTMLElement>('.logo-stack a.chip.card')) {
      chip.addEventListener('pointerenter', () => {
        window.clearTimeout(coolDown);
        if ('warm' in row.dataset) {
          chip.dataset.swap = '';
          return;
        }
        window.clearTimeout(warmUp);
        warmUp = window.setTimeout(() => (row.dataset.warm = ''), INTENT);
      });
      chip.addEventListener('pointerleave', () => {
        delete chip.dataset.swap;
        window.clearTimeout(warmUp);
        window.clearTimeout(coolDown);
        coolDown = window.setTimeout(() => delete row.dataset.warm, COOL);
      });
    }
  }
</script>

<style>
  .skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-l);
    font-size: var(--h3-size);
  }

  .heading {
    color: var(--text-strong);
  }

  .list {
    display: contents;
    list-style: none;
  }

  .item {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .divider {
    width: 1px;
    height: 0.7273em;
    margin-inline: 3.5px;
    background-color: var(--neutral-300);
  }

  .list :global(.tag:has(a)) {
    cursor: pointer;
    transition: color var(--duration-s) var(--ease-out);
  }

  @media (max-width: 700px) {
    .skills {
      gap: var(--space-s) var(--space-l);
    }

    .divider {
      display: none;
    }
  }

  @media (hover: hover) {
    .list :global(.tag:hover) {
      color: var(--text-strong);
    }

    .item:has(:global(.logo-stack a.chip.card)) {
      position: relative;
      z-index: 0;
      transition: z-index 0s linear 180ms;
    }

    .item:has(:global(.logo-stack a.chip.card:hover)) {
      z-index: 30;
      transition-delay: 0s;
    }
  }
</style>
