---
// The Skills row: tags, some with a logo stack whose chips open hover cards.
// On the homepage and, as plain labels, on case studies.
import Tag from './Tag.astro';
import LogoStack, { type LogoChip } from './LogoStack.astro';

interface Props {
  items: { label: string; logos: LogoChip[] }[];
}

const { items } = Astro.props;

---

<div class="skills">
  <h2 class="skills__label t-h3-emphasis">Skills</h2>
  <ul class="skills__list" role="list">
    {
      items.map((item) => (
        <li class="skills__item">
          <span class="skills__divider" aria-hidden="true"></span>
          <Tag>
            {item.label}
            {item.logos.length > 0 && <LogoStack items={item.logos} />}
          </Tag>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Group warm-up (MOTION.md)
  const INTENT = 100; // matches --intent in ProjectPreview
  const COOL = 300;

  for (const row of document.querySelectorAll<HTMLElement>('.skills')) {
    let warmUp: number | undefined;
    let coolDown: number | undefined;

    for (const chip of row.querySelectorAll<HTMLElement>('a.chip--preview')) {
      chip.addEventListener('pointerenter', () => {
        window.clearTimeout(coolDown);
        if ('warm' in row.dataset) {
          chip.dataset.swap = '';
          return;
        }
        window.clearTimeout(warmUp);
        warmUp = window.setTimeout(() => (row.dataset.warm = ''), INTENT);
      });
      chip.addEventListener('pointerleave', () => {
        delete chip.dataset.swap;
        window.clearTimeout(warmUp);
        window.clearTimeout(coolDown);
        coolDown = window.setTimeout(() => delete row.dataset.warm, COOL);
      });
    }
  }
</script>

<style>
  .skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-l);
    font-size: var(--h3-size);
  }

  .skills__label {
    color: var(--text-strong);
  }

  .skills__list {
    display: contents;
    list-style: none;
  }

  .skills__item {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  /* 1 × 24px rule at 33px type, centred in an 8px slot */
  .skills__divider {
    width: 1px;
    height: 0.7273em;
    margin-inline: 3.5px;
    background-color: var(--neutral-300);
  }

  /* The whole tag reacts, so the whole tag gets the pointer; plain labels don't */
  .skills__list :global(.tag:has(a)) {
    cursor: pointer;
    transition: color var(--duration-s) var(--ease-out);
  }

  /* Phones: no dividers, or one is left hanging at the end of a line */
  @media (max-width: 700px) {
    .skills {
      gap: var(--space-s) var(--space-l);
    }

    .skills__divider {
      display: none;
    }
  }

  @media (hover: hover) {
    .skills__list :global(.tag:hover) {
      color: var(--text-strong);
    }

    /* Lift the tag above what's around it while its card is open */
    .skills__item:has(:global(a.chip--preview)) {
      position: relative;
      z-index: 0;
      /* Stay raised until the card has finished leaving */
      transition: z-index 0s linear 180ms;
    }

    .skills__item:has(:global(a.chip--preview:hover)) {
      z-index: 30;
      transition-delay: 0s;
    }
  }
</style>
