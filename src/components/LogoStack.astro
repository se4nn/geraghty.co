---
import type { ImageMetadata } from 'astro';
import ProjectPreview, { type Preview } from './ProjectPreview.astro';

export interface LogoChip {
  name: string;
  src: ImageMetadata;
  href?: string;
  project?: string;
  card?: Preview;
  rotate: number;
  bg?: string;
  width?: number;
  height?: number;
}

interface Props {
  items: LogoChip[];
}

const { items } = Astro.props;
const mid = (items.length - 1) / 2;

const em = (px: number) => `${+(px / 33).toFixed(4)}em`;
const rad = (deg: number) => (deg * Math.PI) / 180;

const FAN_STEP = 7;
const SPREAD = 5;
const LIFT = 5;
const ARC = 1.5;

const chips = items.map((item, i) => {
  const offset = i - mid;
  return {
    ...item,
    style: [
      `--i: ${i}`,
      `--n: ${items.length}`,
      `--rest-rotate: ${item.rotate}deg`,
      `--slot: ${em(32 * (Math.abs(Math.cos(rad(item.rotate))) + Math.abs(Math.sin(rad(item.rotate)))))}`,
      `--fan-rotate: ${offset * FAN_STEP}deg`,
      `--fan-x: ${em((i - mid / 2) * SPREAD)}`,
      `--fan-y: ${em(-LIFT + Math.abs(offset) * ARC)}`,
      `--logo-w: ${em(item.width ?? 20)}`,
      `--logo-h: ${em(item.height ?? 20)}`,
      `--z: ${items.length - i}`,
    ].join('; '),
  };
});
---

<span class="logo-stack">
  {
    chips.map((chip) => {
      const Chip = chip.href ? 'a' : 'span';
      const external = chip.href?.startsWith('http');
      return (
        <Chip
          class:list={['chip', { card: chip.card }]}
          style={chip.style}
          href={chip.href}
          aria-label={chip.href ? chip.name : undefined}
          aria-hidden={chip.href ? undefined : 'true'}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener' : undefined}
        >
          <span class="body">
            {chip.bg ? (
              <span class="square" style={`background-color: ${chip.bg};`}>
                <img src={chip.src.src} alt="" width={chip.width ?? 20} height={chip.height ?? 20} />
              </span>
            ) : (
              <img class="built" src={chip.src.src} alt="" width="34" height="37" />
            )}
          </span>
          {chip.card && <ProjectPreview {...chip.card} />}
        </Chip>
      );
    })
  }
</span>

<style>
  .logo-stack {
    display: inline-flex;
    align-items: center;
  }

  .chip {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: var(--slot);
    height: var(--slot);
  }

  .chip + .chip {
    margin-left: -0.2424em;
  }

  .body {
    position: relative;
    z-index: var(--z);
    display: block;
    width: 0.9697em;
    height: 0.9697em;
    transform: rotate(var(--rest-rotate));
    transition: transform 280ms var(--ease-out);
    transition-delay: calc((var(--n) - 1 - var(--i)) * 24ms);
  }

  .body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0.1818em;
    box-shadow: var(--shadow-chip-lifted);
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
    transition-delay: inherit;
  }

  .square {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 0.1818em;
    box-shadow: var(--shadow-chip);
    overflow: hidden;
  }

  .square img {
    width: var(--logo-w);
    height: var(--logo-h);
  }

  .built {
    position: absolute;
    top: 0;
    left: -0.0303em;
    width: 1.0303em;
    height: 1.1212em;
    max-width: none;
  }

  /* Fan */

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.tag:hover) .body {
      transform: translate(var(--fan-x), var(--fan-y)) rotate(var(--fan-rotate)) scale(1.04);
      transition: transform 560ms var(--ease-spring);
      transition-delay: calc(var(--i) * 40ms);
    }

    :global(.tag:hover) .body::before {
      opacity: 1;
    }

    :global(.tag:hover) a.chip:hover .body {
      z-index: 10;
      transform: translate(var(--fan-x), calc(var(--fan-y) - 0.0909em)) rotate(var(--fan-rotate)) scale(1.1);
      transition: transform 360ms var(--ease-spring);
      transition-delay: 0ms;
    }
  }

  /* Focus */

  a.chip:focus-visible {
    outline: none;
  }

  a.chip:focus-visible .body {
    z-index: 10;
    outline: 2px solid var(--neutral-900);
    outline-offset: 2px;
    border-radius: 0.1818em;
  }
</style>
