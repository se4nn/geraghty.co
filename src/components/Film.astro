---
// A film in the story, across the grid at 1416 × 812 (three columns high,
// so the 16:9 film loses a sliver at each side). Like the homepage showreel it
// plays muted and looping while it's on screen (a fifth of it), and pauses
// when it leaves.
// Films here have a soundtrack worth hearing, so a button turns the sound
// on (and starts it, if it's paused). A silent loop (the design system in
// motion) passes `sound={false}` and its own `ratio`, and gets no button.
// A film that plays once (`loop={false}`) stops on its last frame. A film
// with `restart` (Studia's system) gets a small Restart button bottom left,
// in the place of the sound button, that takes it back to the start.
// Clicking the film plays or pauses it; once someone pauses it, scrolling
// never restarts it. Reduced motion never
// autoplays: the poster sits there until it's clicked.
//
// Private films: pass `encrypted` instead of `video`, the path to a file made
// by scripts/encrypt-film.mjs. The poster shows with a password field; the
// right password decrypts the film in the browser (AES-GCM, key from PBKDF2)
// and it plays with sound. The plain MP4 is never shipped.
// Sean's media is authored: never trim or re-time it (MOTION.md).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  video?: string;
  encrypted?: string;
  poster: ImageMetadata;
  // What the film shows, for screen readers
  alt: string;
  // Width and height of the frame, in Figma px (the grid's 1416 × 812 by default)
  ratio?: [number, number];
  // Whether there is a soundtrack to turn on
  sound?: boolean;
  // Width the poster is made at; 2x the slot for a loop that needs to be crisp
  posterWidth?: number;
  // Loops by default. Without it the film plays once and stops
  loop?: boolean;
  // A Restart button, back to the start: for a film that tells a story from
  // its first frame
  restart?: boolean;
  // A live version of what the film shows (Insight World). A button opens it
  // full screen in a dialog; the page only loads when it's opened
  live?: string;
  liveLabel?: string;
  // The dialog's title, beside Close
  liveTitle?: string;
}

const {
  video,
  encrypted,
  poster,
  alt,
  ratio = [1416, 812],
  sound = true,
  posterWidth = 1920,
  loop = true,
  restart = false,
  live,
  liveLabel = 'Explore it live',
  liveTitle = liveLabel,
} = Astro.props;
const posterImage = await getImage({ src: poster, width: posterWidth, format: 'webp', quality: 90 });
---

<figure class="film" style={`aspect-ratio: ${ratio[0]} / ${ratio[1]}`} data-encrypted={encrypted} data-locked={encrypted ? '' : undefined} data-live={live ? '' : undefined}>
  <video class="film__video" poster={posterImage.src} aria-label={alt} muted={!encrypted} loop={loop} playsinline preload="none">
    {video && <source src={video} type="video/mp4" />}
  </video>
  <button class="film__toggle" type="button" aria-label="Play the film">
    <svg class="film__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
  </button>
  {sound && <button class="film__sound t-label" type="button" aria-pressed="false">Sound on</button>}
  {restart && <button class="film__restart t-label" type="button">Restart</button>}
  {
    live && (
      <>
        <button class="film__live t-label" type="button" aria-haspopup="dialog">
          {liveLabel}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
        </button>
        <dialog class="film__dialog" aria-label={liveTitle}>
          <form class="film__bar" method="dialog">
            <span class="t-label">{liveTitle}</span>
            <button class="film__close t-label" type="submit">Close</button>
          </form>
          <iframe class="film__frame" data-src={live} title={alt} />
        </dialog>
      </>
    )
  }
  {
    encrypted && (
      <form class="film__lock">
        <p class="film__lock-title t-body-bold">This film is private</p>
        <p class="film__lock-note t-label">Enter the password to watch it.</p>
        <div class="film__lock-row">
          <label class="visually-hidden" for="film-password">Password</label>
          <input class="film__lock-input t-label" id="film-password" type="password" autocomplete="off" required />
          <button class="film__lock-button t-label" type="submit">Watch</button>
        </div>
        <p class="film__lock-status t-label" role="status" aria-live="polite" />
      </form>
    )
  }
</figure>

<style>
  .film {
    position: relative;
    margin: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-1000);
  }

  .film__video,
  .film__toggle {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The whole film is the play/pause button; the icon only shows when it's
     paused */
  .film__toggle {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .film__icon {
    width: 72px;
    height: 72px;
    padding: 20px;
    border-radius: 50%;
    fill: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity var(--duration-s) var(--ease-out);
  }

  .film[data-paused] .film__icon {
    opacity: 1;
  }

  /* A film that has finished shows its last frame, not a play button; one
     with a live version opens that on click, so it never shows one either */
  .film[data-ended] .film__icon,
  .film[data-live] .film__icon {
    opacity: 0;
  }

  .film__toggle:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: -4px;
  }

  .film__sound,
  .film__restart {
    position: absolute;
    z-index: 1;
    left: var(--space-m);
    bottom: var(--space-m);
    padding: var(--space-xs) var(--space-m);
    border: 0;
    border-radius: var(--radius-l);
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background-color var(--duration-s) var(--ease-out);
  }

  @media (hover: hover) {
    .film__sound:hover,
    .film__restart:hover {
      background-color: oklch(0% 0 0 / 0.7);
    }
  }

  .film__sound:focus-visible,
  .film__restart:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }

  /* The live version: a button bottom right, and a full-screen dialog */
  .film__live,
  .film__close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border: 0;
    border-radius: var(--radius-l);
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background-color var(--duration-s) var(--ease-out);
  }

  .film__live {
    position: absolute;
    z-index: 1;
    right: var(--space-m);
    bottom: var(--space-m);
  }

  .film__live svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @media (hover: hover) {
    .film__live:hover,
    .film__close:hover {
      background-color: oklch(0% 0 0 / 0.7);
    }
  }

  .film__live:focus-visible,
  .film__close:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }

  .film__dialog {
    width: calc(100vw - 2 * var(--space-m));
    height: calc(100dvh - 2 * var(--space-m));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    color: var(--text-on-dark);
    background-color: var(--neutral-1000);
  }

  .film__dialog[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .film__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-m);
    border-bottom: 1px solid oklch(100% 0 0 / 0.1);
  }

  .film__dialog::backdrop {
    background-color: oklch(0% 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }

  .film__frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .film__dialog[open] {
      animation: film-dialog-in var(--duration-m, 300ms) var(--ease-out-expo, ease-out);
    }
  }

  @keyframes film-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  /* Locked: the poster, dimmed, with the password form in the middle */
  .film[data-locked] .film__toggle,
  .film[data-locked] .film__sound {
    display: none;
  }

  .film__lock {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-xs);
    padding: var(--space-m);
    text-align: center;
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.55);
    backdrop-filter: blur(6px);
  }

  .film:not([data-locked]) .film__lock {
    display: none;
  }

  .film__lock-title,
  .film__lock-note,
  .film__lock-status {
    margin: 0;
  }

  .film__lock-note,
  .film__lock-status {
    color: var(--text-on-dark-muted);
  }

  .film__lock-row {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .film__lock-input,
  .film__lock-button {
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius-l);
  }

  .film__lock-input {
    width: min(240px, 50vw);
    border: 1px solid oklch(100% 0 0 / 0.3);
    color: var(--text-on-dark);
    background-color: oklch(100% 0 0 / 0.1);
  }

  .film__lock-button {
    border: 0;
    color: var(--neutral-1000);
    background-color: var(--brand-neon);
    cursor: pointer;
  }

  .film__lock-input:focus-visible,
  .film__lock-button:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Must match scripts/encrypt-film.mjs
  async function decrypt(url: string, password: string) {
    const data = new Uint8Array(await (await fetch(url)).arrayBuffer());
    const salt = data.slice(4, 20);
    const iv = data.slice(20, 32);
    const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 310_000, hash: 'SHA-256' },
      material,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    // A wrong password fails the GCM tag check and throws
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, data.slice(32));
    return URL.createObjectURL(new Blob([plain], { type: 'video/mp4' }));
  }

  for (const film of document.querySelectorAll<HTMLElement>('.film')) {
    const video = film.querySelector('video')!;
    const toggle = film.querySelector<HTMLButtonElement>('.film__toggle')!;
    const button = film.querySelector<HTMLButtonElement>('.film__sound');
    const restart = film.querySelector<HTMLButtonElement>('.film__restart');
    // A film with a live version opens it from a click anywhere on it,
    // rather than pausing
    const liveButton = film.querySelector<HTMLButtonElement>('.film__live');
    // Set once someone pauses it, so scrolling back doesn't restart it.
    // A locked film waits for its password.
    let held = reducedMotion.matches || film.hasAttribute('data-locked');

    const sync = () => {
      film.toggleAttribute('data-paused', video.paused);
      film.toggleAttribute('data-ended', video.ended);
      toggle.setAttribute('aria-label', liveButton ? liveButton.textContent?.trim() || 'Explore it live' : video.paused ? 'Play the film' : 'Pause the film');
      if (button) {
        button.textContent = video.muted ? 'Sound on' : 'Sound off';
        button.setAttribute('aria-pressed', String(!video.muted));
      }
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('volumechange', sync);
    video.addEventListener('ended', sync);
    sync();

    // Safari only autoplays a video that is muted as a property too, not
    // just by attribute
    if (!film.hasAttribute('data-locked')) {
      video.muted = true;
      video.defaultMuted = true;
    }

    // Muted, it plays while a fifth of it is on screen. If the browser
    // refuses (an autoplay policy), it tries again on the reader's next
    // scroll, tap or key press while it's still in view.
    let inView = false;
    const start = () => {
      if (held || video.ended || !inView) return;
      video.play().catch(() => {
        const retry = () => {
          for (const type of ['scroll', 'pointerdown', 'keydown']) window.removeEventListener(type, retry);
          start();
        };
        for (const type of ['scroll', 'pointerdown', 'keydown']) window.addEventListener(type, retry, { once: true, passive: true });
      });
    };
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) video.pause();
        else start();
      },
      { threshold: 0.2 },
    ).observe(video);

    toggle.addEventListener('click', () => {
      if (liveButton) {
        liveButton.click();
        return;
      }
      if (video.paused) {
        held = false;
        video.play().catch(() => {});
      } else {
        held = true;
        video.pause();
      }
    });

    // Restart goes back to the top and plays, whether it was paused or not
    restart?.addEventListener('click', () => {
      held = false;
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    button?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) video.play().catch(() => {});
    });

    // The live version: load it on first open, pause the film behind it,
    // and pick the film up again when the dialog closes
    const live = film.querySelector<HTMLButtonElement>('.film__live');
    const dialog = film.querySelector<HTMLDialogElement>('.film__dialog');
    if (live && dialog) {
      const frame = dialog.querySelector<HTMLIFrameElement>('iframe')!;
      let wasPlaying = false;
      // Escape pressed inside the page (same origin) closes the dialog too;
      // the browser only handles it when focus is outside the iframe
      frame.addEventListener('load', () => {
        frame.contentWindow?.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') dialog.close();
        });
      });
      live.addEventListener('click', () => {
        if (!frame.src) frame.src = frame.dataset.src!;
        wasPlaying = !video.paused;
        video.pause();
        dialog.showModal();
      });
      dialog.addEventListener('close', () => {
        if (wasPlaying && !held) video.play().catch(() => {});
        live.focus();
      });
      // A click on the backdrop closes it too
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }

    // Private films
    const form = film.querySelector<HTMLFormElement>('.film__lock');
    if (!form) continue;
    const input = form.querySelector('input')!;
    const status = form.querySelector('.film__lock-status')!;
    const submit = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      status.textContent = 'Unlocking…';
      try {
        video.src = await decrypt(film.dataset.encrypted!, input.value);
        film.removeAttribute('data-locked');
        held = false;
        video.muted = false;
        await video.play().catch(() => {});
        toggle.focus();
      } catch {
        status.textContent = 'That password isn’t right.';
        input.select();
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
