---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  video?: string;
  encrypted?: string;
  poster: ImageMetadata;
  alt: string;
  ratio?: [number, number];
  sound?: boolean;
  posterWidth?: number;
  loop?: boolean;
  restart?: boolean;
  live?: string;
  liveLabel?: string;
  liveTitle?: string;
}

const {
  video,
  encrypted,
  poster,
  alt,
  ratio = [1416, 812],
  sound = true,
  posterWidth = 1920,
  loop = true,
  restart = false,
  live,
  liveLabel = 'Explore it live',
  liveTitle = liveLabel,
} = Astro.props;
const posterImage = await getImage({ src: poster, width: posterWidth, format: 'webp', quality: 90 });
---

<figure class="film" style={`aspect-ratio: ${ratio[0]} / ${ratio[1]}`} data-encrypted={encrypted} data-locked={encrypted ? '' : undefined} data-live={live ? '' : undefined}>
  <video class="video" poster={posterImage.src} aria-label={alt} muted={!encrypted} loop={loop} playsinline preload="none">
    {video && <source src={video} type="video/mp4" />}
  </video>
  <button class="toggle" type="button" aria-label="Play the film">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
  </button>
  {sound && <button class="sound t-label" type="button" aria-pressed="false">Sound on</button>}
  {restart && <button class="restart t-label" type="button">Restart</button>}
  {
    live && (
      <>
        <button class="live t-label" type="button" aria-haspopup="dialog">
          {liveLabel}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" /></svg>
        </button>
        <dialog class="dialog" aria-label={liveTitle}>
          <form class="title-bar" method="dialog">
            <span class="t-label">{liveTitle}</span>
            <button class="close t-label" type="submit">Close</button>
          </form>
          <iframe class="frame" data-src={live} title={alt} />
        </dialog>
      </>
    )
  }
  {
    encrypted && (
      <form class="lock">
        <p class="lock-title t-body-bold">This film is private</p>
        <p class="lock-note t-label">Enter the password to watch it.</p>
        <div class="lock-row">
          <label class="visually-hidden" for="film-password">Password</label>
          <input class="lock-input t-label" id="film-password" type="password" autocomplete="off" required />
          <button class="lock-button t-label" type="submit">Watch</button>
        </div>
        <p class="lock-status t-label" role="status" aria-live="polite" />
      </form>
    )
  }
</figure>

<style>
  .film {
    position: relative;
    margin: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-1000);
  }

  .video,
  .toggle {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .toggle {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .icon {
    width: 72px;
    height: 72px;
    padding: 20px;
    border-radius: 50%;
    fill: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity var(--duration-s) var(--ease-out);
  }

  .film[data-paused] .icon {
    opacity: 1;
  }

  .film[data-ended] .icon,
  .film[data-live] .icon {
    opacity: 0;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: -4px;
  }

  /* Sound & Restart */

  .sound,
  .restart {
    position: absolute;
    z-index: 1;
    left: var(--space-m);
    bottom: var(--space-m);
    padding: var(--space-xs) var(--space-m);
    border: 0;
    border-radius: var(--radius-l);
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background-color var(--duration-s) var(--ease-out);
  }

  @media (hover: hover) {
    .sound:hover,
    .restart:hover {
      background-color: oklch(0% 0 0 / 0.7);
    }
  }

  .sound:focus-visible,
  .restart:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }

  /* Live Version */

  .live,
  .close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-m);
    border: 0;
    border-radius: var(--radius-l);
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.45);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition: background-color var(--duration-s) var(--ease-out);
  }

  .live {
    position: absolute;
    z-index: 1;
    right: var(--space-m);
    bottom: var(--space-m);
  }

  .live svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @media (hover: hover) {
    .live:hover,
    .close:hover {
      background-color: oklch(0% 0 0 / 0.7);
    }
  }

  .live:focus-visible,
  .close:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }

  .dialog {
    width: calc(100vw - 2 * var(--space-m));
    height: calc(100dvh - 2 * var(--space-m));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    overflow: hidden;
    color: var(--text-on-dark);
    background-color: var(--neutral-1000);
  }

  .dialog[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-m);
    border-bottom: 1px solid oklch(100% 0 0 / 0.1);
  }

  .dialog::backdrop {
    background-color: oklch(0% 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }

  .frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dialog[open] {
      animation: film-dialog-in var(--duration-m, 300ms) var(--ease-out-expo, ease-out);
    }
  }

  @keyframes film-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  /* Locked */

  .film[data-locked] .toggle,
  .film[data-locked] .sound {
    display: none;
  }

  .lock {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-xs);
    padding: var(--space-m);
    text-align: center;
    color: var(--text-on-dark);
    background-color: oklch(0% 0 0 / 0.55);
    backdrop-filter: blur(6px);
  }

  .film:not([data-locked]) .lock {
    display: none;
  }

  .lock-title,
  .lock-note,
  .lock-status {
    margin: 0;
  }

  .lock-note,
  .lock-status {
    color: var(--text-on-dark-muted);
  }

  .lock-row {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .lock-input,
  .lock-button {
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius-l);
  }

  .lock-input {
    width: min(240px, 50vw);
    border: 1px solid oklch(100% 0 0 / 0.3);
    color: var(--text-on-dark);
    background-color: oklch(100% 0 0 / 0.1);
  }

  .lock-button {
    border: 0;
    color: var(--neutral-1000);
    background-color: var(--brand-neon);
    cursor: pointer;
  }

  .lock-input:focus-visible,
  .lock-button:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 2px;
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  async function decrypt(url: string, password: string) {
    const data = new Uint8Array(await (await fetch(url)).arrayBuffer());
    const salt = data.slice(4, 20);
    const iv = data.slice(20, 32);
    const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: 310_000, hash: 'SHA-256' },
      material,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, data.slice(32));
    return URL.createObjectURL(new Blob([plain], { type: 'video/mp4' }));
  }

  for (const film of document.querySelectorAll<HTMLElement>('.film')) {
    const video = film.querySelector('video')!;
    const toggle = film.querySelector<HTMLButtonElement>('.toggle')!;
    const button = film.querySelector<HTMLButtonElement>('.sound');
    const restart = film.querySelector<HTMLButtonElement>('.restart');
    const liveButton = film.querySelector<HTMLButtonElement>('.live');
    let held = reducedMotion.matches || film.hasAttribute('data-locked');

    const sync = () => {
      film.toggleAttribute('data-paused', video.paused);
      film.toggleAttribute('data-ended', video.ended);
      toggle.setAttribute('aria-label', liveButton ? liveButton.textContent?.trim() || 'Explore it live' : video.paused ? 'Play the film' : 'Pause the film');
      if (button) {
        button.textContent = video.muted ? 'Sound on' : 'Sound off';
        button.setAttribute('aria-pressed', String(!video.muted));
      }
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('volumechange', sync);
    video.addEventListener('ended', sync);
    sync();

    if (!film.hasAttribute('data-locked')) {
      video.muted = true;
      video.defaultMuted = true;
    }

    let inView = false;
    const start = () => {
      if (held || video.ended || !inView) return;
      video.play().catch(() => {
        const retry = () => {
          for (const type of ['scroll', 'pointerdown', 'keydown']) window.removeEventListener(type, retry);
          start();
        };
        for (const type of ['scroll', 'pointerdown', 'keydown']) window.addEventListener(type, retry, { once: true, passive: true });
      });
    };
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) video.pause();
        else start();
      },
      { threshold: 0.2 },
    ).observe(video);

    toggle.addEventListener('click', () => {
      if (liveButton) {
        liveButton.click();
        return;
      }
      if (video.paused) {
        held = false;
        video.play().catch(() => {});
      } else {
        held = true;
        video.pause();
      }
    });

    restart?.addEventListener('click', () => {
      held = false;
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    button?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) video.play().catch(() => {});
    });

    // Live Version

    const live = film.querySelector<HTMLButtonElement>('.live');
    const dialog = film.querySelector<HTMLDialogElement>('.dialog');
    if (live && dialog) {
      const frame = dialog.querySelector<HTMLIFrameElement>('iframe')!;
      let wasPlaying = false;
      frame.addEventListener('load', () => {
        frame.contentWindow?.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') dialog.close();
        });
      });
      live.addEventListener('click', () => {
        if (!frame.src) frame.src = frame.dataset.src!;
        wasPlaying = !video.paused;
        video.pause();
        dialog.showModal();
      });
      dialog.addEventListener('close', () => {
        if (wasPlaying && !held) video.play().catch(() => {});
        live.focus();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }

    // Private Films

    const form = film.querySelector<HTMLFormElement>('.lock');
    if (!form) continue;
    const input = form.querySelector('input')!;
    const status = form.querySelector('.lock-status')!;
    const submit = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submit.disabled = true;
      status.textContent = 'Unlocking…';
      try {
        video.src = await decrypt(film.dataset.encrypted!, input.value);
        film.removeAttribute('data-locked');
        held = false;
        video.muted = false;
        await video.play().catch(() => {});
        toggle.focus();
      } catch {
        status.textContent = 'That password isn’t right.';
        input.select();
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
