---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, tile, link, tags, dates } = project.data;
const logo: ImageMetadata = tile.logo;
const href = link ?? `/#work-${project.id}`;

---

<section class="next" aria-label="Next project" style={`--logo-aspect: ${(logo.width / logo.height).toFixed(4)}`}>
  <div class="inner container">
    <a class="link" href={href} aria-label={`Next project: ${title}`} data-transition={`art-${project.id}`}>
      <TileArt
        class="art"
        image={tile.image}
        logo={tile.logo}
        logoScale={tile.logoScale}
        grain={tile.grain}
        gradient={tile.gradient}
        alt=""
        sizes="(max-width: 1512px) 94vw, 1416px"
        widths={[820, 1640, 2832]}
        showLogo={false}
      />
      <div class="content">
        <div class="flip">
          <img class="logo" src={logo.src} alt={title} width={logo.width} height={logo.height} loading="lazy" />
          <p class="caption" aria-hidden="true">Next project</p>
        </div>
      </div>
      <div class="meta t-h3">
        <p class="tags t-h3-bold">
          {tags.map((tag, i) => (
            <>{i > 0 && <span class="divider" aria-hidden="true">|</span>}<span>{tag}</span></>
          ))}
        </p>
        <p class="dates">{dates}</p>
      </div>
    </a>
  </div>
</section>

<script>
  addEventListener('pageswap', (event) => {
    const to = event.activation?.entry?.url;
    if (!event.viewTransition || !to) return;
    for (const tile of document.querySelectorAll<HTMLAnchorElement>('.next .link[data-transition]')) {
      const art = tile.querySelector<HTMLElement>('.art');
      if (!art || tile.href !== to) continue;
      art.style.viewTransitionName = tile.dataset.transition!;
      art.style.setProperty('view-transition-class', 'art');
    }
  });
</script>

<style>
  .next {
    background-color: var(--bg-dark);
  }

  .inner {
    padding-top: var(--space-2xl);
  }

  .link {
    container-type: inline-size;
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1416 / 508;
    min-height: 420px;
    overflow: clip;
    color: var(--text-on-dark);
  }

  .link > :global(*) {
    grid-area: 1 / 1;
  }

  .link :global(.tile-art.art) {
    border-radius: 0 0 calc(48 / 1416 * 100cqi) calc(48 / 1416 * 100cqi);
  }

  .link :global(.tile-art.art)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg-dark), oklch(from var(--bg-dark) l c h / 0));
    pointer-events: none;
  }

  .content {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 900px;
  }

  /* Flip */

  .flip {
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
  }

  .flip > * {
    grid-area: 1 / 1;
    backface-visibility: hidden;
  }

  .logo {
    width: calc(clamp(200px, calc(432 / 1512 * 100vw), 640px) * sqrt(var(--logo-aspect, 3.94) / 3.94));
    max-width: 80%;
    height: auto;
    max-height: min(calc(max(80svh, 440px) * 0.55), calc(508 / 1416 * 100cqi * 0.85));
    object-fit: contain;
  }

  .caption {
    margin: 0;
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    font-size: clamp(32px, calc(88 / 1416 * 100cqi), 88px);
    line-height: 1;
    white-space: nowrap;
    transform: rotateX(180deg);
  }

  .link:focus-visible .flip {
    transform: rotateX(180deg);
  }

  @media (hover: hover) {
    .link:hover .flip {
      transform: rotateX(180deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .flip {
      transition: transform 760ms var(--ease-spring);
    }
  }

  /* Reduced Motion */

  @media (prefers-reduced-motion: reduce) {
    .caption {
      transform: none;
      opacity: 0;
    }

    .link:focus-visible .flip,
    .link:hover .flip {
      transform: none;
    }

    .link:focus-visible .logo,
    .link:hover .logo {
      opacity: 0;
    }

    .link:focus-visible .caption,
    .link:hover .caption {
      opacity: 1;
    }
  }

  /* Touch */

  @media (hover: none) {
    .flip {
      gap: 16px;
    }

    .flip > * {
      grid-area: auto;
    }

    .caption {
      transform: none;
      font-size: 22px;
    }
  }

  /* Tags & Dates */

  .meta {
    position: relative;
    align-self: end;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    padding: clamp(24px, calc(48 / 1416 * 100cqi), 48px) clamp(24px, calc(64 / 1416 * 100cqi), 64px);
    pointer-events: none;
  }

  .meta p {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .divider {
    margin-inline: 0.5em;
  }

  .dates {
    color: var(--neutral-050);
    white-space: nowrap;
  }

  .link:focus-visible {
    outline: 2px solid var(--neutral-000);
    outline-offset: 4px;
    border-radius: 0 0 calc(48 / 1416 * 100cqi) calc(48 / 1416 * 100cqi);
  }

  /* Phones */

  @media (max-width: 700px) {
    .link {
      aspect-ratio: 4 / 5;
    }

    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }
  }
</style>
