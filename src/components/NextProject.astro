---
// Figma: Portfolio › v2 › "Next Project" (2428:6520, hover 2428:6549). The
// next project's tile art across the grid on the dark background, rising
// out of the dark above (a Neutral/1000 fade at the top), lower corners
// rounded 48. Its logo sits in the middle at the size the case study hero
// shows it, so it doesn't change size when the project opens. Tags bottom left, dates bottom right, as in the
// case study hero. On hover or focus the logo flips over (top edge away)
// to "Next project" on its back. Touch screens show the logo with the
// label beneath. The whole tile links.
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { title, tile, link, tags, dates } = project.data;
// The homepage tile's logo, at its homepage proportion
const logo: ImageMetadata = tile.logo;
// No case study yet: go to the project's tile on the homepage
const href = link ?? `/#work-${project.id}`;

---

<section class="next" aria-label="Next project" style={`--logo-aspect: ${(logo.width / logo.height).toFixed(4)}`}>
  <div class="next__inner container">
    <a class="next__tile" href={href} aria-label={`Next project: ${title}`} data-transition={`art-${project.id}`}>
      <TileArt
        class="next__art"
        image={tile.image}
        logo={tile.logo}
        logoScale={tile.logoScale}
        grain={tile.grain}
        gradient={tile.gradient}
        alt=""
        sizes="(max-width: 1512px) 94vw, 1416px"
        widths={[820, 1640, 2832]}
        showLogo={false}
      />
      <div class="next__content">
        <div class="next__flip">
          <img class="next__logo" src={logo.src} alt={title} width={logo.width} height={logo.height} loading="lazy" />
          <p class="next__label" aria-hidden="true">Next project</p>
        </div>
      </div>
      <div class="next__meta t-h3">
        <p class="next__tags t-h3-bold">
          {tags.map((tag, i) => (
            <>{i > 0 && <span class="next__sep" aria-hidden="true">|</span>}<span>{tag}</span></>
          ))}
        </p>
        <p class="next__dates">{dates}</p>
      </div>
    </a>
  </div>
</section>

<script>
  // The tile only morphs when you leave through it. Named on the page all
  // the time, it would also pair with the same project's tile or hero on
  // the page you came from, and fly down to the foot of this one on arrival
  // (a dark box crossing the screen, from the CRT's backing). So it takes
  // its name in pageswap, just before the old page is captured, and only
  // when the navigation goes where the tile points.
  addEventListener('pageswap', (event) => {
    const to = event.activation?.entry?.url;
    if (!event.viewTransition || !to) return;
    for (const tile of document.querySelectorAll<HTMLAnchorElement>('.next__tile[data-transition]')) {
      const art = tile.querySelector<HTMLElement>('.next__art');
      if (!art || tile.href !== to) continue;
      art.style.viewTransitionName = tile.dataset.transition!;
      art.style.setProperty('view-transition-class', 'art');
    }
  });
</script>

<style>
  .next {
    background-color: var(--bg-dark);
  }

  .next__inner {
    padding-top: var(--space-2xl);
  }

  /* 1416 × 508 at 1512; everything inside scales with the tile */
  .next__tile {
    container-type: inline-size;
    position: relative;
    display: grid;
    /* Width first, so the min-height makes it taller, not wider */
    width: 100%;
    aspect-ratio: 1416 / 508;
    min-height: 420px;
    overflow: clip;
    color: var(--text-on-dark);
  }

  .next__tile > :global(*) {
    grid-area: 1 / 1;
  }

  /* Lower corners only: the top fades into the dark, and a rounded top
     edge there shows a light fringe of the art through the fade */
  .next__tile :global(.next__art) {
    border-radius: 0 0 calc(48 / 1416 * 100cqi) calc(48 / 1416 * 100cqi);
  }

  /* Rises out of the dark above it */
  .next__tile :global(.next__art)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg-dark), oklch(from var(--bg-dark) l c h / 0));
    pointer-events: none;
  }

  .next__content {
    position: relative;
    display: grid;
    place-items: center;
    perspective: 900px;
  }

  /* Logo on the front, "Next project" on the back, in one cell */
  .next__flip {
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
  }

  .next__flip > * {
    grid-area: 1 / 1;
    backface-visibility: hidden;
  }

  /* The size it opens at: CaseHero's rule (the same area for every logo,
     Fertifa's at 432 wide at 1512), and never taller than 85% of this tile */
  .next__logo {
    width: calc(clamp(200px, calc(432 / 1512 * 100vw), 640px) * sqrt(var(--logo-aspect, 3.94) / 3.94));
    max-width: 80%;
    height: auto;
    max-height: min(calc(max(80svh, 440px) * 0.55), calc(508 / 1416 * 100cqi * 0.85));
    object-fit: contain;
  }

  .next__label {
    margin: 0;
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    font-size: clamp(32px, calc(88 / 1416 * 100cqi), 88px);
    line-height: 1;
    white-space: nowrap;
    transform: rotateX(180deg);
  }

  .next__tile:focus-visible .next__flip {
    transform: rotateX(180deg);
  }

  @media (hover: hover) {
    .next__tile:hover .next__flip {
      transform: rotateX(180deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .next__flip {
      transition: transform 760ms var(--ease-spring);
    }
  }

  /* Reduced motion: no turn, the back simply replaces the front */
  @media (prefers-reduced-motion: reduce) {
    .next__label {
      transform: none;
      opacity: 0;
    }

    .next__tile:focus-visible .next__flip,
    .next__tile:hover .next__flip {
      transform: none;
    }

    .next__tile:focus-visible .next__logo,
    .next__tile:hover .next__logo {
      opacity: 0;
    }

    .next__tile:focus-visible .next__label,
    .next__tile:hover .next__label {
      opacity: 1;
    }
  }

  /* Touch: the logo, with the label beneath it */
  @media (hover: none) {
    .next__flip {
      gap: 16px;
    }

    .next__flip > * {
      grid-area: auto;
    }

    .next__label {
      transform: none;
      font-size: 22px;
    }
  }

  /* Tags and dates along the bottom, as in the case study hero */
  .next__meta {
    position: relative;
    align-self: end;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-m);
    padding: clamp(24px, calc(48 / 1416 * 100cqi), 48px) clamp(24px, calc(64 / 1416 * 100cqi), 64px);
    pointer-events: none;
  }

  .next__meta p {
    margin: 0;
  }

  .next__tags {
    display: flex;
    flex-wrap: wrap;
  }

  .next__sep {
    margin-inline: 0.5em;
  }

  .next__dates {
    color: var(--neutral-050);
    white-space: nowrap;
  }

  .next__tile:focus-visible {
    outline: 2px solid var(--neutral-000);
    outline-offset: 4px;
    border-radius: 0 0 calc(48 / 1416 * 100cqi) calc(48 / 1416 * 100cqi);
  }

  /* Phones: a squarer tile */
  @media (max-width: 700px) {
    .next__tile {
      aspect-ratio: 4 / 5;
    }

    .next__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2xs);
    }
  }
</style>
