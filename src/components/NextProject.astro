---
// Figma: Portfolio › v2 › "Next Project" (2428:6520, hover 2428:6549). The
// next project's tile art across the grid on the dark background, rising
// out of the dark above (a Neutral/1000 fade at the top), corners rounded
// 48. Its stacked logo sits in the middle. "Next project" runs along the
// bottom in huge type, cut off by the edge, at 4% white; on hover or focus
// it comes up to half, a colour change only (labels don't move). The whole
// tile links.
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

interface Props {
  project: CollectionEntry<'work'>;
  // The stacked logo; the tile's own logo is the wide one
  logo: ImageMetadata;
}

const { project, logo } = Astro.props;
const { title, tile, link } = project.data;
// No case study yet: go to the project's tile on the homepage
const href = link ?? `/#work-${project.id}`;

// Logos carry the same visual weight whatever their shape: each covers the
// area of the Format stacked logo in the Figma tile (240 tall, 186 wide, at
// 1416), so a wide wordmark sits lower and longer instead of 240 tall
const LOGO_AREA = 240 * (240 * 217) / 280;
const logoHeight = Math.min(240, Math.sqrt(LOGO_AREA / (logo.width / logo.height)));
---

<section class="next" aria-label="Next project">
  <div class="next__inner container">
    <a class="next__tile" href={href} aria-label={`Next project: ${title}`} data-transition={`art-${project.id}`}>
      <TileArt
        class="next__art"
        image={tile.image}
        logo={tile.logo}
        logoScale={tile.logoScale}
        grain={tile.grain}
        gradient={tile.gradient}
        alt=""
        sizes="(max-width: 1512px) 94vw, 1416px"
        widths={[820, 1640, 2832]}
        showLogo={false}
      />
      <div class="next__content">
        <img class="next__logo" style={`--logo-h: ${logoHeight.toFixed(1)}`} src={logo.src} alt={title} width={logo.width} height={logo.height} loading="lazy" />
      </div>
      <p class="next__label" aria-hidden="true">Next project</p>
    </a>
  </div>
</section>

<script>
  // The tile only morphs when you leave through it. Named on the page all
  // the time, it would also pair with the same project's tile or hero on
  // the page you came from, and fly down to the foot of this one on arrival
  // (a dark box crossing the screen, from the CRT's backing). So it takes
  // its name in pageswap, just before the old page is captured, and only
  // when the navigation goes where the tile points.
  addEventListener('pageswap', (event) => {
    const to = event.activation?.entry?.url;
    if (!event.viewTransition || !to) return;
    for (const tile of document.querySelectorAll<HTMLAnchorElement>('.next__tile[data-transition]')) {
      const art = tile.querySelector<HTMLElement>('.next__art');
      if (!art || tile.href !== to) continue;
      art.style.viewTransitionName = tile.dataset.transition!;
      art.style.setProperty('view-transition-class', 'art');
    }
  });
</script>

<style>
  .next {
    background-color: var(--bg-dark);
  }

  .next__inner {
    padding-top: var(--space-2xl);
  }

  /* 1416 × 508 at 1512; everything inside scales with the tile */
  .next__tile {
    container-type: inline-size;
    position: relative;
    display: grid;
    /* Width first, so the min-height makes it taller, not wider */
    width: 100%;
    aspect-ratio: 1416 / 508;
    min-height: 420px;
    overflow: clip;
    /* Its own width isn't a container unit here, so 48 at 1416 by the page */
    border-radius: clamp(24px, calc(48 / 1512 * 100vw), 48px);
    color: var(--text-on-dark);
  }

  .next__tile > :global(*) {
    grid-area: 1 / 1;
  }

  .next__tile :global(.next__art) {
    border-radius: calc(48 / 1416 * 100cqi);
  }

  /* Rises out of the dark above it */
  .next__tile :global(.next__art)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--bg-dark), oklch(from var(--bg-dark) l c h / 0));
    pointer-events: none;
  }

  .next__content {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(24px, calc(64 / 1416 * 100cqi), 64px);
  }

  /* Scales with the tile, from half size up to its Figma size */
  .next__logo {
    width: auto;
    height: clamp(calc(var(--logo-h) * 0.5px), calc(var(--logo-h) / 1416 * 100cqi), calc(var(--logo-h) * 1px));
  }

  /* 200 at 1416, its top 120 above the bottom edge, the rest cut off */
  .next__label {
    position: relative;
    align-self: end;
    justify-self: center;
    margin: 0;
    overflow: hidden;
    height: calc(120 / 1416 * 100cqi);
    color: var(--text-on-dark);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
    font-weight: var(--weight-bold);
    font-size: max(64px, calc(200 / 1416 * 100cqi));
    line-height: 0.8;
    white-space: nowrap;
    opacity: 0.04;
    border-radius: 0 0 calc(48 / 1416 * 100cqi) calc(48 / 1416 * 100cqi);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .next__label {
      transition: opacity var(--duration-m) var(--ease-out);
    }
  }

  .next__tile:focus-visible .next__label {
    opacity: 0.5;
  }

  @media (hover: hover) {
    .next__tile:hover .next__label {
      opacity: 0.5;
    }
  }

  .next__tile:focus-visible {
    outline: 2px solid var(--neutral-000);
    outline-offset: 4px;
    border-radius: calc(48 / 1416 * 100cqi);
  }

  /* Phones: a squarer tile, the label still along the bottom */
  @media (max-width: 700px) {
    .next__tile {
      aspect-ratio: 4 / 5;
    }

    .next__label {
      height: 0.6em;
    }
  }
</style>
