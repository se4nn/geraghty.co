---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="case-intro" aria-labelledby="case-intro-title">
  <div class="inner container">
    <div class="lead">
      <h2 id="case-intro-title" class="title t-h1">{title}</h2>
      <div class="text t-h3"><slot name="lead" /></div>
    </div>
    <slot />
  </div>
</section>

<style>
  .case-intro {
    background-color: var(--bg-page);
  }

  .inner {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2xl);
    padding-block: calc(var(--space-2xl) + var(--space-xl));
  }

  .lead {
    align-self: center;
    width: min(100%, calc(3 * (100cqi - 4 * var(--grid-gap)) / 5 + 2 * var(--grid-gap)));
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    text-align: center;
  }

  .title {
    color: var(--text-display);
    text-wrap: balance;
  }

  .text {
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .lead {
      width: 100%;
    }
  }
</style>
