---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

{
  label ? (
    <div class="stats-group">
      <p class="heading t-label">{label}</p>
      <div class="stats"><slot /></div>
    </div>
  ) : (
    <div class="stats"><slot /></div>
  )
}

<style>
  .stats-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .heading {
    color: var(--text-muted);
    text-align: center;
  }

  .stats {
    display: flex;
    align-items: stretch;
    gap: calc(3 * var(--space-m));
  }

  .stats > :global(*) {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
  }

  .stats > :global(* + *)::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1.5 * var(--space-m) - 0.5px);
    width: 1px;
    background-color: var(--border-default);
  }

  /* Phones */

  @media (max-width: 700px) {
    .stats {
      flex-direction: column;
      gap: var(--space-2xl);
    }

    .stats > :global(* + *)::before {
      top: calc(-0.5 * var(--space-2xl));
      bottom: auto;
      left: calc(50% - 32px);
      width: 64px;
      height: 1px;
    }
  }
</style>
