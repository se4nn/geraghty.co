---
// Figma: "Bar". A bold run of labels split by bars on the left, lighter
// detail pushed to the right. Under every project tile, and along the foot
// of a case study hero, where a middle item (the role) sits centred.
interface Props {
  lead: string[];
  middle?: string;
  trail: { label: string; href?: string }[];
}

const { lead, middle, trail } = Astro.props;
---

<p class:list={['bar', 't-h3', { 'bar--three': middle }]}>
  <span class="bar__lead t-h3-bold">
    {lead.map((item, i) => (
      <>{i > 0 && <><span class="bar__sep" aria-hidden="true">|</span><wbr /></>}<span class="bar__item">{item}</span></>
    ))}
  </span>
  {middle && <span class="bar__middle">{middle}</span>}
  <span class="bar__trail">
    {
      trail.map((item, i) => {
        const external = item.href?.startsWith('http');
        return (
          <>
            {i > 0 && <span class="bar__sep" aria-hidden="true">|</span>}
            {item.href ? (
              <a
                class="bar__link"
                href={item.href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
              >
                {item.label}
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              item.label
            )}
          </>
        );
      })
    }
  </span>
</p>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-m);
  }

  .bar__lead {
    color: var(--text-strong);
  }

  /* Three equal columns: lead left, middle centred, trail right */
  .bar--three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: baseline;
  }

  .bar__middle {
    color: var(--text-muted);
    text-align: center;
  }

  .bar--three .bar__trail {
    text-align: right;
  }

  /* Phones: one per line, left aligned */
  @media (max-width: 700px) {
    .bar--three {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .bar--three :is(.bar__middle, .bar__trail) {
      text-align: left;
    }
  }

  /* Lines break at the bars, never inside a label */
  .bar__item {
    white-space: nowrap;
  }

  .bar__sep {
    margin-inline: 0.5em;
  }

  .bar__trail {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .bar__link {
    transition: color var(--duration-s) var(--ease-out);
  }

  @media (hover: hover) {
    .bar__link:hover {
      color: var(--text-strong);
    }
  }

  .bar__link:focus-visible {
    outline: 2px solid var(--neutral-900);
    outline-offset: 3px;
    border-radius: var(--radius-s);
  }
</style>
