---
interface Props {
  lead: string[];
  middle?: string;
  trail: string;
}

const { lead, middle, trail } = Astro.props;
---

<p class:list={['bar', 't-h3', { three: middle }]}>
  <span class="lead t-h3-bold">
    {lead.map((item, i) => (
      <>{i > 0 && <><span class="divider" aria-hidden="true">|</span><wbr /></>}<span class="item">{item}</span></>
    ))}
  </span>
  {middle && <span class="middle">{middle}</span>}
  <span class="trail">{trail}</span>
</p>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-m);
  }

  .lead {
    color: var(--text-strong);
  }

  /* Three Columns */

  .bar.three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: baseline;
  }

  .middle {
    color: var(--text-muted);
    text-align: center;
  }

  .bar.three .trail {
    text-align: right;
  }

  /* Phones */

  @media (max-width: 700px) {
    .bar.three {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .bar.three :is(.middle, .trail) {
      text-align: left;
    }
  }

  /* Lead & Trail */

  .item {
    white-space: nowrap;
  }

  .divider {
    margin-inline: 0.5em;
  }

  .trail {
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
