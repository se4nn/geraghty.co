---
interface Round {
  went: string;
  rule: string;
}

interface Props {
  title: string;
  meta: string;
  read: string;
  rounds: Round[];
  reused: string;
  footer: string;
}
const { title, meta, read, rounds, reused, footer } = Astro.props;
---

<div class="build-log">
  <div class="frame">
    <article class="card">
      <header class="head">
        <h3 class="title">{title}</h3>
        <p class="meta">{meta}</p>
      </header>

      <p class="line"><span class="key">Read first</span>{read}</p>

      <ol class="rounds">
        {rounds.map(({ went, rule }, i) => (
          <li class="round">
            <span class="number">{i + 1}</span>
            <span class="went">{went}</span>
            <span class="rule">{rule}</span>
          </li>
        ))}
      </ol>

      <p class="line"><span class="key">Reused</span>{reused}</p>
      <p class="foot">{footer}</p>
    </article>
  </div>
</div>

<style>
  .build-log {
    align-self: start;
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .frame {
    --u: calc(100cqw / 684);
    display: grid;
    align-items: center;
    aspect-ratio: 684 / 812;
    padding: calc(48 * var(--u));
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-variation-settings: var(--sans-axes);
  }

  /* Card */

  .card {
    display: grid;
    gap: calc(20 * var(--u));
    padding: calc(32 * var(--u));
    border: 0.5px solid var(--neutral-300);
    border-radius: calc(10 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 calc(9.8 * var(--u)) calc(9.8 * var(--u)) calc(-6.5 * var(--u)) oklch(from var(--neutral-900) l c h / 0.12),
      0 calc(1.6 * var(--u)) calc(1.6 * var(--u)) calc(-1.6 * var(--u)) oklch(from var(--neutral-900) l c h / 0.16);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(16 * var(--u));
  }

  .title {
    margin: 0;
    font-size: calc(28 * var(--u));
    line-height: calc(34 / 28);
    font-weight: var(--weight-bold);
  }

  .meta,
  .key,
  .number {
    color: var(--neutral-600);
    font-family: var(--font-mono);
    font-size: calc(14 * var(--u));
    line-height: calc(20 / 14);
  }

  .meta {
    margin: 0;
  }

  .line {
    display: grid;
    gap: calc(4 * var(--u));
    margin: 0;
    font-size: calc(17 * var(--u));
    line-height: calc(24 / 17);
  }

  /* Rounds */

  .rounds {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 0.5px solid var(--neutral-100);
  }

  .round {
    display: grid;
    grid-template-columns: calc(28 * var(--u)) 1fr;
    column-gap: calc(8 * var(--u));
    row-gap: calc(4 * var(--u));
    padding-block: calc(14 * var(--u));
    border-bottom: 0.5px solid var(--neutral-100);
  }

  .number {
    grid-row: span 2;
    font-feature-settings: 'tnum';
  }

  .went {
    font-size: calc(17 * var(--u));
    line-height: calc(24 / 17);
  }

  .rule {
    color: var(--delli-blue);
    font-size: calc(15 * var(--u));
    line-height: calc(22 / 15);
  }

  .rule::before {
    content: '→ ';
  }

  .foot {
    margin: 0;
    color: var(--neutral-600);
    font-size: calc(15 * var(--u));
    line-height: calc(22 / 15);
  }

  /* Phones */

  @container (max-width: 460px) {
    .frame {
      --u: calc(100cqw / 420);
      aspect-ratio: auto;
      padding: calc(24 * var(--u));
    }
  }
</style>
