---
// A skill chip's hover card: the project's tile artwork, rising out of the
// chip (MOTION.md: Fan). Rendered inside the chip link, which positions it.
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

// Filled in from the project's work entry by the page
export interface Preview {
  image: ImageMetadata;
  logo: ImageMetadata;
  // The tile's logoScale: logo width as a share of a square tile's side
  logoScale: number;
  grain: boolean;
  // Colour the card's shadow picks up, usually the project's gradient
  tint?: string;
  alt: string;
}

type Props = Preview;

const { image, logo, logoScale, grain, tint, alt } = Astro.props;

// The card is 400 × 280: the logo is sized against its short side, as a
// square tile's is against its side
const CARD_RATIO = 280 / 400;
---

<span class="preview" style={tint ? `--card-tint: ${tint};` : undefined} aria-hidden="true">
  <TileArt
    class="preview__art"
    image={image}
    logo={logo}
    logoScale={logoScale * CARD_RATIO}
    grain={grain}
    live={false}
    alt={alt}
    sizes="620px"
    widths={[620, 1240]}
  />
</span>

<style>
  .preview {
    /* So sweeping across the fan doesn't flash the card (INTENT in Skills) */
    --intent: 100ms;

    /* 400 × 280, 24px above the row, at 33px type */
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.7273em);
    z-index: 20;
    display: block;
    width: 12.1212em;
    height: 8.4848em;
    border-radius: var(--radius-s);
    --card-tint: var(--neutral-900);
    box-shadow:
      0 24px 24px -12px oklch(from var(--card-tint) l c h / 0.3),
      0 4px 4px -4px oklch(from var(--card-tint) l c h / 0.25);
    pointer-events: none;
    cursor: default;
    opacity: 0;
    visibility: hidden;
    /* Grows out of the chip below */
    transform-origin: 50% 100%;
    transform: translate(-50%, 0.25em) scale(0.94);
    transition:
      transform 160ms var(--ease-out),
      opacity 140ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  .preview :global(.preview__art) {
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) {
    :global(a.chip:hover) > .preview {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0) scale(1);
      transition:
        transform 560ms var(--ease-spring) var(--intent),
        opacity 200ms var(--ease-out) var(--intent),
        visibility 0s linear var(--intent);
    }
  }

  /* Or the hidden cards widen the page on phones (MOTION.md, Gotchas) */
  @media (hover: none) {
    .preview {
      display: none;
    }
  }

  /* Group warm-up (MOTION.md): Skills sets data-warm and data-swap. A hard
     cut, never a crossfade; only chips entered while warm cut, so the first
     card's rise and leaving the row still play */
  @media (hover: hover) {
    :global([data-warm]) .preview {
      --intent: 0ms;
      transform: translate(-50%, 0) scale(1);
    }

    :global([data-warm] a.chip[data-swap]:hover) > .preview,
    :global([data-warm]:has(a.chip[data-swap]:hover) a.chip:not(:hover)) > .preview {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    :global(a.chip:hover) > .preview {
      transform: translate(-50%, 0);
    }
  }
</style>
