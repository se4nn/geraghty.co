---
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

export interface Preview {
  image: ImageMetadata;
  logo: ImageMetadata;
  logoScale: number;
  grain: boolean;
  tint?: string;
  alt: string;
}

type Props = Preview;

const { image, logo, logoScale, grain, tint, alt } = Astro.props;

const CARD_RATIO = 280 / 400;
---

<span class="preview" style={tint ? `--card-tint: ${tint};` : undefined} aria-hidden="true">
  <TileArt
    class="art"
    image={image}
    logo={logo}
    logoScale={logoScale * CARD_RATIO}
    grain={grain}
    live={false}
    alt={alt}
    sizes="620px"
    widths={[620, 1240]}
  />
</span>

<style>
  .preview {
    --intent: 100ms;

    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.7273em);
    z-index: 20;
    display: block;
    width: 12.1212em;
    height: 8.4848em;
    border-radius: var(--radius-s);
    --card-tint: var(--neutral-900);
    box-shadow:
      0 24px 24px -12px oklch(from var(--card-tint) l c h / 0.3),
      0 4px 4px -4px oklch(from var(--card-tint) l c h / 0.25);
    pointer-events: none;
    cursor: default;
    opacity: 0;
    visibility: hidden;
    transform-origin: 50% 100%;
    transform: translate(-50%, 0.25em) scale(0.94);
    transition:
      transform 160ms var(--ease-out),
      opacity 140ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  .preview :global(.tile-art.art) {
    width: 100%;
    height: 100%;
  }

  /* Hover */

  @media (hover: hover) {
    :global(a.chip:hover) > .preview {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0) scale(1);
      transition:
        transform 560ms var(--ease-spring) var(--intent),
        opacity 200ms var(--ease-out) var(--intent),
        visibility 0s linear var(--intent);
    }
  }

  @media (hover: none) {
    .preview {
      display: none;
    }
  }

  /* Warm-up */

  @media (hover: hover) {
    :global([data-warm]) .preview {
      --intent: 0ms;
      transform: translate(-50%, 0) scale(1);
    }

    :global([data-warm] a.chip[data-swap]:hover) > .preview,
    :global([data-warm]:has(a.chip[data-swap]:hover) a.chip:not(:hover)) > .preview {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    :global(a.chip:hover) > .preview {
      transform: translate(-50%, 0);
    }
  }
</style>
