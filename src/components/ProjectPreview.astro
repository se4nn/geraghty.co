---
// Hover card for a skill chip. Figma: "Frame 1" on the v2 page.
// The project's thumbnail (same artwork as its work tile) rises above the
// chip while it's hovered. Rendered inside the chip link, which positions it.
import type { ImageMetadata } from 'astro';
import TileArt from './TileArt.astro';

// Filled in from the project's work entry by the page
export interface Preview {
  image: ImageMetadata;
  logo: ImageMetadata;
  // The tile's logoScale: logo width as a share of a square tile's side
  logoScale: number;
  grain: boolean;
  // Colour the card's shadow picks up, usually the project's gradient
  tint?: string;
  alt: string;
}

type Props = Preview;

const { image, logo, logoScale, grain, tint, alt } = Astro.props;

// Matched to the tiles: the card is 400 × 280, so the logo is sized against
// its short side, the same way a square tile's logo is sized against its side
const CARD_RATIO = 280 / 400;
---

<span class="preview" style={tint ? `--card-tint: ${tint};` : undefined} aria-hidden="true">
  <TileArt
    class="preview__art"
    image={image}
    logo={logo}
    logoScale={logoScale * CARD_RATIO}
    grain={grain}
    live={false}
    alt={alt}
    sizes="400px"
    widths={[400, 800]}
  />
</span>

<style>
  .preview {
    /* Short intent delay so sweeping across the fan doesn't flash the card */
    --intent: 100ms;

    /* 400 × 280, 24px above the row, at 33px type */
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.7273em);
    z-index: 20;
    display: block;
    width: 12.1212em;
    height: 8.4848em;
    border-radius: var(--radius-s);
    /* Figma's two-layer shadow, tinted with the project's colour */
    --card-tint: var(--neutral-900);
    box-shadow:
      0 24px 24px -12px oklch(from var(--card-tint) l c h / 0.3),
      0 4px 4px -4px oklch(from var(--card-tint) l c h / 0.25);
    pointer-events: none;
    cursor: default;
    opacity: 0;
    visibility: hidden;
    /* Grows out of the chip below it */
    transform-origin: 50% 100%;
    transform: translate(-50%, 0.25em) scale(0.94);
    /* Leaving: quick and quiet */
    transition:
      transform 160ms var(--ease-out),
      opacity 140ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  .preview :global(.preview__art) {
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) {
    /* Arriving: rises out of the chip on a soft spring */
    :global(a.chip:hover) > .preview {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0) scale(1);
      transition:
        transform 560ms var(--ease-spring) var(--intent),
        opacity 200ms var(--ease-out) var(--intent),
        visibility 0s linear var(--intent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview,
    :global(a.chip:hover) > .preview {
      transform: translate(-50%, 0);
    }
  }
</style>
