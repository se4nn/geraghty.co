---
// A brand's colour ramp as live swatches, lightest to darkest, the way its
// brand guide shows them: a name and the hex in each. Across the grid on
// desktop, three to a row on phones.
// on: 'dark' where the swatch is dark enough to need light text
interface Props {
  items: { name: string; hex: string; color: string; on?: 'light' | 'dark' }[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul class="swatches" role="list" aria-label={label}>
  {
    items.map((item) => (
      <li class:list={['swatch', { 'swatch--dark': item.on === 'dark' }]} style={`--swatch: ${item.color}`}>
        <span class="swatch__name t-body-bold">{item.name}</span>
        <span class="swatch__hex t-label">{item.hex}</span>
      </li>
    ))
  }
</ul>

<style>
  .swatches {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    aspect-ratio: 1416 / 560;
    overflow: clip;
    border-radius: var(--radius-s);
  }

  .swatch {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: var(--space-l);
    background-color: var(--swatch);
    color: var(--text-strong);
  }

  .swatch--dark {
    color: var(--text-on-dark);
  }

  .swatch__hex {
    text-transform: uppercase;
    opacity: 0.72;
  }

  @media (max-width: 700px) {
    .swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: row;
      aspect-ratio: auto;
    }

    .swatch {
      aspect-ratio: 1 / 1.2;
      padding: var(--space-m);
    }
  }
</style>
