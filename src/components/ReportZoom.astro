---
// Format's shared report: the view zooms in on its "Ask about this report in:
// Claude" button while a cursor clicks it, on a loop while it's on screen.
import { Image } from 'astro:assets';
import brief from '../assets/work/format/brief-header.png';

interface Props {
  alt: string;
  caption?: string;
}
const { alt, caption } = Astro.props;

// The button's centre in frame px, and where that lands in the window
const K = 1224 / 1512;
const BX = 1370;
const BY = 158;
const bx = +(96 + BX * K).toFixed(1);
const by = +(72 + BY * K).toFixed(1);
---

<figure class="rz" style={`--bx: ${bx}; --by: ${by};`}>
  <div class="rz__panel" role="img" aria-label={alt}>
    <div class="rz__window">
      <div class="rz__camera">
        <div class="rz__screen">
          <Image src={brief} alt="" widths={[1224, 1836, 2448, brief.width]} sizes="calc(1.1 * min(100vw - 32px, 1416px))" quality={90} loading="lazy" />
          <span class="rz__ring" aria-hidden="true"></span>
        </div>
      </div>

      <div class="rz__cursor" aria-hidden="true">
        <span class="rz__press"></span>
        <svg class="rz__arrow" viewBox="0 0 24 24">
          <path d="M5 2.5v17.2l4.6-4.4 2.9 6.5 2.7-1.2-2.9-6.4h6.3z" fill="#111" stroke="#fff" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
        <svg class="rz__hand" viewBox="0 0 24 24">
          <path d="M9 2.5c-.8 0-1.5.7-1.5 1.5v8.3l-1.3-1.3a1.55 1.55 0 0 0-2.2 0 1.5 1.5 0 0 0 0 2.1l4.6 5.2c.9 1 2.1 1.6 3.4 1.6h3c2.2 0 4-1.8 4-4v-4.6a1.5 1.5 0 0 0-3 0v-1a1.5 1.5 0 0 0-3 0v-.6a1.5 1.5 0 0 0-3-.2V4c0-.8-.7-1.5-1.5-1.5z" fill="#fff" stroke="#111" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </div>
  {caption && <figcaption class="rz__caption t-body">{caption}</figcaption>}
</figure>

<style>
  .rz {
    margin: 0;
  }

  .rz__panel {
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .rz__window {
    --u: calc(100cqw / 1416);
    position: relative;
    aspect-ratio: 1416 / 812;
    overflow: hidden;
  }

  /* Zooms around the button, so it stays where the cursor is heading */
  .rz__camera {
    position: absolute;
    inset: 0;
    transform-origin: calc(var(--bx) * var(--u)) calc(var(--by) * var(--u));
  }

  /* The whole page across, running off the bottom */
  .rz__screen {
    position: absolute;
    left: calc(96 * var(--u));
    top: calc(72 * var(--u));
    width: calc(1224 * var(--u));
    overflow: hidden;
    border-radius: calc(12 * var(--u)) calc(12 * var(--u)) 0 0;
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.06),
      0 calc(12 * var(--u)) calc(40 * var(--u)) oklch(0% 0 0 / 0.1);
  }

  .rz__screen img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* A ring around the button: the still state, and the click */
  .rz__ring {
    position: absolute;
    /* The button's box (1322,140 97×36 frame px) at 1224/1512, 6 out */
    left: calc(1064.2 * var(--u));
    top: calc(107.3 * var(--u));
    width: calc(90.5 * var(--u));
    height: calc(41.1 * var(--u));
    border-radius: calc(10 * var(--u));
    box-shadow:
      0 0 0 calc(2.5 * var(--u)) var(--format-red-400),
      0 0 0 calc(8 * var(--u)) oklch(from var(--format-red-400) l c h / 0.18);
    opacity: 0;
  }

  .rz[data-clicked] .rz__ring {
    opacity: 1;
  }

  /* Cursor */

  .rz__cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: none;
    transform: translate(calc(var(--cx, 760) * var(--u)), calc(var(--cy, 560) * var(--u)));
    filter: drop-shadow(0 calc(2 * var(--u)) calc(3 * var(--u)) oklch(0% 0 0 / 0.25));
  }

  .rz__cursor svg {
    position: absolute;
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
    max-width: none;
    transform-origin: top left;
  }

  .rz__arrow {
    left: calc(-6.2 * var(--u));
    top: calc(-3.1 * var(--u));
  }

  .rz__hand {
    left: calc(-11.25 * var(--u));
    top: calc(-3.1 * var(--u));
    visibility: hidden;
  }

  .rz[data-hand] .rz__arrow {
    visibility: hidden;
  }

  .rz[data-hand] .rz__hand {
    visibility: visible;
  }

  .rz__press {
    position: absolute;
    left: calc(-22 * var(--u));
    top: calc(-22 * var(--u));
    width: calc(44 * var(--u));
    height: calc(44 * var(--u));
    border-radius: 50%;
    background-color: oklch(from var(--format-red-400) l c h / 0.35);
    opacity: 0;
  }

  .rz__caption {
    margin: var(--space-l) 0 0;
    padding-left: calc(48 / 1416 * 100%);
    color: var(--neutral-600);
  }

  /* Still: show the ring so the eye finds the button */
  @media (prefers-reduced-motion: reduce) {
    .rz__ring {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rz[data-live] .rz__cursor {
      display: block;
      transition: transform var(--move, 1600ms) cubic-bezier(0.45, 0, 0.2, 1);
    }

    .rz__camera {
      transition: transform var(--zoom-ms, 1600ms) cubic-bezier(0.65, 0, 0.25, 1);
    }

    .rz[data-zoomed] .rz__camera {
      transform: scale(1.45);
    }

    .rz__ring {
      transition: opacity var(--duration-m) var(--ease-out);
    }

    .rz__cursor svg {
      transition: scale 120ms var(--ease-out);
    }

    .rz[data-pressing] .rz__cursor svg {
      scale: 0.86;
    }

    .rz[data-pressing] .rz__press {
      animation: rz-press 520ms var(--ease-out);
    }
  }

  @keyframes rz-press {
    0% {
      opacity: 1;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  for (const root of document.querySelectorAll<HTMLElement>('.rz')) {
    if (reducedMotion.matches) continue;
    const cursor = root.querySelector<HTMLElement>('.rz__cursor')!;
    const bx = Number(root.style.getPropertyValue('--bx'));
    const by = Number(root.style.getPropertyValue('--by'));
    const REST: [number, number] = [760, 560];
    let run = 0;

    const wait = (ms: number, id: number) =>
      new Promise<void>((resolve, reject) => setTimeout(() => (id === run ? resolve() : reject()), ms));

    const move = ([x, y]: [number, number], ms: number) => {
      cursor.style.setProperty('--move', `${ms}ms`);
      cursor.style.setProperty('--cx', String(x));
      cursor.style.setProperty('--cy', String(y));
    };

    const flag = (name: string, on: boolean) => root.toggleAttribute(name, on);

    const loop = async (id: number) => {
      while (id === run) {
        await wait(1600, id);

        root.style.setProperty('--zoom-ms', '1600ms');
        flag('data-zoomed', true);
        move([bx, by], 1600);
        await wait(1650, id);
        flag('data-hand', true);
        await wait(400, id);
        flag('data-pressing', true);
        await wait(240, id);
        flag('data-pressing', false);
        flag('data-clicked', true);
        await wait(1800, id);

        flag('data-clicked', false);
        flag('data-hand', false);
        root.style.setProperty('--zoom-ms', '1400ms');
        flag('data-zoomed', false);
        move(REST, 1400);
        await wait(1400, id);
      }
    };

    const start = () => {
      const id = ++run;
      flag('data-live', true);
      loop(id).catch(() => {});
    };

    const stop = () => {
      run++;
      ['data-zoomed', 'data-hand', 'data-pressing', 'data-clicked'].forEach((a) => root.removeAttribute(a));
      move(REST, 0);
    };

    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.4 }).observe(root);
  }
</script>
