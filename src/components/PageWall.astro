---
// A wall of product pages: two columns of screen cards on a panel, each
// card a whole page across (nothing cut at the sides) at about 43% of its
// design size, cropped only at the bottom. The columns slide past each
// other as the wall crosses the screen.
// Built at 1416 × 1416 Figma px and scaled as one piece (--u).
//
// screens: the image (a 1512-wide frame exported at 2x), its alt, and the
// card height in Figma px (how much of the page shows)
// Arrival: the first time the wall comes into view, the cards cascade in,
// row by row across both columns, each lifting on the spring and settling,
// like pages being laid out on a desk. Then the drift takes over.
// Reduced motion: no cascade, and the columns hold still.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Screen {
  src: ImageMetadata;
  alt: string;
  h: number;
}

interface Props {
  columns: [Screen[], Screen[]];
  // Where each column starts, in Figma px (negative runs off the top)
  offsets?: [number, number];
  label: string;
}

const { columns, offsets = [-120, -300], label } = Astro.props;
// Two 648 cards, 24 apart, 48 in from the panel's sides
const sizes = 'calc(0.4576 * min(100vw - 32px, 1416px))';
---

<div class="page-wall" role="group" aria-label={label}>
  <div class="page-wall__frame">
    {
      columns.map((column, c) => (
        <ul class="page-wall__column" role="list" style={`--top: ${offsets[c]}; --dir: ${c === 1 ? -1 : 1};`}>
          {column.map((screen, r) => (
            <li class="page-wall__card" style={`--h: ${screen.h}; --i: ${r * columns.length + c};`}>
              <Image src={screen.src} alt={screen.alt} widths={[648, 1296, 2268, screen.src.width]} sizes={sizes} quality={90} loading="lazy" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .page-wall {
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .page-wall__frame {
    --u: calc(100cqw / 1416);
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, calc(648 * var(--u)));
    gap: calc(24 * var(--u));
    justify-content: center;
    align-items: start;
    /* A fixed height, not aspect-ratio: the columns run past the bottom
       and would stretch it */
    height: calc(1416 * var(--u));
    overflow: hidden;
  }

  .page-wall__column {
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
    translate: 0 calc(var(--top) * var(--u));
  }

  .page-wall__card {
    position: relative;
    flex: none;
    height: calc(var(--h) * var(--u));
    overflow: hidden;
    border-radius: calc(8 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.06),
      0 calc(12 * var(--u)) calc(40 * var(--u)) oklch(0% 0 0 / 0.1);
  }

  .page-wall__card img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-wall__card {
      opacity: 0;
      transform: translateY(calc(96 * var(--u))) scale(0.96);
    }

    .page-wall[data-arrived] .page-wall__card {
      opacity: 1;
      transform: none;
      transition:
        opacity 480ms var(--ease-out) calc(var(--i) * 90ms),
        transform 900ms var(--ease-spring) calc(var(--i) * 90ms);
    }

    @supports (animation-timeline: view()) {
      .page-wall {
        view-timeline-name: --wall;
      }

      .page-wall__column {
        animation: page-wall-drift linear both;
        animation-timeline: --wall;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes page-wall-drift {
    from {
      translate: 0 calc((var(--top) + 80 * var(--dir)) * var(--u));
    }
    to {
      translate: 0 calc((var(--top) - 80 * var(--dir)) * var(--u));
    }
  }
</style>

<script>
  // Cascade in once, when a fifth of the wall is on screen
  for (const wall of document.querySelectorAll<HTMLElement>('.page-wall')) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        wall.toggleAttribute('data-arrived', true);
        io.disconnect();
      },
      { threshold: 0.2 },
    );
    io.observe(wall);
  }
</script>
