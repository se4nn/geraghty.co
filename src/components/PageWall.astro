---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Screen {
  src: ImageMetadata;
  alt: string;
  h: number;
}

interface Props {
  columns: [Screen[], Screen[]];
  offsets?: [number, number];
  label: string;
}

const { columns, offsets = [-120, -300], label } = Astro.props;
const sizes = 'calc(0.4576 * min(100vw - 32px, 1416px))';
---

<div class="page-wall" role="group" aria-label={label}>
  <div class="frame">
    {
      columns.map((column, c) => (
        <ul class="pages" role="list" style={`--top: ${offsets[c]}; --dir: ${c === 1 ? -1 : 1};`}>
          {column.map((screen, r) => (
            <li class="card" style={`--h: ${screen.h}; --i: ${r * columns.length + c};`}>
              <Image src={screen.src} alt={screen.alt} widths={[648, 1296, 2268, screen.src.width]} sizes={sizes} quality={90} loading="lazy" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .page-wall {
    container-type: inline-size;
    border-radius: var(--radius-s);
    overflow: hidden;
    background-color: var(--neutral-050);
  }

  .frame {
    --u: calc(100cqw / 1416);
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, calc(648 * var(--u)));
    gap: calc(24 * var(--u));
    justify-content: center;
    align-items: start;
    height: calc(1416 * var(--u));
    overflow: hidden;
  }

  .pages {
    display: flex;
    flex-direction: column;
    gap: calc(24 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
    translate: 0 calc((var(--top) + var(--p, 0) * 64 * var(--dir)) * var(--u));
  }

  .card {
    position: relative;
    flex: none;
    height: calc(var(--h) * var(--u));
    overflow: hidden;
    border-radius: calc(8 * var(--u));
    background-color: var(--neutral-000);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.06),
      0 calc(12 * var(--u)) calc(40 * var(--u)) oklch(0% 0 0 / 0.1);
  }

  .card img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      opacity: 0;
      transform: translateY(calc(64 * var(--u))) scale(0.97);
    }

    .page-wall[data-arrived] .card {
      opacity: 1;
      transform: none;
      transition:
        opacity 400ms var(--ease-out) calc(var(--i) * 60ms),
        transform 720ms var(--ease-spring) calc(var(--i) * 60ms);
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/arrival';

  const still = reducedMotion.matches;

  for (const wall of document.querySelectorAll<HTMLElement>('.page-wall')) {
    if (!still) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const r = wall.getBoundingClientRect();
        const p = (r.top + r.height / 2 - innerHeight / 2) / ((innerHeight + r.height) / 2);
        wall.style.setProperty('--p', Math.max(-1, Math.min(1, p)).toFixed(3));
      };
      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) addEventListener('scroll', onScroll, { passive: true });
        else removeEventListener('scroll', onScroll);
      }).observe(wall);
      update();
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        wall.toggleAttribute('data-arrived', true);
        io.disconnect();
      },
      { threshold: 0.2 },
    );
    io.observe(wall);
  }
</script>
