---
import type { CollectionEntry } from 'astro:content';
import ProjectTile, { type TileShape } from './ProjectTile.astro';

interface Props {
  projects: CollectionEntry<'work'>[];
}

const { projects } = Astro.props;

type Slot = { col: string; row: number; rowSpan: number; shape: TileShape; align: 'center' | 'end' };

const PATTERN: Slot[] = [
  { col: '1 / span 3', row: 1, rowSpan: 4, shape: 'square', align: 'center' },
  { col: '4 / span 2', row: 3, rowSpan: 4, shape: 'tall', align: 'center' },
  { col: '1 / span 2', row: 5, rowSpan: 3, shape: 'square', align: 'end' },
  { col: '4 / span 2', row: 7, rowSpan: 3, shape: 'square', align: 'center' },
  { col: '1 / span 3', row: 9, rowSpan: 4, shape: 'square', align: 'center' },
  { col: '4 / span 2', row: 12, rowSpan: 3, shape: 'square', align: 'center' },
];
const PATTERN_ROWS = 14;

const placed = projects.map((project, i) => {
  const slot = PATTERN[i % PATTERN.length];
  const row = slot.row + Math.floor(i / PATTERN.length) * PATTERN_ROWS;
  return { project, slot, style: `--place-col: ${slot.col}; --place-row: ${row} / span ${slot.rowSpan};` };
});
---

<div class="work-grid-wrap">
  <ul class="work-grid" role="list">
    {
      placed.map(({ project, slot, style }) => (
        <li class:list={['item', slot.align]} style={style}>
          <ProjectTile project={project} shape={slot.shape} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  @property --col {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  .work-grid-wrap {
    container-type: inline-size;
  }

  .work-grid {
    --col: calc((100cqi - (var(--grid-cols) - 1) * var(--grid-gap)) / var(--grid-cols));
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    grid-auto-rows: var(--col);
    gap: var(--grid-gap);
    list-style: none;
  }

  .item {
    grid-column: var(--place-col);
    grid-row: var(--place-row);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .item.end {
    justify-content: flex-end;
  }

  @media (max-width: 700px) {
    .work-grid {
      --col: 100cqi;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      gap: calc(0.75 * var(--space-3xl));
    }

    .item {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
</style>
