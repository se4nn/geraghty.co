---
// Link styled as a button. Figma: "Button"
// neon: the testimonial's View. light: white outline over artwork (Projects).
// glass: no outline, over artwork (a case study's links).
interface Props {
  href: string;
  variant?: 'neon' | 'light' | 'glass';
  label?: string;
}

const { href, variant = 'neon', label } = Astro.props;
const external = href.startsWith('http');
---

<a
  class:list={['button', `button--${variant}`, 't-h3']}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  aria-label={label}><slot /></a
>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-m);
    border-radius: var(--radius-l);
    background-color: oklch(from var(--neutral-1000) l c h / 0.16);
    white-space: nowrap;
    transition:
      background-color var(--duration-s) var(--ease-out),
      color var(--duration-s) var(--ease-out),
      scale 620ms var(--ease-bounce);
  }

  /* Press: the same dip and bounce back as the availability pill */
  @media (prefers-reduced-motion: no-preference) {
    .button:active {
      scale: 0.94;
      transition:
        background-color var(--duration-s) var(--ease-out),
        color var(--duration-s) var(--ease-out),
        scale 90ms var(--ease-out);
    }
  }

  .button--neon {
    border: var(--border-width-strong) solid var(--brand-neon);
    color: var(--brand-neon);
  }

  .button--neon:focus-visible {
    outline: 2px solid var(--brand-neon);
    outline-offset: 3px;
    background-color: var(--brand-neon);
    color: var(--neutral-1000);
  }

  /* Over artwork: white type on the dark tint. Figma strokes sit inside the
     box, so the padding gives way to them */
  .button--light,
  .button--glass {
    padding: calc(var(--space-xs) - var(--border-width-strong)) calc(var(--space-m) - var(--border-width-strong));
    border: var(--border-width-strong) solid var(--text-on-dark);
    color: var(--text-on-dark);
  }

  .button--glass {
    border-color: transparent;
  }

  .button--light:focus-visible,
  .button--glass:focus-visible {
    outline: 2px solid var(--neutral-000);
    outline-offset: 3px;
  }

  /* Hover only where there's a pointer, so a tap doesn't leave it filled */
  @media (hover: hover) {
    .button--neon:hover {
      background-color: var(--brand-neon);
      color: var(--neutral-1000);
    }

    .button--light:hover,
    .button--glass:hover {
      background-color: var(--neutral-000);
      color: var(--neutral-1000);
    }
  }
</style>
