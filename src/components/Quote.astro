---
// A quote from someone who was there, inside a case study. The footer's
// Testimonial is the dark, display-size version for the site's one line;
// this is its light, reading-size sibling for a longer passage, set in the
// serif like every other quote on the site and centred on the middle three
// grid columns, as the footer's is. No Figma frame yet (8 Oct 2026).
//
//   <Quote quote="…" name="Martin Dreymann" role="Co-founder & CTO"
//          company="Format" photo={martin} />
//
// Quote text is the person's own words, cut but never reworded.
import type { ImageMetadata } from 'astro';

interface Props {
  quote: string;
  name: string;
  role: string;
  company: string;
  photo?: ImageMetadata;
}

const { quote, name, role, company, photo } = Astro.props;
---

<figure class="quote">
  <blockquote class="quote__text">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="quote__who">
    {photo && <img class="quote__photo" src={photo.src} alt="" width="48" height="48" loading="lazy" />}
    <p class="t-label">
      <strong class="quote__name">{name}</strong><span class="quote__sep" aria-hidden="true">|</span>{role}, {company}
    </p>
  </figcaption>
</figure>

<style>
  .quote {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .quote__text,
  .quote__who {
    width: calc(3 * (100cqi - 4 * var(--grid-gap)) / 5 + 2 * var(--grid-gap));
  }

  /* The serif at the h3 size; the opening mark hangs so the block reads
     centred, as in the footer */
  .quote__text {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--h3-size);
    line-height: var(--h3-lh);
    letter-spacing: var(--h3-emphasis-track);
    color: var(--text-display);
    text-align: center;
    text-indent: -0.45em;
    text-wrap: pretty;
  }

  .quote__who {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    color: var(--text-muted);
  }

  .quote__photo {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-l);
    object-fit: cover;
  }

  .quote__name {
    font-weight: var(--weight-bold);
    color: var(--text-display);
  }

  .quote__sep {
    margin-inline: 0.5em;
  }

  @media (max-width: 700px) {
    .quote__text,
    .quote__who {
      width: 100%;
    }
  }
</style>
