---
// A longer quote inside a case study: the light, reading-size sibling of the
// footer's Testimonial. The person's own words, cut but never reworded.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  quote: string;
  name: string;
  role: string;
  company: string;
  photo?: ImageMetadata;
}

const { quote, name, role, company, photo } = Astro.props;
---

<figure class="quote">
  <blockquote class="quote__text">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="quote__who">
    {photo && <Image class="quote__photo" src={photo} alt="" width={48} height={48} densities={[2, 3]} quality={90} loading="lazy" />}
    <p class="t-label">
      <strong class="quote__name">{name}</strong><span class="quote__sep" aria-hidden="true">|</span>{role}, {company}
    </p>
  </figcaption>
</figure>

<style>
  .quote {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  /* Middle three of the five grid columns, as the footer's */
  .quote__text,
  .quote__who {
    width: calc(3 * (100cqi - 4 * var(--grid-gap)) / 5 + 2 * var(--grid-gap));
  }

  /* The opening mark hangs, so the block reads centred */
  .quote__text {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--h3-size);
    line-height: var(--h3-lh);
    letter-spacing: var(--h3-emphasis-track);
    color: var(--text-display);
    text-align: center;
    text-indent: -0.45em;
    text-wrap: pretty;
  }

  .quote__who {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    color: var(--text-muted);
  }

  .quote__photo {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-l);
    object-fit: cover;
  }

  .quote__name {
    font-weight: var(--weight-bold);
    color: var(--text-display);
  }

  .quote__sep {
    margin-inline: 0.5em;
  }

  @media (max-width: 700px) {
    .quote__text,
    .quote__who {
      width: 100%;
    }
  }
</style>
