---
interface Props {
  items: { title: string; lines: string[] }[];
  label: string;
}

const { items, label } = Astro.props;
---

<ol class="pillars" role="list" aria-label={label}>
  {
    items.map((item, i) => (
      <li class="pillar">
        <span class="number t-label">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="title t-h1">{item.title}</h3>
        <ul class="lines t-body" role="list">
          {item.lines.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .pillars {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-xl);
    border-radius: var(--radius-s);
    background-color: var(--neutral-000);
  }

  .number {
    color: var(--text-label);
  }

  .title {
    min-height: 2lh;
    color: var(--text-display);
    text-wrap: balance;
  }

  .lines {
    list-style: none;
    padding: 0;
    color: var(--text-muted);
  }

  .lines li {
    padding-block: var(--space-s);
    border-top: var(--border-width) solid var(--border-subtle);
    text-wrap: pretty;
  }

  .lines li:last-child {
    padding-bottom: 0;
  }

  @media (max-width: 1100px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }

    .title {
      min-height: 0;
    }
  }
</style>
