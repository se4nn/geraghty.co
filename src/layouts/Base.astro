---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og/home.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      if (location.hash) {
        const root = document.documentElement;
        root.style.scrollBehavior = 'auto';
        addEventListener('load', () => requestAnimationFrame(() => root.style.removeProperty('scroll-behavior')), { once: true });
      }
    </script>
    <script is:inline>
      addEventListener('pagereveal', (event) => {
        const transition = event.viewTransition;
        if (!transition) return;
        const to = location.pathname;
        const fromUrl = window.navigation?.activation?.from?.url || document.referrer;
        const from = fromUrl && new URL(fromUrl).origin === location.origin ? new URL(fromUrl).pathname : undefined;
        const next = to.startsWith('/work/') && from?.startsWith('/work/') && to !== from;
        if (next) {
          transition.types.add('open');
          transition.types.add('next');
        } else if (to.startsWith('/work/') && !from?.startsWith('/work/')) transition.types.add('open');
        else if (from?.startsWith('/work/')) transition.types.add('close');
      });
    </script>
    <link rel="icon" href="/img/favicon.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />

  </body>
</html>
